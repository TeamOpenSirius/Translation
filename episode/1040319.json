      "EpisodeMasterId": 1040319,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "戏剧类网络撰稿人A",
      "FontSize": 2,
      "Phrase": "虽然少了以本巢叶羽为中心的《爱丽丝》那种强大稳定感，/n但阿岐留卡米拉的帕克，就是一只无法预测的Jack-in-the-box。",
      "VoiceFileName": "10403190170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040319022,
      "EpisodeMasterId": 1040319,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "戏剧类网络撰稿人B",
      "FontSize": 2,
      "Phrase": "直接向观众搭话这种行动，很容易造成“不公平”的感觉，/n可她照顾到了所有区域，反而制造出满足感……这能写篇好稿！",
      "VoiceFileName": "10403190180",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
