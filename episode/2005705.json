      "EpisodeMasterId": 2005705,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "明明已经不再是孤身一人，我却还是把自己关在心里。/n……要是被双叶看到，肯定会狠狠训我一顿吧。",
      "VoiceFileName": "20057050200",
