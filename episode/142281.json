            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "卡米拉的朋友B",
            "FontSize": 2,
            "Phrase": "那你直接在直播里问不就好了？/n不是说三个臭皮匠什么的吗。",
            "VoiceFileName": "1422810100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
