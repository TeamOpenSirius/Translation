            "EpisodeMasterId": 141392,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "什么都没有。她的战斗毫无意义，/n只是被自己的不成熟彻底击垮。",
            "VoiceFileName": "1413920210",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
