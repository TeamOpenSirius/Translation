            "EpisodeMasterId": 141392,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "世人看来，是因为千寿历和莉莉亚的精彩表现才有这个结果。/n两个人对摆在眼前的难题，交出了120分的答案，才成就了现在。",
            "VoiceFileName": "1413920260",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
