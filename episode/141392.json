                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
            "Id": 141392024,
            "EpisodeMasterId": 141392,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "现在回头看，大概一切都太不成熟了。/n明明应该还有别的办法，却始终执着于自己认定的正确答案……。",
