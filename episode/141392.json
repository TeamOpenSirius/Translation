            "EpisodeMasterId": 141392,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "说起来，我还没告诉你《麦克白》的观后感。/n虽然很不甘心，但确实是“不愧银河座”的倾力之作。",
            "VoiceFileName": "1413920250",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "103"
        },
        {
