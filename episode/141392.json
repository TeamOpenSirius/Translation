            "EpisodeMasterId": 141392,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "我觉得也不算完全没有意义吧？/n你说的那个“某人”做过的事。",
