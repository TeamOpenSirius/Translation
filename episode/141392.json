            "EpisodeMasterId": 141392,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "都说了只是打发高峰期过去之前的时间。/n而且刚才是谁还兴冲冲地说想彼此更加了解的？",
            "VoiceFileName": "1413920100",
