      "EpisodeMasterId": 2006001,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "所以，我想看能让人忘掉炎热、/n充满夏日气息的美丽东西。",
      "WindowEffect": 2,
      "VoiceFileName": "20060010050",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
