      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "唉……。《恶魔的朋友》也快到千秋乐了啊。/n我的出道计划，感觉都已经是很久以前的事了。",
      "VoiceFileName": "20044060140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 6,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
