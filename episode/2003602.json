      "EpisodeMasterId": 2003602,
      "Order": 2,
      "GroupOrder": 37,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……非常抱歉。",
      "VoiceFileName": "20036020351",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "HeadDirectionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
