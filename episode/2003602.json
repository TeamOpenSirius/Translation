    },
    {
      "Id": 2003602034,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "千寿历。前些日子的《白蛇传》，辛苦了。/n听说上座情况与历代演出相比也毫不逊色。",
      "BgmFileName": "999",
      "VoiceFileName": "20036020280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003602035,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "谢谢。/n包括追加公演在内，全日满座，顺利迎来了千秋乐。",
      "VoiceFileName": "20036020290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2003602036,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "不过，你明白吧。",
      "VoiceFileName": "20036020300",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003602037,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……是。",
      "VoiceFileName": "20036020310",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2003602038,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "你的母亲在比你更年轻的时候，就演过《白蛇传》。/n并以演员之名广为人知。",
      "BgmFileName": "5",
      "VoiceFileName": "20036020320",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003602039,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "千寿家的未来、银河座的未来，都寄托在你身上。/n我要的，不只是填满观众席。",
      "VoiceFileName": "20036020330",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003602040,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "你的一举一动都与千寿之名相连，要有这个自觉。/n成为无愧于千寿之名的演员，是你的使命。",
      "VoiceFileName": "20036020340",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003602041,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "是。",
      "VoiceFileName": "20036020350",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
