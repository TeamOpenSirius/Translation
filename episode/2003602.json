      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "呃，名字我记得是——",
      "VoiceFileName": "20036020270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 7,
