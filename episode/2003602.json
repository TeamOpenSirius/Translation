      "SpeakerIconId": "301"
    },
    {
      "Id": 2003602043,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "银河座并非无数星辰中的普通一颗。/n它不是儿戏，也不是消遣，而是高悬天顶、独一无二的北辰。",
      "VoiceFileName": "20036020360",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003602044,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "它的光辉塑造了至今的戏剧界，/n也将引领今后的戏剧界。",
      "VoiceFileName": "20036020370",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003602045,
      "EpisodeMasterId": 2003602,
      "Order": 1,
      "GroupOrder": 40,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……是。/n创造那份光辉，正是我……正是千寿之人的职责。我谨记于心。",
      "VoiceFileName": "20036020380",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
