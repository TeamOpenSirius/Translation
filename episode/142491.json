            "EpisodeMasterId": 142491,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（换成其他剧团，大概会坦率接受给出的课题，/n　遵从她们的指示，原样演出来吧）",
            "VoiceFileName": "1424910100",
            "CharacterMotions": [
