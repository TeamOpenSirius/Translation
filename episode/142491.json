            "EpisodeMasterId": 142491,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（并非只依赖Sense……而是剧本、美术、演出等/n　所有要素齐备，才能造出滋润现代渴求的真正舞台）",
