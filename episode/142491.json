            "EpisodeMasterId": 142491,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（可我的Eden没有兴趣享用那么无聊的东西。/n　我也不希望靠那种东西去换取世界的评价）",
            "VoiceFileName": "1424910110",
            "CharacterMotions": [
