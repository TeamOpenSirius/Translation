            "EpisodeMasterId": 142491,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（我们只不过是把世界戏剧联盟这个场所，/n　选作向戏剧界展示“真正舞台”的地方）",
            "VoiceFileName": "1424910120",
            "CharacterMotions": [
