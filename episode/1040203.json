          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040203004,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "电视",
      "FontSize": 2,
      "Phrase": "……为了未来坐上“宙斯之座”，/n奥林匹斯的孩子们正向顶峰进发。",
      "VoiceFileName": "10402030030",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040203005,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "……嗯？",
      "VoiceFileName": "10402030040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040203006,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "电视",
      "FontSize": 2,
      "Phrase": "其中，如今最耀眼夺目的童星就是――",
      "VoiceFileName": "10402030050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040203007,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "电视",
      "FontSize": 2,
      "Phrase": "奥林匹斯的狛江地步。",
      "VoiceFileName": "10402030060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040203008,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "狛江地步",
      "FontSize": 2,
      "Phrase": "哈啊、哈啊、哈啊……。",
      "VoiceFileName": "10402030070",
      "CharacterMotions": [],
      "SpeakerIconId": "511"
    },
    {
      "Id": 1040203009,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "狛江，我感受不到Intelligence。/n不能拿疲劳当借口。",
      "VoiceFileName": "10402030080",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040203010,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "狛江地步",
      "FontSize": 2,
      "Phrase": "是！　请再来一次！",
      "VoiceFileName": "10402030090",
      "CharacterMotions": [],
      "SpeakerIconId": "511"
    },
    {
      "Id": 1040203011,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "……哦。/n挺努力的嘛——。",
      "VoiceFileName": "10402030100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040203012,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "那个不起眼的小丫头啊。还真变得热血了不少。/n嘛——，不做到这种程度，地步也拿不到角色吧。",
      "VoiceFileName": "10402030110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040203013,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "电视",
      "FontSize": 2,
      "Phrase": "她虽然还是小学生，却已在最新作品中被选为配角。/n明年计划公演的《爱丽丝梦游仙境》中，她也被视作主演头号候选。",
      "VoiceFileName": "10402030120",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040203014,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "哦……。",
      "VoiceFileName": "10402030130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
