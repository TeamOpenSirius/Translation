    },
    {
      "Id": 1040203003,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "嘿嘿嘿。糟糕——，这次更新简直神了！/n趁被削弱之前，不狠狠干一波积分怎么行！",
      "VoiceFileName": "10402030020",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
