      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "狛江地步",
      "FontSize": 2,
      "Phrase": "为了那些把我的名字列为未来Dai Star候选的人们，/n下一次我也一定会被选上。",
      "VoiceFileName": "10402030160",
      "CharacterMotions": [],
      "SpeakerIconId": "511"
    },
    {
      "Id": 1040203019,
      "EpisodeMasterId": 1040203,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "电视",
      "FontSize": 2,
      "Phrase": "虽然遗憾未能入选Dai Star，/n但她向前迈进的意志丝毫没有停滞，反而让人感受到更强的力量。",
      "VoiceFileName": "10402030170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
