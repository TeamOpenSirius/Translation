      "EpisodeMasterId": 1050110,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "（毕竟是Dai Star们的剧目，确实有不少令人惊叹之处。/n　正因如此，我们更不能输）",
      "VoiceFileName": "10501100040",
      "CharacterMotions": [
