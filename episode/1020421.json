            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 1,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「……现在站在我面前的您，/n　实在让我无法和众人口中传闻的蓝发伯爵联系在一起。」",
            "BackgroundImageFileName": "150",
            "BackgroundCharacterImageFileName": "142450_0",
            "BgmFileName": "32",
            "VoiceFileName": "10204210010",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421002,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「我不问你听过什么。/n　今夜，请别看那些传闻，只看真正的我。」",
            "BackgroundCharacterImageFileName": "142450_0",
            "VoiceFileName": "10204210020",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421003,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「只要是为了你，这样的宴会我每晚都可以准备。」",
            "BackgroundCharacterImageFileName": "142450_0",
            "VoiceFileName": "10204210030",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421004,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「每晚……/n　您竟然如此看重我……？」",
            "BackgroundCharacterImageFileName": "142450_0",
            "VoiceFileName": "10204210040",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421005,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「我发誓，将我的一切都献给你。/n　再问你一次，你愿意成为我的妻子吗，埃雷米娅？」",
            "BackgroundCharacterImageFileName": "142450_0",
            "VoiceFileName": "10204210050",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421006,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「……我愿意，蓝发伯爵。」",
            "BackgroundCharacterImageFileName": "142450_0",
            "VoiceFileName": "10204210060",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421007,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 7,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "163",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
