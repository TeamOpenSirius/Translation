            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1020421008,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "合作方经营者",
            "FontSize": 2,
            "Phrase": "哦……看到了吗，笔岛先生。/n令爱的表演。",
            "VoiceFileName": "10204210070",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020421009,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "时雨的父亲",
            "FontSize": 2,
            "Phrase": "诶？啊，是……",
            "VoiceFileName": "10204210080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020421010,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "合作方经营者",
            "FontSize": 2,
            "Phrase": "刚才还透着警戒的埃雷米娅，/n那表情就像中了魔法一样，被蓝发吸引着一点点改变……！",
            "VoiceFileName": "10204210090",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020421011,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "时雨的父亲",
            "FontSize": 2,
            "Phrase": "（……过去的我，什么都不知道……）",
            "VoiceFileName": "10204210100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020421012,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "时雨的父亲",
            "FontSize": 2,
            "Phrase": "（原来站在舞台上的你，/n会露出这么丰富的表情啊……时雨。）",
            "VoiceFileName": "10204210110",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020421013,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 13,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "150",
            "BackgroundImageFileFadeType": 1,
            "BgmFileName": "22",
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1020421014,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「掉下去……！/n　求求你……钥匙上的污渍，快消失……！」",
            "VoiceFileName": "10204210120",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421015,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「不是血……钥匙上的这个，只是污渍……！/n　只是污渍……明明只是……」",
            "VoiceFileName": "10204210130",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421016,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「为什么……为什么擦不掉……！」",
            "VoiceFileName": "10204210140",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421017,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "大黑",
            "FontSize": 2,
            "Phrase": "「……当然不可能消失。」",
            "VoiceFileName": "10204210150",
            "CharacterMotions": [],
            "SpeakerIconId": "202"
        },
        {
            "Id": 1020421018,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「谁、谁……！？你在哪里……！？」",
            "VoiceFileName": "10204210160",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421019,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "「我们……曾经就是你……/n　那暗红色的污痕，是『看见了真相之人』的印记……」",
            "VoiceFileName": "10204210170",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1020421020,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「不、不对……！/n　我什么都没看见……！」",
            "VoiceFileName": "10204210180",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421021,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "大黑",
            "FontSize": 2,
            "Phrase": "「当时我们……也曾这么说……/n　可是……」",
            "VoiceFileName": "10204210190",
            "CharacterMotions": [],
            "SpeakerIconId": "202"
        },
        {
            "Id": 1020421022,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "「我们明明相信……自己是被爱着的……/n　可是最后……」",
            "VoiceFileName": "10204210200",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1020421023,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "大黑",
            "FontSize": 2,
            "Phrase": "「……那把钥匙，把你引向了那间房。」",
            "VoiceFileName": "10204210210",
            "CharacterMotions": [],
            "SpeakerIconId": "202"
        },
        {
            "Id": 1020421024,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "「然后，也会把他引来……」",
            "VoiceFileName": "10204210220",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1020421025,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「啊……蓝发伯爵回来了……/n　神啊，求求您……救救我……」",
            "VoiceFileName": "10204210230",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421026,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「埃雷米娅……你在做什么？」",
            "VoiceFileName": "10204210240",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421027,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「呀——」",
            "VoiceFileName": "10204210250",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421028,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 28,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "1050",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1020421029,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「……」",
            "VoiceFileName": "10204210260",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421030,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 30,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "150",
            "BackgroundCharacterImageFileName": "142460_0",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1020421031,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「求、求您了，伯爵……！/n　请原谅我……！」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210270",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421032,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「原谅？你要我原谅什么？/n　你应该根本没做任何值得责罚的事吧？」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210280",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421033,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 33,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「……可、可是……我用了那间房的钥匙……」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210290",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421034,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 34,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「是啊，你看见了吧？/n　真正有罪的人是我，不是你。」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210300",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421035,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 35,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「但我们是发誓相爱的伴侣。/n　罪，也由我们共同背负吧。」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210310",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421036,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 36,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "「住手！/n　立刻放开我妹妹，蓝发！」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210320",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020421037,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 37,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「哥哥……！」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210330",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421038,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 38,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「收起你的剑，无趣的龙骑兵。/n　不许插足相爱的两人之间。」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210340",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421039,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 39,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "「胡说八道……！/n　你对我妹妹抱有的那种东西，根本不能称作爱！」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210350",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020421040,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 40,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「那毫无疑问就是爱。现在我就证明给你看。/n　来吧，我的第七任妻子。献上一吻——」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210360",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421041,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 41,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「！？」",
            "BackgroundCharacterImageFileName": "142460_0",
            "VoiceFileName": "10204210370",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421042,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 42,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「没有人能将相爱之人拆散……」",
            "BackgroundImageFileName": "1590",
            "VoiceFileName": "10204210380",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421043,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 43,
            "SpeakerName": "大黑",
            "FontSize": 2,
            "Phrase": "「……我听到了。你刚才说的话……」",
            "VoiceFileName": "10204210390",
            "CharacterMotions": [],
            "SpeakerIconId": "202"
        },
        {
            "Id": 1020421044,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 44,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「……什么！？」",
            "VoiceFileName": "10204210400",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421045,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 45,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "「爱无法被撕裂……/n　不论被怎样的力量分开……」",
            "VoiceFileName": "10204210410",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1020421046,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 46,
            "SpeakerName": "时雨",
            "FontSize": 2,
            "Phrase": "「小房间里沉睡的人们……！？」",
            "VoiceFileName": "10204210420",
            "CharacterMotions": [],
            "SpeakerIconId": "205"
        },
        {
            "Id": 1020421047,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 47,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "「到底……发生了什么！？」",
            "VoiceFileName": "10204210430",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020421048,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 48,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「哦……哦哦……我深爱的妻子们……！/n　为什么，你们会在这里……！？」",
            "VoiceFileName": "10204210440",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421049,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 49,
            "SpeakerName": "大黑",
            "FontSize": 2,
            "Phrase": "「是你……把我们带到了这里……」",
            "VoiceFileName": "10204210450",
            "CharacterMotions": [],
            "SpeakerIconId": "202"
        },
        {
            "Id": 1020421050,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 50,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "「是你，让我们……始终连接在一起……」",
            "VoiceFileName": "10204210460",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1020421051,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 51,
            "SpeakerName": "大黑",
            "FontSize": 2,
            "Phrase": "「所以……来吧……一起走吧。」",
            "VoiceFileName": "10204210470",
            "CharacterMotions": [],
            "SpeakerIconId": "202"
        },
        {
            "Id": 1020421052,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 52,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "「和我们一起……去往同一个地方……」",
            "VoiceFileName": "10204210480",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1020421053,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 53,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "「怎、怎么会……放开我！」",
            "VoiceFileName": "10204210490",
            "CharacterMotions": [],
            "SpeakerIconId": "203"
        },
        {
            "Id": 1020421054,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 54,
            "SpeakerName": "大黑",
            "FontSize": 2,
            "Phrase": "「绝不放手……直到永远……」",
            "VoiceFileName": "10204210500",
            "CharacterMotions": [],
            "SpeakerIconId": "202"
        },
        {
            "Id": 1020421055,
            "EpisodeMasterId": 1020421,
            "Order": 1,
            "GroupOrder": 55,
