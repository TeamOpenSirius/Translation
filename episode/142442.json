            "EpisodeMasterId": 142442,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "王雪",
            "FontSize": 2,
            "Phrase": "（这件婚纱好重……。/n　就算只是稍微换个角度，都很费劲……）",
