            "GroupOrder": 15,
            "SpeakerName": "王雪",
            "FontSize": 2,
            "Phrase": "（这……这样吗？/n　不过婚纱这东西，真的好难走路……！）",
            "BackgroundCharacterImageFileName": "142440_0",
            "VoiceFileName": "1424420120",
