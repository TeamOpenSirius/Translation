      "EpisodeMasterId": 1040217,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "那样会剧透的！　剧透绝对不行！/n要是提前让观众准备，他们反而会分心！",
      "VoiceFileName": "10402170250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 2,
          "LipSyncMasterId": 4,
