      "GroupOrder": 29,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "啊！　这样怎么样？　Call之前先让女王下命令。/n然后让有空的人扮扑克牌士兵，给观众发应援扇！",
      "VoiceFileName": "10402170270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 8,
          "LipSyncMasterId": 1,
          "SpineId": 40303,
