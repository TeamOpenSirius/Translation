      "GroupOrder": 26,
      "SpeakerName": "電姫団員A",
      "FontSize": 2,
      "Phrase": "那怎么办？　开场前先带大家练一下？",
      "VoiceFileName": "10402170240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
