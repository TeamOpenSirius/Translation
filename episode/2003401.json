    {
      "Id": 2003401019,
      "EpisodeMasterId": 2003401,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "要",
      "FontSize": 2,
      "Phrase": "故事舞台是被超级大国神圣布里塔尼亚帝国占领的日本。/n主人公鲁路修，是生活在那里的头脑聪明、冷静沉着的高中生。",
      "VoiceFileName": "20034010180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "406"
    },
    {
      "Id": 2003401020,
      "EpisodeMasterId": 2003401,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "要",
      "FontSize": 2,
      "Phrase": "以普通学生身份生活的鲁路修，有一天获得了/n能强制别人服从自己命令的绝对服从之力“Geass”。",
      "VoiceFileName": "20034010190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "406"
    },
    {
      "Id": 2003401021,
      "EpisodeMasterId": 2003401,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "要",
      "FontSize": 2,
      "Phrase": "为了替被杀的母亲复仇，也为了妹妹的未来，鲁路修利用Geass以及/n自己能动用的一切手段，开始反抗自己的祖国——帝国。",
      "VoiceFileName": "20034010200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 8,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
