      "EpisodeMasterId": 2001301,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "店主",
      "FontSize": 2,
      "Phrase": "那个真是太厉害了！/n商店街的人全围着电视看，热闹得不得了！",
      "VoiceFileName": "20013010250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
