    {
      "Id": 1050108022,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "『哈啊……赫拉倒也不坏，/n　可像这样在一起久了，果然还是会腻啊。』",
      "VoiceFileName": "10501080190",
      "CharacterMotions": [],
      "SpeakerIconId": "104"
    },
    {
      "Id": 1050108023,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "『有没有哪位少女，能让这颗冷却的心再次燃烧起来，/n　就这样出现在某处呢？』",
      "VoiceFileName": "10501080200",
      "CharacterMotions": [],
      "SpeakerIconId": "104"
    },
    {
      "Id": 1050108024,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "『……好。就当散心，看看人间吧……。/n　嗯？海边站着个少女？让我瞧瞧……』",
      "VoiceFileName": "10501080210",
      "CharacterMotions": [],
      "SpeakerIconId": "104"
    },
    {
      "Id": 1050108025,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "『多么美丽的少女……！/n　地点是波塞冬的神殿，是兄长那里的巫女吗……？』",
      "VoiceFileName": "10501080220",
      "CharacterMotions": [],
      "SpeakerIconId": "104"
    },
    {
      "Id": 1050108026,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "『看来得想个办法了啊……』",
      "VoiceFileName": "10501080230",
      "CharacterMotions": [],
      "SpeakerIconId": "104"
    },
    {
      "Id": 1050108027,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "评审L",
      "FontSize": 2,
      "Phrase": "（从未演过的角色类型，居然已经完全化为了自己的东西。/n　天狼星的新妻八惠……这成长速度真是可怕。）",
      "VoiceFileName": "10501080240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050108028,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 28,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "301",
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1050108029,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "『怎么样？诸位神明。是不是很有趣？』",
      "VoiceFileName": "10501080250",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1050108030,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "『我想各位平日里都没少被宙斯大人任性折腾，/n　心里多少都有些想法吧。』",
      "VoiceFileName": "10501080260",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1050108031,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "『看来宙斯大人把那位少女认错了。/n　不如就利用这点，捉弄宙斯大人一番如何？』",
      "VoiceFileName": "10501080270",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1050108032,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "评审M",
      "FontSize": 2,
      "Phrase": "（白丸美兔……虽然早就听说过，/n　在附身型演员中，这份表现力也确实出类拔萃。精彩。）",
      "VoiceFileName": "10501080280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050108033,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "『哦……？赫尔墨斯，你打算做什么？/n　不妨详细说来听听。』",
      "VoiceFileName": "10501080290",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1050108034,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 34,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1050108035,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "『啊～～，笑得真痛快！好久没机会和弟弟这样玩了。/n　当然得帮忙。好了……你说要办宴会——』",
      "VoiceFileName": "10501080300",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1050108036,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "『那宴会场地就由我来准备吧。』",
      "BackgroundCharacterImageFileName": "142520_0",
      "VoiceFileName": "10501080310",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1050108037,
      "EpisodeMasterId": 1050108,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "『海啊，分开吧！为众神献上宴饮之所！』",
      "BackgroundCharacterImageFileName": "142520_0",
      "VoiceFileName": "10501080320",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
