        {
            "Id": 34039508,
            "EpisodeType": 5,
            "CharacterId": 402,
            "SpeakerName": "",
            "Description": "难道你们买到了……？/n真好啊～，不愧是伊吕波酱，周边一点都不会漏掉呢。",
            "Order": 8
        },
        {
            "Id": 34039509,
            "EpisodeType": 5,
            "CharacterId": 401,
