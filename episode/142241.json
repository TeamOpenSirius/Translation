            "EpisodeMasterId": 142241,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "Eden剧团成员",
            "FontSize": 2,
            "Phrase": "当然要配合神社的氛围，而且为了确保结构安全，/n请和风建筑的专业人士亲自到场确认应该最稳妥。",
            "VoiceFileName": "1422410190",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
