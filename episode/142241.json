            "EpisodeMasterId": 142241,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "嗯，我正是这样打算的。/n……这里是一座很棒的神社，在这里一定能做出好舞台。",
            "VoiceFileName": "1422410050",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
