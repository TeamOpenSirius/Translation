        {
            "Id": 142241006,
            "EpisodeMasterId": 142241,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "神主",
            "FontSize": 2,
            "Phrase": "我明白了。/n我们愿意将这座神社借给Eden剧团的各位举行公演。",
            "VoiceFileName": "1422410060",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142241007,
            "EpisodeMasterId": 142241,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "神主",
            "FontSize": 2,
            "Phrase": "舞台搭建方面也请交给我们。/n在当天之前，我们会在这里为舞台搭好台座。",
            "VoiceFileName": "1422410070",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142241008,
            "EpisodeMasterId": 142241,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "非常感谢。对于您的协助，我由衷感激。/n我一定会做出一台留在每位到访者记忆中的最佳演出。",
            "VoiceFileName": "1422410080",
            "CharacterMotions": [
