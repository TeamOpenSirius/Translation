            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "神主",
            "FontSize": 2,
            "Phrase": "原来如此……。不是在剧场那样的室内演出，/n而是要在我们神社的境内搭建舞台进行公演……。",
            "VoiceFileName": "1422410020",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
