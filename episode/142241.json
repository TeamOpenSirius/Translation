            "EpisodeMasterId": 142241,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "具体的舞台搭建设想等内容，/n都整理在这份资料里了，请过目。",
