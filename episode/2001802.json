      "EpisodeMasterId": 2001802,
      "Order": 1,
      "GroupOrder": 48,
      "SpeakerName": "时雨的母亲",
      "FontSize": 2,
      "Phrase": "可站在最顶点……能成为 World Dai Star 的人，/n听说只有极少数吧。",
