      "GroupOrder": 49,
      "SpeakerName": "时雨的母亲",
      "FontSize": 2,
      "Phrase": "与其追求那种东西，能赚钱的工作多的是。/n比起做没用的事，好好学习才对你更有好处。",
      "WindowEffect": 1,
      "VoiceFileName": "20018020370",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
