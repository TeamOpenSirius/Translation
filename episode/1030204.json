      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030204002,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（主演白雪公主的是莉莉亚。/n　为她助阵的，是引领银河座的一众豪华演员）",
      "VoiceFileName": "10302040020",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030204003,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（然后，首演之日到来。/n　银河剧场座无虚席——）",
      "VoiceFileName": "10302040030",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030204004,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（——最终取得了无可挑剔的大成功）",
      "BackgroundImageFileName": "663",
      "VoiceFileName": "10302040040",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030204005,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 5,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "700",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.5,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.30000001192092896
    },
    {
      "Id": 1030204006,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "今天我们请到库尔特贝小姐和千寿小姐作为嘉宾，/n来和我们聊聊。首先从观众们的感想开始。",
      "BgmFileName": "202",
      "VoiceFileName": "10302040050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030204007,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "“被银河座独有的豪华舞台深深吸引了！/n七个小矮人也非常可爱！”",
      "VoiceFileName": "10302040060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030204008,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "其中最多的评价，是“前所未见的白雪公主”。/n库尔特贝小姐营造出的妖异而又梦幻易碎的世界观，实在精彩！",
      "VoiceFileName": "10302040070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030204009,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "我又一次用自己的美把整个作品染上了颜色……。",
      "VoiceFileName": "10302040080",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030204010,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "是呢……。",
      "VoiceFileName": "10302040090",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030204011,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "千寿小姐这次的形象转变也成了热门话题。/n上次是辉夜姬，这次却是继母，跨度真大。",
      "VoiceFileName": "10302040100",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030204012,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "对我来说也是一次挑战。/n看来各位都很喜欢，我也放心了。",
      "VoiceFileName": "10302040110",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030204013,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "广告之后，我们还会继续请二位聊聊——",
      "VoiceFileName": "10302040120",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030204014,
      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "只采访她们两个吗？/n这些媒体……。",
      "VoiceFileName": "10302040130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 600,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 4,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
