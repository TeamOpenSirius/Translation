      "EpisodeMasterId": 1030204,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "哦哦！卡米拉和潘达也在夸我们！/n说小矮人的舞蹈很可爱！",
      "VoiceFileName": "10302040140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
