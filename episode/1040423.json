    {
      "Id": 1040423035,
      "EpisodeMasterId": 1040423,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "评审A",
      "FontSize": 2,
      "Phrase": "……说实话，我之前小看她们了。/n没想到能把《绿野仙踪》做到那个程度……。",
      "VoiceFileName": "10404230340",
      "CharacterMotions": [],
