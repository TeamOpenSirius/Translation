    {
      "Id": 1040423036,
      "EpisodeMasterId": 1040423,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "是啊……也超出了我的预想，让我很惊讶。/n那台舞台的完成度，和我们此前评审过的剧团相比毫不逊色。",
      "VoiceFileName": "10404230350",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
