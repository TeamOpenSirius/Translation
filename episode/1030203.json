      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "——白雪公主的继母。反派。/n和上次的辉夜姬完全相反，能演吧？",
