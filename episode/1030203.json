      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（那家伙本来就不是演白雪公主的类型，和预想一样。/n　接下来才是关键）",
      "VoiceFileName": "10302030110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
