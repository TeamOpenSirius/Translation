      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（不对，我试镜明明发挥得那么好！/n　那白雪公主到底是谁——）",
      "VoiceFileName": "10302030190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 3,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
