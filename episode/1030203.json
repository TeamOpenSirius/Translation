      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030203022,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（果然，果然还是这样！/n　家世和话题性更重要吗！）",
      "VoiceFileName": "10302030220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 300,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 17,
          "SpineId": 30303,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
