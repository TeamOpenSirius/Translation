          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030203012,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "下一位，克莱尔·亚当斯。鹿岛志穗。弗兰卡·科波拉。/n宽·颂甘。阿马尔·哈基姆——",
      "VoiceFileName": "10302030120",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030203013,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "——与那国绯花里。",
      "VoiceFileName": "10302030130",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030203014,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "是！",
      "VoiceFileName": "10302030140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 30503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030203015,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（绯花里也出局了。到目前为止已经叫了六个人。/n　也就是说，这些都是小矮人的角色。我肯定不会被叫——）",
      "VoiceFileName": "10302030150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 7,
          "SpineId": 30303,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030203016,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "然后，王雪。以上七人，饰演七个小矮人！",
      "VoiceFileName": "10302030160",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030203017,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "什……！？",
      "VoiceFileName": "10302030170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 401,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 30303,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030203018,
      "EpisodeMasterId": 1030203,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（什、什么——！？/n　我居然是小矮人！？）",
      "VoiceFileName": "10302030180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 300,
          "BodyMotionMasterId": 11,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
