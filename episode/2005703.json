      "EpisodeMasterId": 2005703,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "我还会再来的，双叶。",
      "VoiceFileName": "20057030080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 3,
