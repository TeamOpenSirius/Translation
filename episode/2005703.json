    {
      "Id": 2005703002,
      "EpisodeMasterId": 2005703,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "之前跟你说过的《俄狄浦斯王》，/n顺利结束了。",
      "VoiceFileName": "20057030020",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
