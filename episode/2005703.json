        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 2005703003,
      "EpisodeMasterId": 2005703,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "观众的评价也很好，虽然同样是悲剧，却和《恶魔的朋友》不一样，/n成功打动了很多人的心。",
      "VoiceFileName": "20057030030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 200,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 2005703004,
      "EpisodeMasterId": 2005703,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "对了，之前我带来的那四个人，你还记得吧？/n她们对你很感兴趣。",
      "VoiceFileName": "20057030040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 2005703005,
      "EpisodeMasterId": 2005703,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "我想着下次把你的照片给她们看看。/n怎么样？",
      "VoiceFileName": "20057030050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 2005703006,
      "EpisodeMasterId": 2005703,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "呵呵，如果是你，应该会自己跑去给她们看吧。/n没准还会因为舞台的话题聊得很投机。",
      "VoiceFileName": "20057030060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 200,
          "BodyMotionMasterId": 24,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
