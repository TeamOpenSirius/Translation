      "SpeakerIconId": "201"
    },
    {
      "Id": 2005703010,
      "EpisodeMasterId": 2005703,
      "Order": 1,
      "GroupOrder": 10,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1261",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "403",
      "SeFileName": "1570",
      "CharacterMotions": [],
      "FadeValue1": 0.30000001192092896,
