    "Title": "【Future Dai Star】剧团电姬",
    "EpisodeDetail": [
        {
            "Id": 23057008,
            "EpisodeType": 0,
            "CharacterId": null,
            "SpeakerName": "",
            "Description": "【Future Dai Star】剧团电姬/n千寿伊吕波/n白丸美兔/n阿岐留卡米拉/n猫足蕾/n本巢叶羽",
            "Order": 8
        },
        {
            "Id": 23057501,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "呼——，结束了结束了。/n那就辛苦各位拍摄啦～。",
            "Order": 1
        },
        {
            "Id": 23057502,
            "EpisodeType": 5,
            "CharacterId": 401,
            "SpeakerName": "",
            "Description": "等等叶羽酱！/n难得大家穿同款服装，不拍点花絮照太浪费了！",
            "Order": 2
        },
        {
            "Id": 23057503,
            "EpisodeType": 5,
            "CharacterId": 403,
            "SpeakerName": "",
            "Description": "啊！我也想拍！/n杂志发售的时候我还想发个介绍视频什么的。",
            "Order": 3
        },
        {
            "Id": 23057504,
            "EpisodeType": 5,
            "CharacterId": 403,
            "SpeakerName": "",
            "Description": "来，叶羽，笑一个！预备，电姬～！",
            "Order": 4
        },
        {
            "Id": 23057505,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "诶～我都已经下班停止营业啦～。/n去拍后面的梅花不就好了。你看，多漂亮。",
            "Order": 5
        },
        {
            "Id": 23057506,
            "EpisodeType": 5,
            "CharacterId": 404,
            "SpeakerName": "",
            "Description": "呵呵，拍摄开始前阿岐留还紧张得不得了，/n现在已经完全恢复平时的样子了。",
            "Order": 6
        },
        {
            "Id": 23057507,
            "EpisodeType": 5,
            "CharacterId": 402,
            "SpeakerName": "",
            "Description": "是的。采访时也和伊吕波酱她们回答得很开心。/n拍摄也很顺利……真的太好了。",
            "Order": 7
        },
        {
            "Id": 23057508,
            "EpisodeType": 5,
            "CharacterId": 404,
            "SpeakerName": "",
            "Description": "白丸觉得怎么样？　/n紧张了吗？",
            "Order": 8
        },
        {
            "Id": 23057509,
            "EpisodeType": 5,
            "CharacterId": 402,
            "SpeakerName": "",
            "Description": "美兔的话……和大家待在一起就很安心，/n感觉应该把平常的电姬展现出来了。",
            "Order": 9
        },
        {
            "Id": 23057510,
            "EpisodeType": 5,
            "CharacterId": 404,
            "SpeakerName": "",
            "Description": "那就好。虽说没想到本巢会直接躺下来……。/n电子公主们的魅力应该已经充分传达出去了。",
            "Order": 10
        },
        {
            "Id": 23057511,
            "EpisodeType": 5,
            "CharacterId": 402,
            "SpeakerName": "",
            "Description": "……！是！",
            "Order": 11
        },
        {
            "Id": 23057512,
            "EpisodeType": 5,
            "CharacterId": 401,
            "SpeakerName": "",
            "Description": "美兔酱！蕾小姐！/n最后再拍一张大家的纪念照吧！叶羽酱也来！",
            "Order": 12
        },
        {
            "Id": 23057513,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "真是的～，拿你们没办法。/n我给你们摆个压箱底的姿势，所以真的是最后一张哦。",
            "Order": 13
        },
        {
            "Id": 23057514,
            "EpisodeType": 5,
            "CharacterId": 403,
            "SpeakerName": "",
            "Description": "好——，那我也加个珍藏滤镜！/n大家准备好了吗？要拍喽～！",
            "Order": 14
        },
        {
            "Id": 23057515,
            "EpisodeType": 5,
            "CharacterId": 403,
            "SpeakerName": "",
            "Description": "预备，电姬～！",
            "Order": 15
        }
    ]
}
