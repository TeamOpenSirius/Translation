      "EpisodeMasterId": 2003106,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "孤独中的绝望，还有希望……。",
      "VoiceFileName": "20031060090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 106,
