      "EpisodeMasterId": 2003106,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "讲师",
      "FontSize": 2,
      "Phrase": "接下来请大家不用台词，只靠动作传达感情和故事。/n可能会觉得很难，不过请放松来尝试。",
      "VoiceFileName": "20031060030",
      "CharacterMotions": [],
