      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "讲师",
      "FontSize": 2,
      "Phrase": "表达方式不必拘泥于现实中的动作。除了哑剧，/n舞蹈、芭蕾等各种肢体表现也可以自由加入。",
      "VoiceFileName": "20031060100",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
