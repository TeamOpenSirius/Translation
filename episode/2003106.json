      "EpisodeMasterId": 2003106,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "讲师",
      "FontSize": 2,
      "Phrase": "在舞台上扮演角色时，表演不只包括说出台词，/n表情、肢体动作和站姿，也都属于表演的一部分吧。",
      "VoiceFileName": "20031060020",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
