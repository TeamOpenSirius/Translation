    },
    {
      "Id": 1030319002,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（——银河座《麦克白》，迎来了首演）",
      "VoiceFileName": "10303190010",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319003,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（漂亮、美丽，就是我。那就是莉莉亚·库尔特贝。/n　然后——）",
      "VoiceFileName": "10303190020",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319004,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（——漂亮又肮脏，肮脏又美丽，也同样是我。/n　沐浴聚光灯，紧紧攥住人心的，也是我）",
      "VoiceFileName": "10303190030",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319005,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 5,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1860",
      "BackgroundImageFileFadeType": 4,
      "BgmFileName": "905",
      "CharacterMotions": [],
      "FadeValue1": 0.800000011920929
    },
    {
      "Id": 1030319006,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“还在这里。残留在我的双手上……。/n　那令人作呕的气味，那污秽的血迹……！”",
      "VoiceFileName": "10303190040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 3,
          "SpineId": 30428,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319007,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“怎么洗都洗不掉，气味也散不去……！/n　阿拉伯的香水、高卢的肥皂，都遮不住这双手的污秽！”",
      "VoiceFileName": "10303190050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 300,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 6,
          "LipSyncMasterId": 3,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319008,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“那些人已经埋在地下，再也不会回到这个世界。/n　可我的手仍然脏着，仍然污秽……。啊……！”",
      "BackgroundImageFileName": "663",
      "VoiceFileName": "10303190060",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319009,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“……亲爱的。我已经受够了。真的受够了……！/n　不要，不要，不要……！”",
      "VoiceFileName": "10303190070",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319010,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“不啊啊啊啊啊啊啊啊——！！！”",
      "BackgroundImageFileName": "1131",
      "VoiceFileName": "10303190080",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030319011,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 11,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "641",
      "BackgroundImageFileFadeType": 4,
      "CharacterMotions": [],
      "FadeValue1": 0.800000011920929
    },
    {
      "Id": 1030319012,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（——演员们、优秀的幕后人员，以及座无虚席的观众，/n　都为贪婪却美丽的麦克白夫人之死屏住了呼吸）",
      "VoiceFileName": "10303190090",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319013,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（那不是简单的洗手动作。/n　她的指甲几乎要掐进美丽的肌肤，像要亲手把自己撕裂）",
      "VoiceFileName": "10303190100",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319014,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（原本洁净的双手仿佛被溅来的鲜血玷污，甚至连气味都仿佛真实存在。/n　——我竟然也看得入迷，这让我有些不甘）",
      "VoiceFileName": "10303190110",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319015,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 15,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1131",
      "BackgroundImageFileFadeType": 4,
      "CharacterMotions": [],
      "FadeValue1": 0.800000011920929
    },
    {
      "Id": 1030319016,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“无论富有之人还是美丽之人，都逃不过通往死亡的旅途。/n　让一个又一个明日刻下时间，总有一天终点会到来。”",
      "VoiceFileName": "10303190120",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319017,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“那么，回首的昨日，便是照亮死亡道路的灯火。/n　直到愚蠢的人化为尘土那一天，它都会执拗地继续亮着。”",
      "VoiceFileName": "10303190130",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319018,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 18,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "663",
      "BackgroundImageFileFadeType": 4,
      "CharacterMotions": [],
      "FadeValue1": 0.800000011920929
    },
    {
      "Id": 1030319019,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“……熄灭吧，熄灭吧。转瞬即逝的灯火！/n　人生只是游走的影子，是个可怜的演员。”",
      "VoiceFileName": "10303190140",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319020,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“在舞台上声嘶力竭，幕落之后却归于沉默的黑暗。/n　不过是愚人夸夸其谈的、淡薄而虚幻的妄语。”",
      "VoiceFileName": "10303190150",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319021,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 21,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1860",
      "BackgroundImageFileFadeType": 4,
      "BgmFileName": "999",
      "CharacterMotions": [],
      "FadeValue1": 0.800000011920929
    },
    {
      "Id": 1030319022,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“那一生……根本没有任何意义。”",
      "VoiceFileName": "10303190160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 30128,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030319023,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 23,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "641",
      "BackgroundImageFileFadeType": 1,
      "SeFileName": "71",
      "CharacterMotions": [],
      "FadeValue1": 0.800000011920929,
      "FadeValue2": 1.0,
      "FadeValue3": 0.800000011920929
    },
    {
      "Id": 1030319024,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "哎呀～看完这么厉害的东西，人都不自觉坐直了呢～。/n比我想象的还要厉害。",
      "BgmFileName": "403",
      "VoiceFileName": "10303190170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 20401,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 1030319025,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "仁花子",
      "FontSize": 2,
      "Phrase": "我事先还把《麦克白》重读了一遍，/n可就算知道剧情，还是完全移不开眼……。",
      "VoiceFileName": "10303190180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 20301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 20401,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "203"
    },
    {
      "Id": 1030319026,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "就是啊。明明悲惨到让人想别开视线，/n回过神来，却已经被舞台吸进去了。",
      "VoiceFileName": "10303190190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 105,
          "HeadMotionMasterId": 1,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 1030319027,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "大黑",
      "FontSize": 2,
      "Phrase": "吾主……您觉得如何？",
      "VoiceFileName": "10303190200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 20201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "202"
    },
    {
      "Id": 1030319028,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "……拘谨又无趣，老套透顶的戏。/n我和那群人的品味果然完全合不来。",
      "VoiceFileName": "10303190210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 305,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 20101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 1030319029,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "虽然莉莉亚毫无遮掩的自我，展现出了超越常规的美，/n但归根结底，还是被困在传统的牢笼里。",
      "VoiceFileName": "10303190220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 1030319030,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "嘛，确实是很厉害的戏啦～。/n不过按时雨来说，气氛太沉重，看得好累哦～。",
      "VoiceFileName": "10303190230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 27,
          "LipSyncMasterId": 1,
          "SpineId": 20501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 1030319031,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "仁花子",
      "FontSize": 2,
      "Phrase": "咦？可是时雨亲后半段一直在哭吧？/n我借你的手帕都湿透了。",
      "VoiceFileName": "10303190240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 20301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "203"
    },
    {
      "Id": 1030319032,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "这、这不是很正常嘛～？像时雨这种眼光这么高的人当然会……",
      "VoiceFileName": "10303190250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 1,
          "SpineId": 20501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 1030319033,
      "EpisodeMasterId": 1030319,
      "Order": 2,
      "GroupOrder": 32,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "……为什么我没坐远一点看啊——……！",
      "VoiceFileName": "10303190251",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 74,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 23,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 1030319034,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "大黑",
      "FontSize": 2,
      "Phrase": "不用害羞……小孩子的工作就是哭吧？",
      "VoiceFileName": "10303190260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 6,
          "LipSyncMasterId": 1,
          "SpineId": 20201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "202"
    },
    {
      "Id": 1030319035,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "可以不要把人家当婴儿吗！？",
      "VoiceFileName": "10303190270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 300,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 3,
          "SpineId": 20501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 1030319036,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "仁花子",
      "FontSize": 2,
      "Phrase": "说起来，Saint-Cloud Guide的秘密调查员，/n会不会就混在这些观众里？",
      "VoiceFileName": "10303190280",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 4,
          "SpineId": 20301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "203"
    },
    {
      "Id": 1030319037,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "呵呵呵，说不定其实就是我哦～？",
      "VoiceFileName": "10303190290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 20401,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 1030319038,
      "EpisodeMasterId": 1030319,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "要真是你，Eden没被选上不是很奇怪吗～？",
