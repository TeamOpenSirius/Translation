            "EpisodeMasterId": 142391,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（……我的父母在我决定加入银河座时，/n　值得庆幸的是，他们选择支持我……）",
            "VoiceFileName": "1423910110",
            "CharacterMotions": [
