            "SpeakerIconId": "201"
        },
        {
            "Id": 142391014,
            "EpisodeMasterId": 142391,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（既然如此，作为剧团负责人，为了斩断我Eden演员的忧虑，/n　就去寻找能成为“成绩”的某种东西吧。走世界戏剧联盟以外的道路）",
            "VoiceFileName": "1423910130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 13,
                    "SpineId": 20103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
