            "EpisodeMasterId": 142391,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（……不过我早就知道戏剧界很容易被旧观念束缚……。/n　可这些奖项和比赛，还真是一个比一个大同小异……）",
            "VoiceFileName": "1423910140",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 73,
                    "BodyMotionMasterId": 7,
                    "SpineId": 20103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 142391016,
            "EpisodeMasterId": 142391,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "真是的，一个个都跟着世界戏剧联盟走，缩在自己的小圈子里……。/n连刊载最新戏剧界消息的杂志里，都找不到我想要的东西吗。",
            "VoiceFileName": "1423910150",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 4,
                    "SpineId": 20103,
