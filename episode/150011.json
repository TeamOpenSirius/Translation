            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "那种事并不重要。/n我的力量就是为了帮助别人，只不过是在完成自己的使命。",
            "VoiceFileName": "1500110180",
            "CharacterMotions": [
