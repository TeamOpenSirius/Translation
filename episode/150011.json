            "SpeakerIconId": "302"
        },
        {
            "Id": 150011012,
            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "市民A",
            "FontSize": 2,
            "Phrase": "好、好的！",
            "VoiceFileName": "1500110100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150011013,
            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "？？？",
            "FontSize": 2,
            "Phrase": "真让人头疼啊，要是让那边的人全逃掉了。/nStellarium的开采工作不就得停下来了吗？",
            "VoiceFileName": "1500110110",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150011014,
            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "……卡特莉娜，你也在这个绝望圈吗。",
            "VoiceFileName": "1500110120",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 4,
                    "SpineId": 30234,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
            "Id": 150011015,
            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "是啊，最近听说有只老鼠不断袭击各地的绝望圈。/n我还想着该不会是你，结果果然如此。",
            "VoiceFileName": "1500110130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 10334,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 30234,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "103"
        },
        {
            "Id": 150011016,
            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "市民B",
            "FontSize": 2,
            "Phrase": "咿……！那身制服……帝、帝国的惩戒官！",
            "VoiceFileName": "1500110140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150011017,
            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "……走吧，这里由我挡住。/n我不会让她碰你们一根手指。",
            "VoiceFileName": "1500110150",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 104,
                    "BodyMotionMasterId": 14,
                    "LipSyncMasterId": 4,
                    "SpineId": 30234,
                    "CharacterAppearanceType": 0,
