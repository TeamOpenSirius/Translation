        },
        {
            "Id": 150011019,
            "EpisodeMasterId": 150011,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "哎呀，真没关系吗？这样可听不到他们道谢了哦？",
