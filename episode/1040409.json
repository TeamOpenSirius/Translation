      "EpisodeMasterId": 1040409,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "所以美兔……如果要站上舞台，希望能和伊吕波亲一起。/n我想演出连伊吕波亲也能满意……让我们两个人都能开心的戏。",
      "VoiceFileName": "10404090080",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
