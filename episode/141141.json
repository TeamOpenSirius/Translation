            "EpisodeMasterId": 141141,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "汤岛",
            "FontSize": 2,
            "Phrase": "哎呀，您看起来没什么精神。以千寿历小姐这个年纪，/n我还以为一磅牛排来两三块都能轻松吃下。",
            "VoiceFileName": "1411410130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
