            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "大家的心意当然令人高兴，/n但这数量已经很难说是能很快消耗掉的东西……。",
            "VoiceFileName": "1411410160",
            "CharacterMotions": [
