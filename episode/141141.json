            "EpisodeMasterId": 141141,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "汤岛",
            "FontSize": 2,
            "Phrase": "是啊。前天是送给夫人的，前一天是送给老夫人的。/n上周还有演剧集团丹波的代表送来问候礼。",
            "VoiceFileName": "1411410150",
            "CharacterMotions": [
