        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201014,
      "EpisodeMasterId": 1030201,
      "Order": 2,
      "GroupOrder": 12,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "让我看看——",
      "VoiceFileName": "10302010091",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201015,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……什么啊，只是在谢我送了直播票。/n回他一句“比起这个先夸夸我”。",
      "VoiceFileName": "10302010100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201016,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 14,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "1670",
      "CharacterMotions": []
    },
    {
      "Id": 1030201017,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "对对，这样才对！哈哈哈！/n下一张票也——",
      "VoiceFileName": "10302010110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 200,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201018,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……很期待我当主演吗。",
      "VoiceFileName": "10302010120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 402,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201019,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "电视",
      "FontSize": 2,
      "Phrase": "接下来是“发掘·未来Dai Star”环节。/n今天的嘉宾，是来自德国的超级新星！",
      "VoiceFileName": "10302010130",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201020,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "嗯？德国……？",
      "VoiceFileName": "10302010140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201021,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 19,
      "FontSize": 2,
      "Phrase": "",
      "CharacterMotions": []
    },
    {
      "Id": 1030201022,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "我是银河座的拉莫娜·沃尔芙。",
      "VoiceFileName": "10302010150",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030201023,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "我是剧团天狼星的卡特莉娜·格利贝尔。/n请多关照。",
      "VoiceFileName": "10302010160",
      "CharacterMotions": [],
      "SpeakerIconId": "103"
    },
    {
      "Id": 1030201024,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "德国时期的故事稍后再请二位分享。/n首先，两位主演辛苦了！",
      "VoiceFileName": "10302010170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201025,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "主演……。",
      "VoiceFileName": "10302010180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201026,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "观众寄来了很多留言。/n我来为大家介绍。",
      "VoiceFileName": "10302010190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201027,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "“我是在《竹取物语》里第一次注意到拉莫娜大人的新粉，/n前段时间看过她主演的舞台后彻底被迷住了！”",
      "VoiceFileName": "10302010200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201028,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "很荣幸，谢谢。那部作品算是我的成名作了。",
      "VoiceFileName": "10302010210",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030201029,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "我们这边评价也很好哦。室友一直吵着说/n“不愧是银河座！”，烦得不得了。",
      "VoiceFileName": "10302010220",
      "CharacterMotions": [],
      "SpeakerIconId": "103"
    },
    {
      "Id": 1030201030,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "哈哈哈，你主演的《人鱼公主》也非常精彩。",
      "VoiceFileName": "10302010230",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030201031,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "当然，格利贝尔小姐也收到了留言。/n“无论看多少次，天狼星的《人鱼公主》都会让人落泪！”",
      "VoiceFileName": "10302010240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201032,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "非常感谢。/n作为主演，能得到这样的评价是我的荣幸。",
      "VoiceFileName": "10302010250",
      "CharacterMotions": [],
      "SpeakerIconId": "103"
    },
    {
      "Id": 1030201033,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……。",
      "VoiceFileName": "10302010260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "BodyMotionMasterId": 7,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201034,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "最近，把活动据点转移到日本的海外演员也越来越多了。",
      "VoiceFileName": "10302010270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201035,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "以银河座来说，就有被称为“北欧妖精”的库尔特贝小姐。/n除此之外，也有许多海外出身的Dai Star候补正在活跃。",
      "VoiceFileName": "10302010280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201036,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……没提到我的名字。/n我也是海外出身啊……。",
      "VoiceFileName": "10302010290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201037,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "主持人",
      "FontSize": 2,
      "Phrase": "那么接下来，就让我们一起回顾二位一路走来的经历。/n先从德国时期说起——",
      "VoiceFileName": "10302010300",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030201038,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 36,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "2080",
      "CharacterMotions": []
    },
    {
      "Id": 1030201039,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "只演配角的演员就不值得关注吗？/n居然敢小看我……。",
      "VoiceFileName": "10302010310",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 305,
          "BodyMotionMasterId": 8,
          "LipSyncMasterId": 4,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030201040,
      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 38,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "2110",
      "CharacterMotions": []
    },
    {
