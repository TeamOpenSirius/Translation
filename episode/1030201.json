      "EpisodeMasterId": 1030201,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "真是的，哥哥还发个不停。",
      "VoiceFileName": "10302010090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 1,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
