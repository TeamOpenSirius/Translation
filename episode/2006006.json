      "EpisodeMasterId": 2006006,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "当年我还只是银河座年轻演员的时候，也曾陪着千寿的母亲……千寿女士，/n一起去过海边。",
      "VoiceFileName": "20060060230",
