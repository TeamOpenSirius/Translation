      "EpisodeMasterId": 2006006,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“不，你还没有真正听见。/n　来，闭上眼睛……”",
      "VoiceFileName": "20060060050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
