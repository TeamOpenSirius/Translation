      "EpisodeMasterId": 2006006,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“低语？……呵呵，真诗意。/n　的确，听着潮声，内心会变得平静……”",
      "VoiceFileName": "20060060040",
      "CharacterMotions": [
