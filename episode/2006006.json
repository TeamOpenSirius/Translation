      "EpisodeMasterId": 2006006,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "是啊……实际去海边一趟也不错。/n会更容易抓住感觉。",
      "VoiceFileName": "20060060200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
