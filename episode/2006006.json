    {
      "Id": 2006006006,
      "EpisodeMasterId": 2006006,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“没关系。如果还是听不见，就牵住我的手。/n　连声音也忘掉，把意识只集中在手上的触感……”",
      "VoiceFileName": "20060060060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006006007,
      "EpisodeMasterId": 2006006,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“这样……吗。……！/n　真的。夹杂在浪声里……我听见了，声音。一直没有停……”",
      "VoiceFileName": "20060060070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
