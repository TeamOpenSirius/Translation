      "EpisodeMasterId": 2006006,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "如果能亲身感受夏日大海的辽阔与活力，必然会成为演技的养分。",
      "VoiceFileName": "20060060220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
