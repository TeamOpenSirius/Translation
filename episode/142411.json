            "EpisodeMasterId": 142411,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "女孩1",
            "FontSize": 2,
            "Phrase": "啊，我见过姐姐——！是“Dai Star”的人对吧？/n呐呐，姐姐很会演戏吗？我也想看看！",
            "VoiceFileName": "1424110100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142411011,
            "EpisodeMasterId": 142411,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "八惠",
            "FontSize": 2,
            "Phrase": "诶？呃，这个……可能要等下次了？",
