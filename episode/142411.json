            "GroupOrder": 15,
            "SpeakerName": "八惠",
            "FontSize": 2,
            "Phrase": "我的话……大概就是普通水平吧。/n方便的话，之后也让我看看你游蛙泳好吗♪",
            "VoiceFileName": "1424110150",
            "CharacterMotions": [
