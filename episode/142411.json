        },
        {
            "Id": 142411013,
            "EpisodeMasterId": 142411,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "八惠",
            "FontSize": 2,
            "Phrase": "呵呵，谢谢♪/n这是我很喜欢的一件泳衣。",
