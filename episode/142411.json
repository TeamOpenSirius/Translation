            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "教会工作人员",
            "FontSize": 2,
            "Phrase": "这样啊……那我就放心了。",
            "VoiceFileName": "1424110200",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142411021,
            "EpisodeMasterId": 142411,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "教会工作人员",
            "FontSize": 2,
