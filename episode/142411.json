        },
        {
            "Id": 142411017,
            "EpisodeMasterId": 142411,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "教会工作人员",
            "FontSize": 2,
            "Phrase": "哎呀哎呀，这么快就和大家熟起来了。/n不愧是八惠亲。",
            "VoiceFileName": "1424110170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142411018,
            "EpisodeMasterId": 142411,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "八惠",
            "FontSize": 2,
            "Phrase": "没有啦，我完全没有……。/n而且刚才我还被这些孩子的活力压得有点招架不住呢。",
            "VoiceFileName": "1424110180",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 6,
                    "LipSyncMasterId": 1,
                    "SpineId": 10417,
                    "CharacterAppearanceType": 0,
