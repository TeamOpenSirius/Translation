            "EpisodeMasterId": 142411,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "八惠",
            "FontSize": 2,
            "Phrase": "不过……大家都非常开朗又温柔，/n多亏这样，我也很自然地融进来了。",
            "VoiceFileName": "1424110190",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 200,
                    "BodyMotionMasterId": 14,
