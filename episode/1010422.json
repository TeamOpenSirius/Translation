        {
            "Id": 1010422003,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『小热尔韦！小热尔韦！』",
            "VoiceFileName": "10104220020",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422004,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "天狼星剧团成员",
            "FontSize": 2,
            "Phrase": "『那边的先生，您为什么这样大声叫喊？』",
            "VoiceFileName": "10104220030",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1010422005,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『神父！您有没有见到一个孩子！』",
            "VoiceFileName": "10104220040",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422006,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "天狼星剧团成员",
            "FontSize": 2,
            "Phrase": "『孩子吗？没有』",
            "VoiceFileName": "10104220050",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1010422007,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『是个叫小热尔韦、这么高的男孩，来自萨瓦』",
            "VoiceFileName": "10104220060",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422008,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "（看来不用担心了。/n她从一开始就全力冲起来了。）",
            "VoiceFileName": "10104220070",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422009,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "（不过，这样就对了。）",
            "VoiceFileName": "10104220080",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422010,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 10,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "403",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.10000000149011612,
            "FadeValue2": 0.20000000298023224,
            "FadeValue3": 0.10000000149011612
        },
        {
            "Id": 1010422011,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "『这个卑贱的女人侮辱了市长！』",
            "VoiceFileName": "10104220090",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1010422012,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『那只是我个人的问题』",
            "VoiceFileName": "10104220100",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422013,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "『马德兰市长，恕我明知失礼仍要进言，/n这并不只是对您个人的侮辱，而是对法律的侮辱！』",
            "VoiceFileName": "10104220110",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1010422014,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "（卡特亲也进入状态到夸张的程度。/n连观众那种提心吊胆的感觉都能传过来。）",
            "VoiceFileName": "10104220120",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422015,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "心菜",
            "FontSize": 2,
            "Phrase": "『啊……啊、啊…………！』",
            "BackgroundCharacterImageFileName": "141920_0",
            "VoiceFileName": "10104220130",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1010422016,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『芳汀——』",
            "BackgroundCharacterImageFileName": "141920_0",
            "VoiceFileName": "10104220140",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422017,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "卡特莉娜",
            "FontSize": 2,
            "Phrase": "『不许动！』",
            "BackgroundCharacterImageFileName": "141920_0",
            "VoiceFileName": "10104220150",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1010422018,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "（糟了，明明排练时看过那么多次，还是会一下被击中……/n而且知冴亲的演技……比以前更刺进来了。）",
            "VoiceFileName": "10104220160",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422019,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 19,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "393",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1010422020,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『你平时都是怎么玩的？』",
            "VoiceFileName": "10104220170",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422021,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "八惠",
            "FontSize": 2,
            "Phrase": "『就玩当时能玩的东西呀。可是我没有玩具。/n　爱潘妮和阿泽玛都不肯把洋娃娃借给我。』",
            "BackgroundCharacterImageFileName": "141910_0",
            "VoiceFileName": "10104220180",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1010422022,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "（呜～，八惠亲这版珂赛特的可怜劲！/n　很好，知冴亲！全都给我引出来！）",
            "VoiceFileName": "10104220190",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422023,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 23,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "473",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.10000000149011612,
            "FadeValue2": 0.20000000298023224,
            "FadeValue3": 0.10000000149011612
        },
        {
            "Id": 1010422024,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "哈啊……哈啊……。/n是不是……冲得太猛了……",
            "VoiceFileName": "10104220200",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422025,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "（不知道为什么，舒服到脑子都快没法想别的了。/n　身体自己在动，喉咙跟着舞台震动，然后声音就自然出来——）",
            "VoiceFileName": "10104220210",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422026,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "（我现在，是最兴奋的时候。/n　甚至觉得自己还能继续发光。）",
            "VoiceFileName": "10104220220",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422027,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "接下来是潘达的高光场面。/n爱潘妮在马吕斯怀里断气的那一幕。",
            "VoiceFileName": "10104220230",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422028,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "潘达她……/n啊……。",
            "BgmFileName": "999",
            "VoiceFileName": "10104220240",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1010422029,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "『请答应我……！』",
            "BgmFileName": "105",
            "VoiceFileName": "10104220250",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422030,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『好、好，我答应』",
            "VoiceFileName": "10104220260",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1010422031,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "『如果我死了，请答应在我的额头上/n　亲一下……』",
            "VoiceFileName": "10104220270",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422032,
            "EpisodeMasterId": 1010422,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "潘达",
            "FontSize": 2,
            "Phrase": "『我一定能够感觉得到……』",
            "VoiceFileName": "10104220280",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1010422033,
