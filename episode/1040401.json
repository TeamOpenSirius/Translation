      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "剧团成员C·D",
      "FontSize": 2,
      "Phrase": "“那我要影音室！　大家一起办应援上映会！！”/n“不是吧，当然先要摄影会用的Studio！　还能办COS聚会！”",
      "VoiceFileName": "10404010260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
