      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "“会场就是这里东京，将在上野新建的Astrolabe Hall！”",
      "VoiceFileName": "10404010090",
      "CharacterMotions": [],
      "SpeakerIconId": "522"
    },
