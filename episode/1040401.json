          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040401018,
      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "电姬剧团成员们",
      "FontSize": 2,
      "Phrase": "“也是哦～”“我们电姬跟那个世界没关系吧～”/n“感觉他们只会喜欢那种古典正统戏剧的舞台。”",
      "VoiceFileName": "10404010170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040401019,
      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "唔～，确实有可能……。/n可是可是，我们最近不是也挺受关注的吗！",
