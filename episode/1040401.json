      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "那个时期就叫“Horoscope Season”。听说在这段时间里接受评审，/n更容易被选为Dai Star，可以说是Dai Star强化期间！",
      "VoiceFileName": "10404010220",
