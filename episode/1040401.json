      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "剧团成员A·B",
      "FontSize": 2,
      "Phrase": "“那样的话，不就能赚很多钱了？”/n“真的假的！？　终于能摆脱贫穷剧团了！？”",
      "VoiceFileName": "10404010250",
      "CharacterMotions": [],
