    {
      "Id": 1040401015,
      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "哎呀～，这个你放心，肯定不会来。/n世界演剧联盟那种地方，不就是一群古板家伙的集合吗？",
      "VoiceFileName": "10404010140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 1,
          "SpineId": 40503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040401016,
      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "我们主要演2.5次元，本来就不是那群人的喜好，/n剧团规模也没大到哪里去。",
      "VoiceFileName": "10404010150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040401017,
      "EpisodeMasterId": 1040401,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "从一开始就不在候选范围吧。不可能来的。/n再说这世上的剧团多得要命。",
      "VoiceFileName": "10404010160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "BodyMotionMasterId": 24,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
