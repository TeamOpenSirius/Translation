      "SpeakerIconId": "103"
    },
    {
      "Id": 1030214059,
      "EpisodeMasterId": 1030214,
      "Order": 1,
      "GroupOrder": 55,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "看看那边那盏路灯。/n你觉得那盏路灯下面有什么？",
