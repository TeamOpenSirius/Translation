      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "银河座上层B",
      "FontSize": 2,
      "Phrase": "到目前为止，《圣克卢》也好、《桥弁庆》也好，我们认可你作为演员取得的成绩。",
      "VoiceFileName": "20066020190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
