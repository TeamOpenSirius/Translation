      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "……！/n我……。",
      "VoiceFileName": "20066020370",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
