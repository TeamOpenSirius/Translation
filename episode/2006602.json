      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "（这是以停止自己过去一直在做的事——倾听大家的烦恼……/n　以放弃这些作为交换条件的）",
      "VoiceFileName": "20066020250",
