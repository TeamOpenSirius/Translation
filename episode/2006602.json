      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "你想做的事，/n真的是即使赌上自己在银河座的位置也必须去做的吗？",
      "VoiceFileName": "20066020360",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
