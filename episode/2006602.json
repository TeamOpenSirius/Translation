      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "（连这样的人物都出席了讨论我去留的会议吗……）",
      "VoiceFileName": "20066020340",
      "CharacterMotions": [
        {
          "slotNumber": 1,
