      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "银河座上层B",
      "FontSize": 2,
      "Phrase": "正因如此，下一场公演的剧目《圆桌骑士物语》，/n我们会让你出演主角“亚瑟王”。",
      "VoiceFileName": "20066020200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
