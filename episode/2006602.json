      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "（我拿到主演了……。/n　单纯来说当然值得高兴。可是……）",
