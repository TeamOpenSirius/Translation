      "EpisodeMasterId": 2006602,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "银河座上层A",
      "FontSize": 2,
      "Phrase": "改变你的处世方式，否则你就得离开这个剧团。",
      "VoiceFileName": "20066020170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
