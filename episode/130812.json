      "EpisodeMasterId": 130812,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "自由不是任何人强加给你的。/n只需要顺其自然，成为自己想成为的样子。",
      "VoiceFileName": "1308120190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 106,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
