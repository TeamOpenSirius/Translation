      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "我觉得主办方和那个人期待的，就是我的自由。/n既然他们要求我做自己，那我就该按照自己的想法来。",
      "VoiceFileName": "1308120250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
