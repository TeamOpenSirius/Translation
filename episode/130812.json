      "EpisodeMasterId": 130812,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "啊！确实！/n既然是被要求“自由一点”，那就已经不自由了！",
