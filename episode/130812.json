        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 130812021,
      "EpisodeMasterId": 130812,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "所以，“请自由地写寄语”这个请求本身，/n反而让我觉得它夺走了自由。",
      "VoiceFileName": "1308120200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 104,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
