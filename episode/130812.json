      "EpisodeMasterId": 130812,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "……我能理解那个人所追求的美，/n但就像那个人有自己的坚持一样，我也有我的坚持。",
      "VoiceFileName": "1308120120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 106,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
