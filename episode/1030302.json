    {
      "Id": 1030302025,
      "EpisodeMasterId": 1030302,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "节目主持人",
      "FontSize": 2,
      "Phrase": "——连丹波的首席导演都说「令人不由得绷紧神经」。/n看来演剧相关人士都承受着相当大的压力。",
      "VoiceFileName": "10303020200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030302026,
      "EpisodeMasterId": 1030302,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "节目评论员",
      "FontSize": 2,
      "Phrase": "毕竟指南方也肩负着维护权威的责任。/n他们自身的审美眼光同样会受到检验。",
      "VoiceFileName": "10303020210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030302027,
      "EpisodeMasterId": 1030302,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "节目主持人",
      "FontSize": 2,
      "Phrase": "也就是说，被选的一方必须拿出与之相称的革新。/n先插播一段广告，稍后继续深入讨论——",
      "VoiceFileName": "10303020220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030302028,
      "EpisodeMasterId": 1030302,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "被选的一方也必须拿出相应的革新。/n那就是说，银河座也……？",
      "VoiceFileName": "10303020230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 30501,
