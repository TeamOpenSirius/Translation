      "Phrase": "……。",
      "VoiceFileName": "20029010360",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 3,
          "SpineId": 20103,
