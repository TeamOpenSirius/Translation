    {
      "Id": 2002901043,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 42,
      "SpeakerName": "泰特拉",
      "FontSize": 2,
      "Phrase": "她的演技越来越好了……进步快得甚至有些吓人。/n大概是因为吸收得很快吧。",
      "VoiceFileName": "20029010370",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
