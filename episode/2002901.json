    {
      "Id": 2002901002,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "曾经，我憧憬着那颗璀璨的星。",
      "BackgroundImageFileName": "1131",
      "BackgroundImageFileFadeType": 4,
      "VoiceFileName": "20029010010",
      "CharacterMotions": [],
      "SpeakerIconId": "204",
      "FadeValue1": 0.30000001192092896,
      "FadeValue3": 0.30000001192092896
    },
    {
      "Id": 2002901003,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "那是一个仿佛能将人灼烧殆尽的舞台世界。/n触碰到Dai Star这一存在散发出的热度后……我也渴望成为那样的人。",
      "VoiceFileName": "20029010020",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901004,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "所以，我也选择成为一名演员——/n……而我。",
      "VoiceFileName": "20029010030",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901005,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 5,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "473",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.6000000238418579,
      "FadeValue2": 0.0,
      "FadeValue3": 0.6000000238418579
    },
    {
      "Id": 2002901006,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "……呼——……。",
      "VoiceFileName": "20029010040",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901007,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "没事……没事的……。",
      "VoiceFileName": "20029010050",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901008,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "我……能做到。",
      "VoiceFileName": "20029010060",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901009,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "容，差不多该开始彩排了。/n做好准备。",
      "VoiceFileName": "20029010070",
      "CharacterMotions": [],
      "SpeakerIconId": "201"
    },
    {
      "Id": 2002901010,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "啊……嗯。",
      "VoiceFileName": "20029010080",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901011,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 11,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "141",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "999",
      "CharacterMotions": [],
      "FadeValue1": 0.30000001192092896,
      "FadeValue2": -1.0,
      "FadeValue3": 0.30000001192092896
    },
    {
      "Id": 2002901012,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "Eden将要挑战的新舞台剧——《莎乐美》。",
      "VoiceFileName": "20029010090",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901013,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "这是一出聚焦于莎乐美公主疯狂的爱，以及高洁的先知约卡南的，/n华丽而又颓靡的戏剧。",
      "VoiceFileName": "20029010100",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901014,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "饰演主演莎乐美的是万容。平日里一直甘当配角的演员，/n这次却担任主演，因此骤然引起了人们的关注。",
      "VoiceFileName": "20029010110",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901015,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "准主演约卡南一角，则选中了凭借天生的率真、展现出融入角色才能的，/n新人舍人仁花子。",
      "VoiceFileName": "20029010120",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901016,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "以一名绿叶演员和新人担纲主角的唯美主义戏剧，/n或许正可谓是一部挑战之作。",
      "BackgroundImageFileName": "1050",
      "BackgroundImageFileFadeType": 4,
      "VoiceFileName": "20029010130",
      "CharacterMotions": [],
      "SpeakerIconId": "204",
      "FadeValue1": 0.30000001192092896,
      "FadeValue3": 0.30000001192092896
    },
    {
      "Id": 2002901017,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "——此时，距离正式演出已经近在眼前。",
      "VoiceFileName": "20029010140",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901018,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 18,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "150",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "999",
      "CharacterMotions": [],
      "FadeValue1": 0.6000000238418579,
      "FadeValue2": 0.0,
      "FadeValue3": 0.6000000238418579
    },
    {
      "Id": 2002901019,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "『今夜的月光，宛如磨亮的银剑一般清冽耀眼。",
      "BgmFileName": "28",
      "VoiceFileName": "20029010150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 20403,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901020,
      "EpisodeMasterId": 2002901,
      "Order": 2,
      "GroupOrder": 19,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "　……多么美丽。那是未染尘埃、纯洁无瑕的光芒』",
      "VoiceFileName": "20029010151",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901021,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "『我已经受够了。/n　我不想再待在那种地方』",
      "VoiceFileName": "20029010160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 3,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901022,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "『希律王为什么要用那种眼神看我呢？/n　仿佛有蛇爬遍全身的那种感觉……真让人恶心……』",
      "VoiceFileName": "20029010170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901023,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "『啊啊……。只要看着月亮，心就会渐渐平静下来。/n　要是这淡淡的月光，也能把这份令人厌恶至极的心情一并洗去就好了』",
      "VoiceFileName": "20029010180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901024,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "（莎乐美公主，是个正值爱跳舞年纪的少女。/n　她惹人怜爱的姿态，以及一次次展现的优美舞姿，令城堡里的卫兵们为之倾倒）",
      "VoiceFileName": "20029010190",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901025,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "『……』",
      "VoiceFileName": "20029010200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 17,
          "SpineId": 20503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 2002901026,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "剧团成员",
      "FontSize": 2,
      "Phrase": "『快看，莎乐美公主今晚也在起舞。/n　真美啊』",
      "VoiceFileName": "20029010210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2002901027,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "『不过她今天似乎有些忧郁。/n　也许是因为站在月光下，才显得如此吧』",
      "VoiceFileName": "20029010220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 20503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 2002901028,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "剧团成员",
      "FontSize": 2,
      "Phrase": "『真可怜。先王去世没多久，希罗底王后便再婚了。/n　而对方偏偏还是希律王』",
      "VoiceFileName": "20029010230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2002901029,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "剧团成员",
      "FontSize": 2,
      "Phrase": "『杀害父王、令人憎恨的叔父，如今却成了自己的继父，/n　她承受的煎熬想必也非同一般吧』",
      "VoiceFileName": "20029010240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2002901030,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "『嘘。这种事可不能说得太大声』",
      "VoiceFileName": "20029010250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 20503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 2002901031,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "（腐败的王室、堕落的母亲、向自己投来淫欲目光的继父。/n　莎乐美想逃离围绕在自己身边的一切，把它们全都忘掉）",
      "VoiceFileName": "20029010260",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901032,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "（逃出城堡，独自沉浸在自己最喜欢的舞蹈之中。/n　那是她唯一的消遣）",
      "VoiceFileName": "20029010270",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901033,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "（……就在那时，她遇见了他）",
      "VoiceFileName": "20029010280",
      "CharacterMotions": [],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901034,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "仁花子",
      "FontSize": 2,
      "Phrase": "『——啊啊，怎么会有这种事。/n　不可饶恕。不可饶恕……！』",
      "VoiceFileName": "20029010290",
      "CharacterMotions": [],
      "SpeakerIconId": "203"
    },
    {
      "Id": 2002901035,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "『这个声音究竟是……？　是谁？』",
      "VoiceFileName": "20029010300",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 20403,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901036,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "仁花子",
      "FontSize": 2,
      "Phrase": "『那个任凭欲望支配、让盛罪之杯满溢的男人在哪里？/n　那个抛弃丈夫，竟又嫁给他弟弟的愚蠢女人，又去了哪里？』",
      "VoiceFileName": "20029010310",
      "CharacterMotions": [],
      "SpeakerIconId": "203"
    },
    {
      "Id": 2002901037,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "『这是……』",
      "VoiceFileName": "20029010320",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 20403,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901038,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "『不可以，公主殿下。不能听那个人说的话』",
      "VoiceFileName": "20029010330",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 300,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 4,
          "SpineId": 20503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "205"
    },
    {
      "Id": 2002901039,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "『卫兵先生，他到底是在对谁发怒？/n　他说的是继父大人和母亲大人……？』",
      "VoiceFileName": "20029010340",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 20403,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 2002901040,
      "EpisodeMasterId": 2002901,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "仁花子",
      "FontSize": 2,
      "Phrase": "『多么可憎的王室。忏悔吧。/n　你们理应为自己的罪接受审判！』",
      "BackgroundCharacterImageFileName": "140770_0",
      "VoiceFileName": "20029010350",
      "CharacterMotions": [],
      "SpeakerIconId": "203"
    },
