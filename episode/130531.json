      "EpisodeMasterId": 130531,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "潘达",
      "FontSize": 2,
      "Phrase": "非、非常感谢您来电，千寿小姐！/n我还差得远，但真的真的真的特别感谢！",
      "VoiceFileName": "1305310300",
      "CharacterMotions": [
