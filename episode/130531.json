      "EpisodeMasterId": 130531,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "那个……看来给您添麻烦了。/n我也在反省，自己是不是稍微有些轻率……。",
      "VoiceFileName": "1305310310",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
