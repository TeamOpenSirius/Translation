            "Order": 3
        },
        {
            "Id": 34023504,
            "EpisodeType": 5,
            "CharacterId": 101,
            "SpeakerName": "",
            "Description": "因为这是演员“静香”诞生的日子嘛！/n对我来说也是特别的一天！",
            "Order": 4
        },
        {
            "Id": 34023505,
            "EpisodeType": 5,
            "CharacterId": 102,
            "SpeakerName": "",
            "Description": "心菜……。",
