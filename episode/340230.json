            "CharacterId": null,
            "SpeakerName": "",
            "Description": "【Birthday Night】静香/n静香/n/n好胜而自信，同时拥有冷静的分析能力。/n是个拥有心菜所不具备之物的少女。/n总是担心容易气馁的心菜，/n一直鼓励她，并给予准确的建议。/n比任何人都相信心菜。/n/n年级：高中二年级/n生日：7月26日/n身高：158cm/n兴趣：观察人类",
            "Order": 1
        },
        {
            "Id": 34023502,
            "EpisodeType": 5,
            "CharacterId": 101,
            "SpeakerName": "",
            "Description": "生日快乐，静香酱！",
            "Order": 2
        },
        {
            "Id": 34023503,
            "EpisodeType": 5,
            "CharacterId": 102,
            "SpeakerName": "",
