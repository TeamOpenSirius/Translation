      "EpisodeMasterId": 2000804,
      "Order": 1,
      "GroupOrder": 42,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我自己当然也每天练习啦！",
      "VoiceFileName": "20008040390",
      "CharacterMotions": [
