      "EpisodeMasterId": 2000804,
      "Order": 2,
      "GroupOrder": 42,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "但王雪可是特地从很远的国家过来，在“那个”银河座里发光。",
      "VoiceFileName": "20008040391",
      "CharacterMotions": [
