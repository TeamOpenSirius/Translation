            "SpeakerIconId": "301"
        },
        {
            "Id": 141591016,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（……我并不讨厌。因为我知道了，原来赏樱还有这样的方式，/n也知道了还有不必顾虑任何人的赏花会）",
            "VoiceFileName": "1415910140",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "BodyMotionMasterId": 14,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591017,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（和团员们一起赏樱……。/n这在过去的银河座里，是绝不可能发生的事……）",
            "VoiceFileName": "1415910150",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "BodyMotionMasterId": 13,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591018,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "……银河座，已经开始改变了呢。",
            "VoiceFileName": "1415910160",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591019,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（虽然只是极少一部分，但团员们的意识正在改变。/n过去那种只允许专注于戏剧的严苛方针，也开始有所缓和）",
            "VoiceFileName": "1415910170",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 70,
                    "BodyMotionMasterId": 13,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591020,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（我能理解运营方的意图。/n无论传统还是革新，若不能吸引观众就没有意义）",
            "VoiceFileName": "1415910180",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 7,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591021,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "比想象中还要沉重呢。/n圣克鲁指南这块招牌……。",
            "VoiceFileName": "1415910190",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 73,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591022,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（银河座因为兼顾了传统与革新而获得评价。/n也就是说，从今以后我们仍会被要求维持这份危险的平衡）",
            "VoiceFileName": "1415910200",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 6,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591023,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（我想守住银河座的传统。/n也想守住世人的评价）",
            "VoiceFileName": "1415910210",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "BodyMotionMasterId": 13,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591024,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（过去，只要守住传统，自然就能得到认可。/n可如今世人已经不满足于只有传统了）",
            "VoiceFileName": "1415910220",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591025,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（银河座……还有我，到底该怎么做才好。/n既守住传统，又能守住世人评价的方法究竟……）",
            "VoiceFileName": "1415910230",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "BodyMotionMasterId": 11,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591026,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "…………。",
            "VoiceFileName": "1415910240",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 13,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591027,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "……不。明明作为演员还远远不够成熟，/n却想对运营与世间评头论足，实在是荒唐至极。",
            "VoiceFileName": "1415910250",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "HeadMotionMasterId": 2,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591028,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "我只需做自己该做的事。即使这块招牌再沉重，我也会守到底。/n毕竟我已经这样约定过了。",
            "VoiceFileName": "1415910260",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 14,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591029,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "而且每当我这么说，您总会回答那句话呢。/n“即使无法替千寿历分担重担，我也可以陪在你身边。”",
            "VoiceFileName": "1415910270",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 400,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591030,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "……亏您说得出口。/n明明也可以说，正因为您，这块招牌才变得更沉了……。",
            "VoiceFileName": "1415910280",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 73,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591031,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（不过，沉重的招牌未必就是坏事。/n因为世人的目光，已经开始投向我以外的其他人）",
            "VoiceFileName": "1415910290",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 6,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591032,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（拉莫娜小姐带来的变化，改变了大家的意识。/n而且正切实地在整个银河座扎根）",
            "VoiceFileName": "1415910300",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 70,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 13,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
