                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591002,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "那么就由我来成为你的双眼。成为照亮你的光！/n来，好好看着吧。这就是你深爱过的世界！",
            "VoiceFileName": "1415910020",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "LipSyncMasterId": 3,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591003,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "到这里是舍瓦利耶——拉莫娜小姐的戏份。/n在这里推开窗户，转换场景。",
            "VoiceFileName": "1415910030",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591004,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "打开窗户后，舍瓦利耶让公主看见外面的景色。/n聚集在下方的民众，为她的归来发出欢呼……",
            "VoiceFileName": "1415910040",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591005,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "咦？排练室的窗户为什么开着……。",
            "VoiceFileName": "1415910050",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591006,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "……啊，是被戏里的动作带着一起打开了吧。/n看来是太过专注，连视野都变窄了。",
            "VoiceFileName": "1415910060",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591007,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "呼……。/n……我竟然不知道，从排练室的窗户还能看见庭院。",
            "VoiceFileName": "1415910070",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "BodyMotionMasterId": 6,
                    "LipSyncMasterId": 1,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591008,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "前些日子，夜樱还被灯光照得明亮，/n现在却只剩灯笼朦胧的微光……。",
            "VoiceFileName": "1415910080",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 70,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591009,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（樱花散尽后，我才终于能安心下来。/n这或许也算是生于千寿家之人的宿命吧）",
            "VoiceFileName": "1415910090",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "BodyMotionMasterId": 15,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591010,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（对我而言，赏樱只是让人紧绷神经的活动。/n盛放的樱花，只会让我想起自己在这个家必须履行的职责）",
            "VoiceFileName": "1415910100",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "BodyMotionMasterId": 13,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 141591011,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "（以赏樱为由邀请贵客，再由千寿家的人负责款待。/n这样的习俗之下，我怎么可能有余裕去享受赏樱……）",
            "VoiceFileName": "1415910110",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 400,
                    "BodyMotionMasterId": 6,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
