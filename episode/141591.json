        {
            "Id": 141591015,
            "EpisodeMasterId": 141591,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "千寿历",
            "FontSize": 2,
            "Phrase": "真没想到，有一天我也能单纯因为樱花美丽而感到开心。",
            "VoiceFileName": "1415910130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 73,
                    "BodyMotionMasterId": 25,
                    "LipSyncMasterId": 4,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
