      "EpisodeMasterId": 1040407,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "嗯～……就是，我在想，会说话的稻草人到底是什么感觉……。",
      "VoiceFileName": "10404070050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
