      "EpisodeMasterId": 1040407,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "卡米拉的朋友B",
      "FontSize": 2,
      "Phrase": "抱歉，这个真不行。也太难了……。/n话说我们又没见过会说话的稻草人。真有那种东西？",
      "VoiceFileName": "10404070070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
