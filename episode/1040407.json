    {
      "Id": 1040407006,
      "EpisodeMasterId": 1040407,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "卡米拉的朋友A",
      "FontSize": 2,
      "Phrase": "哈？稻草人？……稻草人会说话？",
      "VoiceFileName": "10404070060",
      "CharacterMotions": [],
