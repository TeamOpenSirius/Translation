                {
                    "slotNumber": 2,
                    "SpineId": 30521,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
            "Id": 142181032,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "就是那个……之前我们参加了工作坊，/n可完全没有受到任何责罚，所以才觉得奇怪，没法安心……。",
            "VoiceFileName": "1421810320",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181033,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 33,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "不过既然莫娜能留下来，可能也是我们白担心了啦～。",
            "VoiceFileName": "1421810330",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181034,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 34,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "对对！拉莫能继续留在银河座真的太好了！/n我之前一直担心，要是拉莫离开该怎么办……。",
            "VoiceFileName": "1421810340",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 200,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 2,
                    "SpineId": 30521,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "305"
        },
        {
            "Id": 142181035,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 35,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "知道拉莫娜姐能留下来，我真的放心了！/n以后也请多多关照！",
            "VoiceFileName": "1421810350",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181036,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 36,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "嗯，谢谢……关于你们参加工作坊这件事，/n总之已经不用担心了。害你们白白担心，抱歉。",
            "VoiceFileName": "1421810360",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 30201,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
            "Id": 142181037,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 37,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "不，那个没什么……！",
            "VoiceFileName": "1421810370",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181038,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 38,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "只是我们自己擅自在担心，怎么说呢……。/n总之这不是莫娜需要在意的事啦！",
            "VoiceFileName": "1421810380",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181039,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 39,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "这样啊……一次又一次让你们费心了，谢谢。/n另外，关于工作坊，还有一个好消息。",
            "VoiceFileName": "1421810390",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 1,
                    "SpineId": 30201,
