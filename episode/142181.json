            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "其实啊，刚才她们两个一直坐立不安的，/n我有点在意就来搭话了！想问问怎么啦～！",
            "VoiceFileName": "1421810300",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 30201,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
