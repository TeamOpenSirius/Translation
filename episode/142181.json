        },
        {
            "Id": 142181007,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "克莱尔、阿比盖尔",
            "FontSize": 2,
            "Phrase": "哇……！",
            "VoiceFileName": "1421810070",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181008,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "绯、绯花里前辈……！？",
            "VoiceFileName": "1421810080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181009,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "哇，抱歉！/n我不是故意要吓你的……。",
            "VoiceFileName": "1421810090",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 511,
                    "BodyMotionMasterId": 12,
                    "LipSyncMasterId": 3,
                    "SpineId": 30521,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "305"
        },
        {
            "Id": 142181010,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "只是感觉你们有点坐立不安？或者说一直东张西望？/n我就想，是不是遇到什么麻烦了……。",
            "VoiceFileName": "1421810100",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "BodyMotionMasterId": 6,
                    "LipSyncMasterId": 4,
                    "SpineId": 30521,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "305"
        },
        {
            "Id": 142181011,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "啊，不，也算不上什么麻烦……。/n对吧，克莱尔？",
            "VoiceFileName": "1421810110",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181012,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "是……只是……。",
            "VoiceFileName": "1421810120",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181013,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "《圆桌骑士物语》公演前……/n我们明明参加了拉莫娜姐的工作坊——",
            "VoiceFileName": "1421810130",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181014,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "老师们却完全没有责罚我们。/n我们和拉莫娜姐聊过之后，都已经做好觉悟了……。",
            "VoiceFileName": "1421810140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181015,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "所以就觉得，有点拍子落空吧……。/n当然啦，我们也不是盼着被处罚。",
            "VoiceFileName": "1421810150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181016,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "可什么都不发生反而让人害怕，或者说很奇怪……。/n总觉得静不下心来。",
            "VoiceFileName": "1421810160",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181017,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "毕竟我们当时都觉得，就算被开除也不奇怪嘛～。/n哎呀～，没有被开掉是真的太好了。",
            "VoiceFileName": "1421810170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181018,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "嗯～，原来如此……是这么回事啊～……。/n不过，直到今天见到老师们也什么都没说，对吧？",
            "VoiceFileName": "1421810180",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 4,
                    "SpineId": 30521,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "305"
        },
        {
            "Id": 142181019,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "是……。",
            "VoiceFileName": "1421810190",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181020,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "那肯定没问题啦！/n真有什么事的话一定会有人说的！对吧？",
            "VoiceFileName": "1421810200",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 2,
                    "SpineId": 30521,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "305"
        },
        {
            "Id": 142181021,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "嗯，确实……。",
            "VoiceFileName": "1421810210",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181022,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "对吧！那就不用担心！/n我觉得你们大可以堂堂正正的！难得现在还是早餐时间！",
            "VoiceFileName": "1421810220",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 200,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 2,
                    "SpineId": 30521,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "305"
        },
        {
            "Id": 142181023,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "呵呵，说得也是……可能是我们想太多了。/n谢谢你，绯花里前辈。",
            "VoiceFileName": "1421810230",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181024,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "哈啊～，刚才还那么不安，现在心情已经完全放晴了。/n真不愧是绯花里前辈！",
            "VoiceFileName": "1421810240",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181025,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "克莱尔",
            "FontSize": 2,
            "Phrase": "真的真的！/n像这样一下就能让别人打起精神，真的很有绯花里前辈的风格。",
            "VoiceFileName": "1421810250",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181026,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "阿比盖尔",
            "FontSize": 2,
            "Phrase": "因为只要绯花里前辈说“没问题”，/n就会让人觉得真的没问题了嘛～。",
            "VoiceFileName": "1421810260",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142181027,
            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "绯花里",
            "FontSize": 2,
            "Phrase": "是、是吗？被你们这样说，突然有点不好意思……。/n不过你们看起来恢复精神了就好！",
            "VoiceFileName": "1421810270",
            "CharacterMotions": [
