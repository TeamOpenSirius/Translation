            "EpisodeMasterId": 142181,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "原来如此……。/n那她们两个为什么会坐立不安？",
            "VoiceFileName": "1421810310",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 4,
