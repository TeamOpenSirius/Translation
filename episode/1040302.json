      "EpisodeMasterId": 1040302,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "根津真知子",
      "FontSize": 2,
      "Phrase": "我来说明。对方选择剧团电姬，大致有两个理由。/n第一，是因为我们一直在加强海外配信。",
      "VoiceFileName": "10403020290",
      "CharacterMotions": [
