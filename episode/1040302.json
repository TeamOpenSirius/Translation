    },
    {
      "Id": 1040302032,
      "EpisodeMasterId": 1040302,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "根津真知子",
      "FontSize": 2,
      "Phrase": "剧团电姬舞台在海外究竟能走多远还是未知数。但我判断它拥有跨越语言与文化壁垒的力量，/n所以一直持续投资配信业务。这件事你们应该知道吧？",
      "VoiceFileName": "10403020300",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
