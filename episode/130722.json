      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……我明白了。/n那我就恭敬不如从命了。",
      "VoiceFileName": "1307220260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
