          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 130722007,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（至于算不算“顺利”，就很难说了……）",
      "VoiceFileName": "1307220060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 72,
          "BodyMotionMasterId": 25,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 130722008,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "这样啊！那太好了。/n那你现在呢？正在做什么吗？",
      "VoiceFileName": "1307220070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722009,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "嗯。/n为了当天不出问题，我正在做时间表和话题清单……。",
      "VoiceFileName": "1307220080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 130722010,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "您刚才说，时间表和话题清单！？/n千寿历小姐，哔哔——！哔哔哔——！不行！",
      "VoiceFileName": "1307220090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722011,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "那、那是什么汽车一样的声音……。",
      "VoiceFileName": "1307220100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 130722012,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "千寿历小姐！这可不是带修学旅行的学生！/n私人旅行连遇到小麻烦都是娱乐的一部分！",
      "VoiceFileName": "1307220110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722013,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "因为一点小事一起笑，一起留下回忆！/n不用那么紧绷，先享受姐妹两个人独处的时光不就好了吗。",
      "VoiceFileName": "1307220120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722014,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "就、就算你这么说……。/n我们私下里连旅行都很少一起去……。",
      "VoiceFileName": "1307220130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 130722015,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "唉……。看来我担心你，特地打这通电话是对的。",
      "VoiceFileName": "1307220140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722016,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "你这话的意思是……？",
      "VoiceFileName": "1307220150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 130722017,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "和大家分别之后，我也跟露比商量过。/n想看看有没有什么能帮到你们旅行的地方。",
      "VoiceFileName": "1307220160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722018,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "当然，我们不是想打扰你们姐妹。/n如果不介意，要不要到了沼津后和我们会合，一起观光？",
      "VoiceFileName": "1307220170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722019,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "不、不用了！/n还让你们特地做到这种程度，实在太麻烦你们了……。",
      "VoiceFileName": "1307220180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 500,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 130722020,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "都走到这一步了，我当然要管到底。/n难得有人来到我们的城市，我只是想尽地主之谊。",
      "VoiceFileName": "1307220190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "904"
    },
    {
      "Id": 130722021,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "可是，不光是黛雅小姐，还要麻烦露比小姐——",
      "VoiceFileName": "1307220200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 72,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
