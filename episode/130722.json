    {
      "Id": 130722005,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "啊，不是。只是有点在意，你有没有顺利提出旅行的事……。",
      "VoiceFileName": "1307220040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
