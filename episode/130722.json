      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "嗯。这么晚打扰你了，我也很期待。/n谢谢你愿意陪我商量。那么，到时见。",
      "VoiceFileName": "1307220280",
      "CharacterMotions": [
