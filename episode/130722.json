      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "当然。/n当天我很期待。",
      "VoiceFileName": "1307220270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
