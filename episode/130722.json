      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "露比",
      "FontSize": 2,
      "Phrase": "欸！说不定能见到伊吕波亲吗……？/n我好想见见千寿历小姐的妹妹……。",
      "VoiceFileName": "1307220230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "909"
    },
    {
      "Id": 130722025,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "她是这么说的哦，千寿历小姐。",
      "VoiceFileName": "1307220240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
