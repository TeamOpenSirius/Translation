      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "露比",
      "FontSize": 2,
      "Phrase": "姐姐，是在和千寿历小姐打电话吗？",
      "VoiceFileName": "1307220210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "909"
    },
    {
      "Id": 130722023,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "黛雅",
      "FontSize": 2,
      "Phrase": "嗯。我正在问她，要不要到了沼津后一起观光。",
      "VoiceFileName": "1307220220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
