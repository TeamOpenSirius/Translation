      "SpeakerIconId": "904"
    },
    {
      "Id": 130722006,
      "EpisodeMasterId": 130722,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "原来是这样。/n不过，我刚才已经顺利邀请她了，请不用担心。",
      "VoiceFileName": "1307220050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
