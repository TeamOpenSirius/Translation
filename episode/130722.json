      "EpisodeMasterId": 130722,
      "Order": 2,
      "GroupOrder": 3,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "还特地打电话过来，是有什么事吗？",
      "VoiceFileName": "1307220031",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
