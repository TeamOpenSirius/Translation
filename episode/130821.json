      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 53,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "『是、是的。叶羽亲很喜欢职业摔角吧？/n所以想说你会不会感兴趣～……』",
      "VoiceFileName": "1308210420",
      "CharacterMotions": [],
