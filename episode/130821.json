      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 50,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "『那、那个……！/n能不能看看这个URL……？』",
      "VoiceFileName": "1308210390",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 130821051,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 51,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "……什么啊……特摄秀……？…………嗯？/n……欸？哈啊！？这不是本人真身吗！？",
      "VoiceFileName": "1308210400",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 3,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
