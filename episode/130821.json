    },
    {
      "Id": 130821017,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "——垃圾游戏！",
      "VoiceFileName": "1308210110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 304,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 3,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821018,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "对 Killer 也太不利了吧！瞄准判定还松成那样！/n还有那帮家伙！居然认真研究这种游戏的攻略，闲人吗～！",
      "VoiceFileName": "1308210120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 300,
          "BodyMotionMasterId": 8,
          "LipSyncMasterId": 3,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821019,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "唉——，今天真不走运。不玩了不玩了，到此为止——。/n早知道去打格斗游戏了……哈，汽水真好喝……。",
      "VoiceFileName": "1308210130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821020,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 20,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "40",
      "CharacterMotions": []
    },
    {
      "Id": 130821021,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『话说，最近是不是该搞个什么庆典了？』『赏花！』『在那之前！』/n『啊——今年女儿节也没办呢』『日程全乱套啦——』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210140",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821022,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "话说这边群聊还没结束吗？/n真亏他们不腻啊～。差不多都去睡觉啦。",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821023,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『我和美兔亲有庆祝缝纫机之日哦』『缝纫机之日！？』/n『感谢它让我们能Cosplay嘛』『好厉害，还做了祭坛！！』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210160",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821024,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "感谢缝纫机……？欸，缝纫机祭坛！？/n哇，还真装饰起来了……宅宅的行动力也太强……。",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 3,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821025,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『正常想的话就是春分？』『好，书包之日让人穿小学生Cos服吧』/n『让谁穿？』『老大＆要组合』『想看～』『扣工资』『要小姐也在！？』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210180",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821026,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『话说白色情人节不就行了？』『只是普通过就有辱电姬团员之名』/n『趁心理健康促进周来一场血腥动画接力吧』『哪里健康了！』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821027,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "唉～。又为了无聊的事磨磨蹭蹭。/n现在可是讲究时间性价比的时代，一群大人到底在干嘛啊。",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 106,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821028,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "『你们不就是想聚在一起闹腾吗？/n有必要非找个理由？』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210210",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821029,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『唉～，真是的』『所以说小孩子就是……』『大人呢，是会寂寞的』/n『没有个理由就聚不起来，也没法一起闹啊——！』",
      "VoiceFileName": "1308210220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821030,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『就是这个。那就加上理由和规则吧』『理由是？』『比如，最尽情享受春天』/n『哦』『规则呢？』『拍下享受春天的照片发到这里』『OK。懂了』",
      "VoiceFileName": "1308210230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821031,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『享受春天……好像很有意思！』『感觉能想出好多玩法呢』/n『反而很难决定要拍啥～！』『享受生活可是电姬团员必备技能』",
      "VoiceFileName": "1308210240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821032,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "呼——，总算定下来了？反正我只会在高处看戏。",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821033,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『叶羽也参加哦』『凭什么！？』『这事因你一句话爆炸的，别想跑』/n『没关系啦，会很好玩的！』『好期待叶羽亲的照片』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821034,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "啊——……这下是逃不掉了。",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 76,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821035,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『那么，最有春天气息大赛开幕～！』『咚咚锵锵！』/n『呜哦哦第一个是我的晚餐，春卷～』『别发吃了一半的！』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821036,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "春天，春天啊……春……啊。",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821037,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "日历上写着“春”，拿这个就行了吧。",
      "VoiceFileName": "1308210300",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 106,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
