      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 55,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "『顺带一提，只要以Cosplayer身份参加，/n就能比普通参加者优先拿到入场券哦。』",
