    },
    {
      "Id": 130821007,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『不过真没想到，那个不起眼角色居然进化成这季霸权角色了』/n『情人节活动还毫无水花，结果联动咖啡厅那套也太涩了吧！』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821008,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "有吧有吧，肯定有陷阱吧～。/n好，找到啦～！然后贴脸闪避，再超级冲刺！",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 8,
          "LipSyncMasterId": 2,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821009,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 9,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "40",
      "CharacterMotions": []
    },
    {
      "Id": 130821010,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『哇——，就是不掉——！到底要刷多少轮才会掉啊——！？』/n『杀死感情！刷本时别让自我萌芽！变成机器！』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821011,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "好，反击接处决，一杀到手～♪/n那边没来得及跑的也顺手收掉♪然后双杀之后～？",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 210,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 24,
          "LipSyncMasterId": 2,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 130821012,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 12,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "40",
      "CharacterMotions": []
    },
    {
      "Id": 130821013,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "群聊",
      "FontSize": 2,
      "Phrase": "『卡米拉亲——，我下次要去见男朋友，你觉得穿哪件好？』/n『春天了就这件！巨适合你！』『谢啦！好，就决定是你了！』",
      "BackgroundImageFileName": "1580",
      "VoiceFileName": "1308210080",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 130821014,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "好，三杀——等下，怎么全员都集合在这儿了！？/n那两个人装死！？什么时候满足技能条件的——呀啊！？",
      "BackgroundImageFileName": "961",
      "VoiceFileName": "1308210090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 507,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 3,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
