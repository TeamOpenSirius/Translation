    },
    {
      "Id": 130821054,
      "EpisodeMasterId": 130821,
      "Order": 1,
      "GroupOrder": 54,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "增冈退役后主要做演艺工作，能看到他真正打上一场的机会很少。/n能现场看更是珍贵得不能再珍贵……而且对手还是 Piyohiko……。",
      "VoiceFileName": "1308210430",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
