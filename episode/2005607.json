      "EpisodeMasterId": 2005607,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "煎蛋饼很薄，好入口，四季豆口感也不错。/n但这个红色酱汁似的东西，我吃不惯。",
      "VoiceFileName": "20056070270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 511,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
