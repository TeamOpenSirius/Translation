      "EpisodeMasterId": 2005607,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "都工作这么久了，居然还是没什么食欲。",
      "VoiceFileName": "20056070090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 13,
