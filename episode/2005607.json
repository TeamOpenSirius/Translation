      "EpisodeMasterId": 2005607,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "说到对身体温和的料理，就是炖鱼。/n为了让王雪暖起来，要放很多姜。",
      "VoiceFileName": "20056070200",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2005607023,
      "EpisodeMasterId": 2005607,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……嗯，好吃。",
