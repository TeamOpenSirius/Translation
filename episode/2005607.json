      "EpisodeMasterId": 2005607,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……这个不太合我口味。",
      "VoiceFileName": "20056070260",
      "CharacterMotions": [
