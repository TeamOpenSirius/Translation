      "EpisodeMasterId": 2005607,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "每样东西的形状和配色都不漂亮。/n和我平时吃的饭味道也完全不同。",
      "VoiceFileName": "20056070290",
      "CharacterMotions": [
