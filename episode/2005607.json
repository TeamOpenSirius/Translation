      "EpisodeMasterId": 2005607,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "更多依赖直觉……！/n汤岛也说过，“我的风格”才最重要！！",
      "VoiceFileName": "20056070250",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
