      "EpisodeMasterId": 2001808,
      "Order": 1,
      "GroupOrder": 41,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "时雨要在Eden成为Dai Star。/n我要走的路已经决定了。",
      "VoiceFileName": "20018080370",
      "CharacterMotions": [
        {
          "slotNumber": 1,
