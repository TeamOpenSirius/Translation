            "EpisodeMasterId": 1020212,
            "Order": 1,
            "GroupOrder": 35,
            "SpeakerName": "时雨的父亲",
            "FontSize": 2,
            "Phrase": "有自信是好事。但人生有限。/n这一点一定要牢牢记住。",
