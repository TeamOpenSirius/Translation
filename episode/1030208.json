      "EpisodeMasterId": 1030208,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "「如果你……如果柯贝内拉能够得救，/n　那就算让我被烈火烧上几百次也无所谓」",
      "VoiceFileName": "10302080080",
