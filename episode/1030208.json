          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030208010,
      "EpisodeMasterId": 1030208,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（乔班尼试图牺牲自己来救柯贝内拉。/n　他想把那张能去往任何地方……甚至回到地面的车票让给对方）",
      "VoiceFileName": "10302080090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030208011,
      "EpisodeMasterId": 1030208,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（可柯贝内拉没有收下车票。/n　正因为没有收下，乔班尼才得以回到地面）",
      "VoiceFileName": "10302080100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 76,
          "HeadMotionMasterId": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
