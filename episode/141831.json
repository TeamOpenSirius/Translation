            "EpisodeMasterId": 141831,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "其他人是指？",
            "VoiceFileName": "1418310290",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "401"
        },
        {
            "Id": 141831030,
            "EpisodeMasterId": 141831,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "美兔",
            "FontSize": 2,
            "Phrase": "'呃……你看，之前……你不是和潘达一起去买泳装……/n　说过这件事吗？'",
            "VoiceFileName": "1418310300",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "402"
        },
        {
            "Id": 141831031,
            "EpisodeMasterId": 141831,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "是。我和卡米拉一起去买泳装的时候，/n顺便邀请了正为直播发愁的潘达。",
            "VoiceFileName": "1418310310",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 2,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "401"
        },
