            "EpisodeMasterId": 141831,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "是啊。不管是作为季节风物、上镜效果，还是应用范围。/nCosplay 都有顶级的潜力。",
            "VoiceFileName": "1418310050",
            "CharacterMotions": [
