      "EpisodeMasterId": 2004801,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "明白了，那我们先走了。",
      "VoiceFileName": "20048010170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004801018,
      "EpisodeMasterId": 2004801,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "阿比盖尔",
