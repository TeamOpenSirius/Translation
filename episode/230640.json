{
    "EpisodeId": 230640,
    "StoryType": 5,
    "Title": "【Future Dai Star】Eden",
    "EpisodeDetail": [
        {
            "Id": 23064001,
            "EpisodeType": 0,
            "CharacterId": null,
            "SpeakerName": "",
            "Description": "【Future Dai Star】Eden/n连尺野初魅/n乌森大黑/n舍人仁花子/n万容/n笔岛时雨",
            "Order": 1
        },
        {
            "Id": 23064501,
            "EpisodeType": 5,
            "CharacterId": 203,
            "SpeakerName": "",
            "Description": "哈啊～，结束啦～！/n希望最后能写成一篇好报道啊～！",
            "Order": 1
        },
        {
            "Id": 23064502,
            "EpisodeType": 5,
            "CharacterId": 202,
            "SpeakerName": "",
            "Description": "仁花亲，辛苦了。本来还在想会来什么样的记者，/n不过看起来是个懂行、会把吾主威光传达出去的人，真是太好了。",
            "Order": 2
        },
        {
            "Id": 23064503,
            "EpisodeType": 5,
            "CharacterId": 204,
            "SpeakerName": "",
            "Description": "这个嘛，毕竟是主动向我们这种剧团提出采访的记者，/n我觉得本来就不用担心啦。",
            "Order": 3
        },
        {
            "Id": 23064504,
            "EpisodeType": 5,
            "CharacterId": 205,
            "SpeakerName": "",
            "Description": "关于《俄狄浦斯王》问时雨的问题太少了，这点让我很不满意呢～。/n不过嘛，这次舞台的主角毕竟是初魅和容前辈，也没办法。",
            "Order": 4
        },
        {
            "Id": 23064505,
            "EpisodeType": 5,
            "CharacterId": 203,
            "SpeakerName": "",
            "Description": "好啦好啦，小黑和时雨酱不也被说，很期待你们继《恶魔的朋友》之后再次担任主演吗！/n以后还有很多机会啦！",
            "Order": 5
        },
        {
            "Id": 23064506,
            "EpisodeType": 5,
            "CharacterId": 201,
            "SpeakerName": "",
            "Description": "采访看起来也很顺利，真是再好不过。",
            "Order": 6
        },
        {
            "Id": 23064507,
            "EpisodeType": 5,
            "CharacterId": 202,
            "SpeakerName": "",
            "Description": "吾主！",
            "Order": 7
        },
        {
            "Id": 23064508,
            "EpisodeType": 5,
            "CharacterId": 204,
            "SpeakerName": "",
            "Description": "初魅觉得怎么样？实际接受采访以后。",
            "Order": 8
        },
        {
            "Id": 23064509,
            "EpisodeType": 5,
            "CharacterId": 201,
            "SpeakerName": "",
            "Description": "没什么特别的，什么都没有改变。/n只有站上舞台，才能真正传达Eden表现力有多高吧。",
            "Order": 9
        },
        {
            "Id": 23064510,
            "EpisodeType": 5,
            "CharacterId": 204,
            "SpeakerName": "",
            "Description": "哈哈，不过初魅确实就是这样呢。/n果然一点都不会动摇啊～。",
            "Order": 10
        },
        {
            "Id": 23064511,
            "EpisodeType": 5,
            "CharacterId": 201,
            "SpeakerName": "",
            "Description": "不过，这次采访也是因为你们的努力得到了认可。/n我认为还是很有意义的。",
            "Order": 11
        },
        {
            "Id": 23064512,
            "EpisodeType": 5,
            "CharacterId": 203,
            "SpeakerName": "",
            "Description": "是莲小姐……呢！",
            "Order": 12
        },
        {
            "Id": 23064513,
            "EpisodeType": 5,
            "CharacterId": 202,
            "SpeakerName": "",
            "Description": "不愧是吾主……既有绝不动摇的坚定内心，/n又愿意为了我们接受采访，这份宽广胸襟……实在令人万分惶恐！",
            "Order": 13
        }
    ]
}
