      "EpisodeMasterId": 2003302,
      "Order": 2,
      "GroupOrder": 27,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "……我？　很有精神哦。真是的，妈妈也太爱操心了。",
      "VoiceFileName": "20033020251",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
