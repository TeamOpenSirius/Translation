        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2003302010,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "……。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "HeadDirectionMasterId": 4,
