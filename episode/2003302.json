          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2003302020,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "和我同期的王雪，总是有一点点冷淡，/n但又总是有一点点温柔。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020190",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302021,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "她会提醒我，与其和别人亲近不如多练习，/n也没有拒绝我和她一起吃晚饭。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020200",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302022,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "现在想来，这些地方真的很像王雪。/n或许正因为这样，我才一直想着，总有一天要和她变得要好。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020210",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302023,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "像她那样拼命咬住机会不放，/n就算成不了第一，也至少得让自己“不至于被辞退”。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020220",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302024,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我擅自憧憬着她。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020230",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
