  "Title": "关于雪",
  "EpisodeDetail": [
    {
      "Id": 2003302001,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我对王雪的第一印象，是“有一点点可怕的人”。",
      "BackgroundImageFileName": "670",
      "BgmFileName": "11",
      "SeFileName": "641",
      "WindowEffect": 1,
      "VoiceFileName": "20033020010",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302002,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我在冲绳被星探选中，第一次到东京生活，/n也是第一次演戏，心里装满了期待，兴奋得不得了。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020020",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302003,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我毫不怀疑，同期的大家肯定也都怀着一样满满的期待，/n追着快乐的梦想才加入银河座。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020030",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302004,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "所以入团说明会上，偶然坐在旁边的王雪，/n我也想着“想和她搞好关系”，向她伸出了手。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020040",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302005,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "啊……咦……。/n对不起，是不是太自来熟了……。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302006,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "你活得挺太平的。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020060",
