    },
    {
      "Id": 2003302030,
      "EpisodeMasterId": 2003302,
      "Order": 2,
      "GroupOrder": 28,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "最近稍微有点忙，所以……才没怎么播。",
      "VoiceFileName": "20033020261",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
