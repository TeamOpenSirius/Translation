    },
    {
      "Id": 2003302011,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "……王雪的提醒，是真的。/n等“第二次机会”结束时，好几个熟悉的面孔已经不见了。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020110",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302012,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我原本以为会有很多很多开心的事，/n可光是照着导演老师和训练师的要求去做，就已经让我拼尽全力。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020120",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302013,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我甚至害怕，只要把“想回家”说出口一次，/n它就会轻而易举地变成真的。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020130",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
