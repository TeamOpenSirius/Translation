    {
      "Id": 2003302008,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "你知道这里是什么地方才来的吧。/n你和我不是“朋友”，而是互相争抢角色的对手。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2003302009,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "有空想着和别人搞好关系，还不如去练习。/n下个月同期的人数就算少一半，也一点不奇怪。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
