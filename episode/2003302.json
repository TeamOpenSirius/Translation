      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "直播？　……嗯，那个。",
      "VoiceFileName": "20033020260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 402,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
