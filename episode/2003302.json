      "GroupOrder": 31,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "是没错啦……可不就是稍微没直播一阵子吗？/n怎么了，妈妈？",
      "VoiceFileName": "20033020290",
      "CharacterMotions": [
        {
