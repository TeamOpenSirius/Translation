        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302031,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "不用担心啦！　前阵子不是还给你发了直播票吗？/n《白蛇传》里，我演白娘子，是个蛇妖女孩，还要诱惑王雪哦！",
      "VoiceFileName": "20033020270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 200,
          "BodyMotionMasterId": 2,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2003302032,
      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "学校也很开心，前阵子还去了美兔亲家里开的店——",
      "VoiceFileName": "20033020280",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 6,
          "LipSyncMasterId": 1,
          "SpineId": 0,
