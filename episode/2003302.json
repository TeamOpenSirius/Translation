      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "这样啊。/n那个……我可以一起吃吗？",
      "WindowEffect": 1,
      "VoiceFileName": "20033020170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
