      "EpisodeMasterId": 2003302,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……随你。",
      "WindowEffect": 1,
      "VoiceFileName": "20033020180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 79,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 4,
