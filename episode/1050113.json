      "EpisodeMasterId": 1050113,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "接下来要观看我们舞台的人，/n是塑造了Sense至上主义风潮的演剧界顶点——世界演剧联盟。",
      "VoiceFileName": "10501130240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
