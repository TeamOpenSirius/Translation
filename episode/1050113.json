      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
