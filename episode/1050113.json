      "EpisodeMasterId": 1050113,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "（最初怀着这个愿望的时候，我还是孤身一人。/n　也从未想过要让谁理解我。）",
      "VoiceFileName": "10501130170",
      "CharacterMotions": [
