    },
    {
      "Id": 1050113018,
      "EpisodeMasterId": 1050113,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "（然而，不知从什么时候起，我独自奔跑的这条路上，/n　Eden的大家开始愿意跟在我身后了。）",
      "VoiceFileName": "10501130180",
