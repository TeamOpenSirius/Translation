      "EpisodeMasterId": 1050113,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "多亏大家的努力，我们前不久成功拿下了普罗米修斯奖。/n但说到底，那个奖项本就与我们的戏剧风格相契合。",
      "VoiceFileName": "10501130230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
