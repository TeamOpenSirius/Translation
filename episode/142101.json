        },
        {
            "Id": 142101012,
            "EpisodeMasterId": 142101,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "剧团成员A",
            "FontSize": 2,
            "Phrase": "是！前阵子的《桥弁庆》里，/n莉莉亚前辈的样子，我到现在都忘不了……！",
            "VoiceFileName": "1421010120",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142101013,
            "EpisodeMasterId": 142101,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "剧团成员A",
            "FontSize": 2,
            "Phrase": "……那时候的莉莉亚前辈，/n明明演的是鬼，却华丽得让人难以置信，又那么漂亮……。",
            "VoiceFileName": "1421010130",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142101014,
            "EpisodeMasterId": 142101,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "剧团成员A",
            "FontSize": 2,
            "Phrase": "同时还带着妖异和力量感……。/n让我不由自主看入迷了。",
            "VoiceFileName": "1421010140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142101015,
            "EpisodeMasterId": 142101,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "剧团成员A",
            "FontSize": 2,
            "Phrase": "我也想像那样，演出既美丽又可怕的感觉……/n像莉莉亚前辈的桥姬那样！",
            "VoiceFileName": "1421010150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142101016,
            "EpisodeMasterId": 142101,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "剧团成员A",
            "FontSize": 2,
            "Phrase": "所以……拜托您了！",
            "VoiceFileName": "1421010160",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
