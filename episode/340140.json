    "Title": "【Birthday2025】王雪",
    "EpisodeDetail": [
        {
            "Id": 34014001,
            "EpisodeType": 0,
            "CharacterId": null,
            "SpeakerName": "",
            "Description": "【Birthday2025】王雪/n王雪/n/n15岁，高中一年级。/n从中国的剧团来到日本。/n上进心很强，成长速度也十分惊人，但同时有着将演戏完全视作工作的冷静一面，因此有时显得有些嚣张。/n对于自己喜欢的人，经常会亲手做故乡的火锅招待对方。/n/n年级：高中一年级/n生日：6月19日/n身高：151cm/n兴趣：存钱/nSense：先手必胜（先手必胜）/n能够在舞台前半段发挥出超越自身潜力的力量。/n无论做什么都行动迅速，这份Sense中也隐约带着她“先手必胜”的气势。",
            "Order": 1
        },
        {
            "Id": 34014502,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "打完工累得要死回来，结果……。",
            "Order": 2
        },
        {
            "Id": 34014503,
            "EpisodeType": 5,
            "CharacterId": 305,
            "SpeakerName": "",
            "Description": "生日快乐，雪！",
            "Order": 3
        },
        {
            "Id": 34014504,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "没想到门一打开，就被礼花炮迎面招呼……。",
            "Order": 4
        },
        {
            "Id": 34014505,
            "EpisodeType": 5,
            "CharacterId": 304,
            "SpeakerName": "",
            "Description": "雪刚才叫了一声「呀」。/n呵呵……好可爱。",
            "Order": 5
        },
        {
            "Id": 34014506,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "少管我！/n哈～反正这肯定是你出的主意吧？德国。",
            "Order": 6
        },
        {
            "Id": 34014507,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "这话可不好听，是我和绯花里两个人一起想的！！",
            "Order": 7
        },
        {
            "Id": 34014508,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "难得雪过生日嘛。/n为了感谢你平时一直照顾我们，我们特意准备了派对！",
            "Order": 8
        },
        {
            "Id": 34014509,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "不就是又长一岁，有必要这么夸张吗……。/n而且，就算说是派对，料理最后还不是要我做？",
            "Order": 9
        },
        {
            "Id": 34014510,
            "EpisodeType": 5,
            "CharacterId": 305,
            "SpeakerName": "",
            "Description": "才不是！今天的饭，是我们做的！/n来，雪，过来这边！",
            "Order": 10
        },
        {
            "Id": 34014511,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "啊，喂……！",
            "Order": 11
        },
        {
            "Id": 34014512,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "这是……火锅？",
            "Order": 12
        },
        {
            "Id": 34014513,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "嗯，因为平时一直都是雪做给我们吃。/n所以今天，我们商量着换我们做给雪吃。",
            "Order": 13
        },
        {
            "Id": 34014514,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "德国……。呵，居然敢挑战火锅，口气不小嘛。/n能不能让我满意，就让我看看你们的本事吧！",
            "Order": 14
        },
        {
            "Id": 34014515,
            "EpisodeType": 5,
            "CharacterId": 301,
            "SpeakerName": "",
            "Description": "呵呵，味道绝对可以保证！雪小姐！",
            "Order": 15
        },
        {
            "Id": 34014516,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "诶——……连历小姐也动手做了？/n真、真的没问题吗！？喂，德国！？",
            "Order": 16
        },
        {
            "Id": 34014517,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "我有认真给她指示，也全程盯着，所以没问题……应该。",
            "Order": 17
        },
        {
            "Id": 34014518,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "应该！？什么叫应该啊！",
            "Order": 18
        },
        {
            "Id": 34014519,
            "EpisodeType": 5,
            "CharacterId": 305,
            "SpeakerName": "",
            "Description": "大家都很努力哦！/n我……很有自信！",
            "Order": 19
        },
        {
            "Id": 34014520,
            "EpisodeType": 5,
            "CharacterId": 304,
            "SpeakerName": "",
            "Description": "辣度也加上去了……我觉得这样会更好吃。",
            "Order": 20
        },
        {
            "Id": 34014521,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "唔唔……今天可是我的生日，要是成品微妙我可不答应！/n那么，我开动了！！",
            "Order": 21
        }
    ]
}
