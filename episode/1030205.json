      "SpeakerIconId": "303"
    },
    {
      "Id": 1030205014,
      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "我需要钱。别怪我。/n想找主角的话，就去找别人吧。",
      "WindowEffect": 1,
      "VoiceFileName": "10302050130",
      "CharacterMotions": [
