      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（那还是我生活在故乡中国的时候。/n　曾有一个人，唯一一次主动来挖我）",
      "WindowEffect": 1,
      "VoiceFileName": "10302050060",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030205008,
      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "星探",
      "FontSize": 2,
      "Phrase": "我们正在全国招募有才能的年轻人，终于让我找到了！/n你有成为Dai Star的才能！",
      "WindowEffect": 1,
      "VoiceFileName": "10302050070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030205009,
      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "星探",
      "FontSize": 2,
      "Phrase": "对戏剧有兴趣吗？一起以世界为目标吧！",
      "WindowEffect": 1,
      "VoiceFileName": "10302050080",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
