      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "发现好友坎帕内拉后，乔班尼冲上了列车。/n却不知道那正是把死者灵魂送往神身边的银河铁道。",
