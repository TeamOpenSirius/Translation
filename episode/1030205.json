      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（但我没有点头）",
      "WindowEffect": 1,
      "VoiceFileName": "10302050090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 15,
