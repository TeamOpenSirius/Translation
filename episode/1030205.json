      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "某个祭典之夜，乔班尼从一个神秘男人手里得到一张车票。/n随后听见了奇怪的幻听。",
      "VoiceFileName": "10302050210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
