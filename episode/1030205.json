      "Id": 1030205026,
      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“这里是银河车站，银河车站。”/n　那里是一座从未见过的铁路车站。",
      "VoiceFileName": "10302050220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
