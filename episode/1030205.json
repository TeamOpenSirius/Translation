      "EpisodeMasterId": 1030205,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "主人公叫乔班尼。虽然总被坏孩子欺负，/n却为了卧病在床的母亲努力赚生活费，是个勤工俭学的学生。",
      "VoiceFileName": "10302050200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
