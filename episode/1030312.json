    {
      "Id": 1030312022,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……我们拥有其他剧团所没有的东西。/n那就是从前辈手中继承而来的、打造优质舞台的经验与智慧。",
      "VoiceFileName": "10303120200",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312023,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "无论时代如何变迁，它都创造出了无数感动。/n即便逆着时代潮流，也始终不变地照亮世界。",
      "VoiceFileName": "10303120210",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312024,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 24,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "663",
      "BackgroundImageFileFadeType": 4,
      "CharacterMotions": [],
      "FadeValue1": 0.30000001192092896,
      "FadeValue3": 0.30000001192092896
    },
    {
      "Id": 1030312025,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "这正是让我们银河座成为银河座的传统。/n它一次次经受时间考验，仍留存至今。",
      "VoiceFileName": "10303120220",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312026,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "正因为世界不断变化，才更要一直坚守在同一个位置。/n这本身，不也同样能够吸引人吗。",
      "VoiceFileName": "10303120230",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312027,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 27,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "670",
      "BackgroundImageFileFadeType": 4,
      "CharacterMotions": [],
      "FadeValue1": 0.30000001192092896,
      "FadeValue3": 0.30000001192092896
    },
    {
      "Id": 1030312028,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 28,
      "FontSize": 2,
      "Phrase": "",
      "CharacterMotions": []
    },
    {
      "Id": 1030312029,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "我相信。相信构筑银河座的前人所留下的智慧。/n也相信正在改变的全新《麦克白》。",
      "VoiceFileName": "10303120240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 79,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 30103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312030,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "所以，如果大家现在仍在迷茫。/n如果还在为无处安放的情感而烦恼。",
      "VoiceFileName": "10303120250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312031,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "请把大家的热忱交给身为团长的我……不。/n交给正在改变的全新《麦克白》，可以吗。",
      "VoiceFileName": "10303120260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312032,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "我明白你的意思了。/n只让我确认一件事。",
      "VoiceFileName": "10303120270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
