      "SpeakerIconId": "302"
    },
    {
      "Id": 1030312007,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……各位，我作为团长有话想说。/n擅自发表这些意见，还请大家原谅。",
      "VoiceFileName": "10303120070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 79,
