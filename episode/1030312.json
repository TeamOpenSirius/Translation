      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "正好关于这件事，我有话要对大家说。/n对吧，千寿历。",
