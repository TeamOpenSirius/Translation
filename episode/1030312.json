      "SpeakerIconId": "304"
    },
    {
      "Id": 1030312013,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "银河座团员",
      "FontSize": 2,
      "Phrase": "等等，千寿小姐好像在说什么。/n安静。",
      "VoiceFileName": "10303120130",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030312014,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……正如各位所知，银河座如今正被要求思考是否有改变的必要。/n大家或许也正为自己该做什么而迷茫、烦恼。",
      "VoiceFileName": "10303120140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 30103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312015,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "即使身处困境，大家仍保持向上之心，日夜努力排练，/n拼尽全力的模样，也令我由衷钦佩。",
      "VoiceFileName": "10303120150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 79,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312016,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "想要超越现在，想要带来更多感动。/n大家这份强烈的热忱，身为主演的我也同样拥有。",
      "VoiceFileName": "10303120160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312017,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "千寿历……。",
      "VoiceFileName": "10303120170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030312018,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "可是，舞台是集体艺术。大家必须朝着同一个方向前进。/n所以，请让我为大家指出该走的道路。",
      "VoiceFileName": "10303120180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 30103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312019,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "说来听听。/n我们该走的道路是什么？",
      "VoiceFileName": "10303120190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
