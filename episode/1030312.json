      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "我们应当守护的传统，确实拥有价值，对吧？",
