      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312008,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "这场舞台的团长，是我千寿历。",
      "BgmFileName": "204",
      "VoiceFileName": "10303120080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312009,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "我该做的事，是让《麦克白》成功。/n并以这份成功，守住Saint-Cloud之星。",
      "VoiceFileName": "10303120090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312010,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "然后——",
      "VoiceFileName": "10303120100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 79,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312011,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "成为我们在守护传统、追求革新的路上所依循的Guide。/n我相信自己至今所做的一切，也相信自己的信念。",
      "VoiceFileName": "10303120110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030312012,
      "EpisodeMasterId": 1030312,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "嗯……。千寿历……？",
      "VoiceFileName": "10303120120",
      "CharacterMotions": [
