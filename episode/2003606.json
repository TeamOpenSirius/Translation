      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 2003606002,
      "EpisodeMasterId": 2003606,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "为了回到故乡堪萨斯，她一直向前看，/n拼命努力着。",
      "VoiceFileName": "20036060020",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 2003606003,
      "EpisodeMasterId": 2003606,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "即使不知道家的方向、被西方女巫抓住、/n哪怕奥兹魔法师也离开了，她还是没有放弃。",
      "VoiceFileName": "20036060030",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 2003606004,
      "EpisodeMasterId": 2003606,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "她和伙伴们克服了无数困难，最后把银鞋敲了三下，/n借助魔法回到家中，与婶婶紧紧相拥。",
      "VoiceFileName": "20036060040",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 2003606005,
      "EpisodeMasterId": 2003606,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "我也想相信，终有一天那样的魔法和幸福结局/n也会降临到我身上。",
      "VoiceFileName": "20036060050",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
