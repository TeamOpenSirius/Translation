    {
      "Id": 1040220005,
      "EpisodeMasterId": 1040220,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "剧团电姬粉丝A",
      "FontSize": 2,
      "Phrase": "哈――！？　二手平台上居然有人挂叶羽亲的周边！？/n爱呢，爱去哪里了！　转卖狗都给我烧了！　污物就该消毒！",
      "VoiceFileName": "10402200040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040220006,
      "EpisodeMasterId": 1040220,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "剧团电姬粉丝B",
      "FontSize": 2,
      "Phrase": "就算挂了也没人会买好吗。/n第三轮受注生产都开始了。光速应对，剧团电姬真神。",
      "VoiceFileName": "10402200050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
