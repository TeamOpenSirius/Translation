      "EpisodeMasterId": 1040220,
      "Order": 1,
      "GroupOrder": 41,
      "SpeakerName": "要",
      "FontSize": 2,
      "Phrase": "现在已经把叶羽抬成神轿，哇咻哇咻地祭典狂欢了。/n嘛，叶羽现在也确实有在好好当主演，算扯平了吧。",
      "VoiceFileName": "10402200350",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 6,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "406"
    },
    {
      "Id": 1040220043,
      "EpisodeMasterId": 1040220,
      "Order": 1,
      "GroupOrder": 42,
      "SpeakerName": "根津真知子",
      "FontSize": 2,
      "Phrase": "真是的，也给我明白你们自己同样受到了肯定。",
      "VoiceFileName": "10402200360",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
