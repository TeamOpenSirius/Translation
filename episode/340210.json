            "CharacterId": null,
            "SpeakerName": "",
            "Description": "【Birthday2025】本巢叶羽/n本巢叶羽/n/n11岁，小学六年级。/n作为天才童星声名远扬，同时也是剧团电姬年轻的王牌。/n只靠才能就能完成工作，因此极度讨厌努力，凡事都想偷懒。/n喜欢以前辈身份被年长团员捧着。/n/n年级：小学六年级/n生日：7月17日/n身高：151cm/n兴趣：游戏/nSense：我的认真/n和同龄人一起演出时，存在感会大幅提升。/n从小就作为天才童星受到父母与周围大人的追捧。/n由这些经历磨练而成的 Sense。",
            "Order": 1
        },
        {
            "Id": 34021502,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "辛苦啦——。/n咦，还只有伊吕波来了啊。",
            "Order": 2
        },
        {
            "Id": 34021503,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "居然第一个到，真努力啊～。/n不过我今天心情也不错，所以来得挺早。",
            "Order": 3
        },
        {
            "Id": 34021504,
            "EpisodeType": 5,
            "CharacterId": 401,
            "SpeakerName": "",
            "Description": "啊，辛苦了！叶羽酱！/n生日快乐！",
            "Order": 4
        },
        {
            "Id": 34021505,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "对对！谢啦，伊吕波。/n生日果然就是好啊～。",
            "Order": 5
        },
        {
            "Id": 34021506,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "今天的主角可是我，主角！/n你们就好好伺候吧！",
            "Order": 6
        },
        {
            "Id": 34021507,
            "EpisodeType": 5,
            "CharacterId": 401,
            "SpeakerName": "",
            "Description": "排练结束后，还有大家一起给你开的生日派对！/n好期待呢！",
            "Order": 7
        },
        {
            "Id": 34021508,
            "EpisodeType": 5,
            "CharacterId": 401,
            "SpeakerName": "",
            "Description": "啊，对了！叶羽酱！/n今天晚上会有礼物寄到你家！",
            "Order": 8
        },
        {
            "Id": 34021509,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "哈？寄到家里？",
            "Order": 9
        },
        {
            "Id": 34021510,
            "EpisodeType": 5,
            "CharacterId": 401,
            "SpeakerName": "",
            "Description": "对！我问了要小姐送叶羽酱什么礼物，/n她说只要送这个，肯定会喜欢！",
            "Order": 10
        },
        {
            "Id": 34021511,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "什么什么……这不是 Dr. Spice 的地方限定口味吗！？/n而且还是组合装！",
            "Order": 11
        },
        {
            "Id": 34021512,
            "EpisodeType": 5,
            "CharacterId": 405,
            "SpeakerName": "",
            "Description": "果然要最懂我啦～要～！/n真的谢谢你，伊吕波。回家以后我会好好喝的！",
            "Order": 12
        },
        {
            "Id": 34021513,
            "EpisodeType": 5,
            "CharacterId": 401,
            "SpeakerName": "",
            "Description": "嘿嘿，你能喜欢就太好了！",
            "Order": 13
        }
