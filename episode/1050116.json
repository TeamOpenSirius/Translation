  "EpisodeDetail": [
    {
      "Id": 1050116001,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "審査員Ｈ",
      "FontSize": 2,
      "Phrase": "剧团电姬……主要以2.5次元舞台为中心活动的剧团吗。/n说白了就是噱头型剧团……不是吗？",
      "BackgroundImageFileName": "2220",
      "BgmFileName": "5",
      "VoiceFileName": "10501160010",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116002,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "審査員Ｇ",
      "FontSize": 2,
      "Phrase": "现在下判断还太早。这个剧团也曾培养出Dai Star。/n而且这次担任座长的，据说还是那个千寿家的演员。",
      "VoiceFileName": "10501160020",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116003,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "……。",
      "VoiceFileName": "10501160030",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116004,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "（就让我看看吧，你们所谓的实力。/n　好了，开幕了。）",
      "VoiceFileName": "10501160040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116005,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 5,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "305",
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1050116006,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "「为什么……会变成这样……。神也好、人也好，这所学园里的家伙们/n　为什么全都堕落到了这种地步！」",
      "VoiceFileName": "10501160050",
      "CharacterMotions": [],
      "SpeakerIconId": "404"
    },
    {
      "Id": 1050116007,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "「我已经忍无可忍了！这所学园就由我亲手肃清！/n　去吧，涅墨亚狮子，把一切都摧毁！」",
      "VoiceFileName": "10501160060",
      "CharacterMotions": [],
      "SpeakerIconId": "404"
    },
    {
      "Id": 1050116008,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "「虽然不知道怎么回事，不过正合我意。/n　哈哈哈！身体能随心所欲活动，真是太爽了！」",
      "VoiceFileName": "10501160070",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1050116009,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "「行啊，阿斯特赖亚。就如你所愿，让我大闹一场吧！」",
      "VoiceFileName": "10501160080",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1050116010,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "観客",
      "FontSize": 2,
      "Phrase": "（每个登场人物的个性都表现得非常鲜明……！/n　这就是在2.5次元舞台上磨炼出来的表现力……？）",
      "VoiceFileName": "10501160090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116011,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "審査員Ｈ",
      "FontSize": 2,
      "Phrase": "（这部剧是特意找擅长这一领域的编剧，根据她们的特点量身创作的，/n　原来如此……确实很吸引人，难怪能一路站到这个舞台上。）",
      "VoiceFileName": "10501160100",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116012,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "審査員Ｇ",
      "FontSize": 2,
      "Phrase": "（目前登场的演员，都把自己的Sense运用得相当出色。/n　接下来，就看据说没有Sense的主演千寿伊吕波了……）",
      "VoiceFileName": "10501160110",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116013,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 13,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1050116014,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "「凭什么要我帮宙斯。/n　现在的会长是那家伙吧，让她自己想办法不就行了。」",
      "VoiceFileName": "10501160120",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050116015,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "「……啧。真拿你们没办法。知道了，做就做吧！/n　我来阻止阿斯特赖亚她们！」",
      "VoiceFileName": "10501160130",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050116016,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "観客",
      "FontSize": 2,
      "Phrase": "（主人公克洛诺斯……这存在感也太强了吧……！？/n　她应该没有使用Sense才对……？）",
      "VoiceFileName": "10501160140",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116017,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "審査員Ｈ",
      "FontSize": 2,
      "Phrase": "（明明没有Sense，/n　却绽放出了完全不逊于拥有Sense之人的光芒……）",
      "VoiceFileName": "10501160150",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116018,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "審査員Ｈ",
      "FontSize": 2,
      "Phrase": "（该说不愧是千寿家吗……她的演技确实货真价实。）",
      "VoiceFileName": "10501160160",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116019,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 19,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1050116020,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "「你刚才说要打倒我？那就试试看啊，“前”会长……/n　不过凭你，我看根本不可能！」",
      "VoiceFileName": "10501160170",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1050116021,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "「你也就现在还能嘴硬了！」",
      "VoiceFileName": "10501160180",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050116022,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "「从现在开始，由我来做你的对手，克洛诺斯。」",
      "VoiceFileName": "10501160190",
      "CharacterMotions": [],
      "SpeakerIconId": "404"
    },
    {
      "Id": 1050116023,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "「你曾经统治过这个世界，可如今已经退居幕后。/n　那一定是因为，你的身上没有正义吧。」",
      "VoiceFileName": "10501160200",
      "CharacterMotions": [],
      "SpeakerIconId": "404"
    },
    {
      "Id": 1050116024,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "「而我背负着正义。所以，我绝不可能输给你。」",
      "VoiceFileName": "10501160210",
      "CharacterMotions": [],
      "SpeakerIconId": "404"
    },
    {
      "Id": 1050116025,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "「什么正义！凭自己的判断随意审判神与人……/n　这种自以为是的正义，根本不会有人愿意追随你！」",
      "VoiceFileName": "10501160220",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050116026,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "「我会在这里……阻止你！」",
      "VoiceFileName": "10501160230",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050116027,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "「吾名乃时间支配神克洛诺斯！掌控一切生命之时间者！/n　你的时间，也在我的掌握之中！」",
      "VoiceFileName": "10501160240",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050116028,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 28,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1050116029,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "審査員Ｇ",
      "FontSize": 2,
      "Phrase": "在没有Sense的情况下，作为这个大舞台的主演，/n竟然还能持续吸引观众……。",
      "VoiceFileName": "10501160250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116030,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "審査員Ｇ",
      "FontSize": 2,
      "Phrase": "虽然与传统舞台的形式有所不同……/n但这绝不是什么噱头，而是堂堂正正的舞台艺术。",
      "VoiceFileName": "10501160260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116031,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "審査員Ｈ",
      "FontSize": 2,
      "Phrase": "没想到2.5次元演剧竟然如此深不可测。/n世界还真大啊……让我深刻意识到了自己见识的狭隘。",
      "VoiceFileName": "10501160270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116032,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "……那么，就由我代表评审，/n发表总评。",
      "BgmFileName": "29",
      "VoiceFileName": "10501160280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116033,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "（祖母……！）",
      "VoiceFileName": "10501160290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 500,
          "BodyMotionMasterId": 13,
          "SpineId": 40103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050116034,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "一部剧目的形态，是前人怀着特定意图塑造出来的，/n擅自将其打破，不能称作挑战，不过是冒犯罢了。",
      "VoiceFileName": "10501160300",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116035,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "此外，过于华丽的演出手法，/n在我看来也有压缩演员发挥空间的一面。",
      "VoiceFileName": "10501160310",
      "CharacterMotions": [],
