    },
    {
      "Id": 1050116039,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "无论每位演员的演技质量，还是整部剧的整体感，/n再加上明明让无法使用Sense的人担任主演——",
      "BgmFileName": "301",
      "VoiceFileName": "10501160350",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116040,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 40,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "却能凭借周围演员的演技与演出设计，将主演的光芒/n提升到不逊于使用Sense的演员的程度，这份手腕值得赞赏。",
      "VoiceFileName": "10501160360",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1050116041,
      "EpisodeMasterId": 1050116,
      "Order": 1,
      "GroupOrder": 41,
      "SpeakerName": "千寿历与伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "而所谓主演，正是懂得该如何展现自己的人……。/n这一次的主演，满足了这一点。",
      "VoiceFileName": "10501160370",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
