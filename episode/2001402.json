      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "心菜",
      "FontSize": 2,
      "Phrase": "我们在舞台上彼此对戏。现在回想起来，只是照猫画虎的稚嫩演技。",
      "BackgroundCharacterImageFileName": "140450_0",
      "VoiceFileName": "20014020210",
      "CharacterMotions": [],
