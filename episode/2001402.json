      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "回过神时，我正仰头看着心菜把防波堤当成舞台，/n一个人演着好几个角色。",
      "BackgroundCharacterImageFileName": "140450_0",
