      "EpisodeMasterId": 2001402,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "她明明很寂寞……在舞台上却演着笑容满面的戏，/n可心里其实在哭，所以演得一点都不好。",
      "BackgroundCharacterImageFileName": "140450_0",
      "VoiceFileName": "20014020190",
