    {
      "Id": 1030118007,
      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "记者",
      "FontSize": 2,
      "Phrase": "接下来请允许我采访《竹取物语》的两位主演！/n请二位接受我们的采访！",
      "VoiceFileName": "10301180070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030118008,
      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "记者",
      "FontSize": 2,
      "Phrase": "饰演辉夜姬的千寿历小姐！/n以及饰演操的拉莫娜·沃尔芙小姐！",
      "VoiceFileName": "10301180080",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030118009,
      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "记者",
      "FontSize": 2,
      "Phrase": "“为两人的相遇与离别落泪！”“#银河座太强了”等等！/n社交平台上也接连出现大量好评。",
      "VoiceFileName": "10301180090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030118010,
      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "记者",
      "FontSize": 2,
      "Phrase": "首先是表现非常亮眼的拉莫娜小姐，/n请告诉我们你最直接的感想！",
      "VoiceFileName": "10301180100",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030118011,
      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "能演出让大家开心的戏，我很高兴。/n也要感谢协助我的共演者和工作人员。",
      "VoiceFileName": "10301180110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
