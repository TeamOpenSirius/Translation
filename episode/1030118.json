      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "记者",
      "FontSize": 2,
      "Phrase": "千寿小姐觉得怎么样？",
      "VoiceFileName": "10301180120",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030118013,
      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "连我自己都有些惊讶，我现在很期待下一场演出。/n和老翁、老妇的羁绊，与皇子们的互动，与使者的对决。",
      "VoiceFileName": "10301180130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 2,
          "SpineId": 30109,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
