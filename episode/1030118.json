      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "记者",
      "FontSize": 2,
      "Phrase": "今天的重点关注环节，是正在大受好评上演中的——/n银河座各位来到现场！",
      "BackgroundImageFileName": "660",
      "BackgroundImageFileFadeType": 1,
