      "EpisodeMasterId": 1030118,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "记者",
      "FontSize": 2,
      "Phrase": "我看了《竹取物语》，到现在都还兴奋得停不下来！/n想问的事情太多，完全整理不出头绪……！",
      "VoiceFileName": "10301180030",
