      "EpisodeMasterId": 1030420,
      "Order": 1,
      "GroupOrder": 40,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "父亲离世，与母亲分别，还必须隐藏身份以剑为生――/n那名年轻人的心境，被她细腻地映在了表情上……",
      "VoiceFileName": "10304200400",
      "CharacterMotions": [
