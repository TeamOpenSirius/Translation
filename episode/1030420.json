      "EpisodeMasterId": 1030420,
      "Order": 1,
      "GroupOrder": 67,
      "SpeakerName": "演出主管",
      "FontSize": 2,
      "Phrase": "考虑到千寿的状态，演戏从最后一击开始。/n先从弁庆挥出全力一刀时的台词开始。明白了吗。",
      "VoiceFileName": "10304200640",
