      "EpisodeMasterId": 1030420,
      "Order": 1,
      "GroupOrder": 42,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "绯花里已经找到答案了。/n……那就是现在的绯花里。",
