      "EpisodeMasterId": 1030420,
      "Order": 1,
      "GroupOrder": 63,
      "SpeakerName": "前剧团成员A",
      "FontSize": 2,
      "Phrase": "那还用说。/n下一场公演要求的是什么，你不可能不明白吧？",
      "WindowEffect": 1,
      "VoiceFileName": "10304200610",
      "CharacterMotions": [],
