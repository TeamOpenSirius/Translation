          "FacialExpressionMasterId": 70,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
