    {
      "Id": 130142015,
      "EpisodeMasterId": 130142,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "能不能告诉我们？/n是什么样的过去，把你塑造成了如此出色的人。",
      "VoiceFileName": "1301420120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 2,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
