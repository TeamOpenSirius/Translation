      "EpisodeMasterId": 130142,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "所以那就是银河座啊。/n没想到你一直都这么为家人操心……。",
      "VoiceFileName": "1301420240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 1,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 130142030,
      "EpisodeMasterId": 130142,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "呜呜……！　虽然听说过你家兄弟姐妹很多，/n但没想到背后居然是这么让人难过的故事呀！",
      "VoiceFileName": "1301420250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 74,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 30501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
