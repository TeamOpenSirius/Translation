        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 130142014,
      "EpisodeMasterId": 130142,
      "Order": 2,
      "GroupOrder": 11,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我也想变得这么厉害呀。",
