      "EpisodeMasterId": 130142,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "王雪！　有什么尽管说！/n我会加油帮忙呀！",
      "VoiceFileName": "1301420260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
