      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "祖母大人……。……恕我直言，银河座已经有我了。/n我看不出还有让伊吕波再次加入银河座的意义。",
      "VoiceFileName": "20069030230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 104,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 3,
