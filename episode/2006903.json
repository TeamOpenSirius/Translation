      "SpeakerIconId": "301"
    },
    {
      "Id": 2006903029,
      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "当伊吕波提出退出银河座时，祖母大人也同意了。/n正因如此，至今您才一直对伊吕波放任不管，不是吗？",
      "VoiceFileName": "20069030240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006903030,
      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "事情并没有那么简单，千寿历。既然她背负千寿之名登台，/n世人就会把伊吕波视作千寿家的演员。",
      "VoiceFileName": "20069030250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006903031,
      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "如今，她却凭借小剧团以及旁门左道的戏剧进入了许多人的视野。/n这很可能有损我们千寿家的门第，是一件大事。",
      "VoiceFileName": "20069030260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006903032,
      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "既然如此，至少应该把她转到一个不辱千寿之名的剧团。/n……身为千寿家的演员，你应该明白才对吧？",
      "VoiceFileName": "20069030270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006903033,
      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……！",
      "VoiceFileName": "20069030280",
      "CharacterMotions": [
