      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "不是还有Dai Star祭典吗？/n你有时间为这种事烦心吗？",
      "VoiceFileName": "20069030290",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006903035,
      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "不与人厮混，只一心一意始终作为天顶之星闪耀。/n这才是身为千寿家演员的你的职责。",
      "VoiceFileName": "20069030300",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
