      "EpisodeMasterId": 2006903,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "竟然会为外部因素……而且还是亲族之事烦心，/n实在是自觉不足，荒唐可笑。",
      "VoiceFileName": "20069030310",
