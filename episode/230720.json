{
    "EpisodeId": 230720,
    "StoryType": 5,
    "Title": "【Future Dai Star】银河座",
    "EpisodeDetail": [
        {
            "Id": 23072014,
            "EpisodeType": 0,
            "CharacterId": null,
            "SpeakerName": "",
            "Description": "【Future Dai Star】银河座/n千寿历/n拉莫娜·沃尔芙/n王雪/n莉莉亚·库尔特贝/n与那国绯花里",
            "Order": 14
        },
        {
            "Id": 23072501,
            "EpisodeType": 5,
            "CharacterId": 305,
            "SpeakerName": "",
            "Description": "哈啊……拍摄真开心～！/n大家穿着同款衣服，洁白又漂亮，超级可爱！",
            "Order": 1
        },
        {
            "Id": 23072502,
            "EpisodeType": 5,
            "CharacterId": 304,
            "SpeakerName": "",
            "Description": "房间布景和月亮形状的灯也都做得很精致，很漂亮。",
            "Order": 2
        },
        {
            "Id": 23072503,
            "EpisodeType": 5,
            "CharacterId": 301,
            "SpeakerName": "",
            "Description": "是啊。不过我也吓了一跳。/n毕竟某个人突然就把胳膊搭到我肩上来了。",
            "Order": 3
        },
        {
            "Id": 23072504,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "我也绝对被拍到了被德国佬吓到的瞬间……。/n要是拍成了什么怪脸，我可要记仇的。",
            "Order": 4
        },
        {
            "Id": 23072505,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "摄影师说希望我们表现得更像平时，所以我就那么做了。/n我觉得这样能拍出一张不那么拘谨的好照片。",
            "Order": 5
        },
        {
            "Id": 23072506,
            "EpisodeType": 5,
            "CharacterId": 304,
            "SpeakerName": "",
            "Description": "也就是说，那就是我们的“平时状态”？",
            "Order": 6
        },
        {
            "Id": 23072507,
            "EpisodeType": 5,
            "CharacterId": 305,
            "SpeakerName": "",
            "Description": "也许吧！舞台上认真严谨，但大家在一起的时候就轻松开心！/n摄影师也夸我们这样很好嘛！",
            "Order": 7
        },
        {
            "Id": 23072508,
            "EpisodeType": 5,
            "CharacterId": 303,
            "SpeakerName": "",
            "Description": "先不说那到底算不算平时的样子，/n德国佬来了之后每天都变得热闹了，这倒是事实。",
            "Order": 8
        },
        {
            "Id": 23072509,
            "EpisodeType": 5,
            "CharacterId": 301,
            "SpeakerName": "",
            "Description": "这一点确实有道理。/n拉莫娜小姐的一举一动，几乎全都是从前银河座根本无法想象的事。",
            "Order": 9
        },
        {
            "Id": 23072510,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "那张照片，也许正能成为一边继承传统、一边不断改变的/n今后银河座的模样吧。",
            "Order": 10
        },
        {
            "Id": 23072511,
            "EpisodeType": 5,
            "CharacterId": 301,
            "SpeakerName": "",
            "Description": "……只是上面的人会怎么判断，就不好说了。",
            "Order": 11
        },
        {
            "Id": 23072512,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "没什么。如果现在还不认可，那迟早让他们认可就行。/n好了，赶紧回去，大家一起吃晚饭吧！",
            "Order": 12
        }
    ]
}
