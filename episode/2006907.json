      "EpisodeMasterId": 2006907,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "明明您都特地说愿意替我打点了，/n对不起……可即便如此，我还是想站在电姬的舞台上。",
      "VoiceFileName": "20069070190",
