      "EpisodeMasterId": 2006907,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "你明白自己在说什么吗？",
      "VoiceFileName": "20069070200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006907022,
      "EpisodeMasterId": 2006907,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "我明白。……确实，从祖母大人的角度来看，/n会把电姬当成不起眼的小剧团、认为我们是旁门左道，我也能理解。",
      "VoiceFileName": "20069070210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 40101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
