      "EpisodeMasterId": 2006907,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "这个……也许确实如此。/n我知道网上对于电姬参赛，也一直有各种不同意见。",
      "VoiceFileName": "20069070270",
      "CharacterMotions": [
