      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006907026,
      "EpisodeMasterId": 2006907,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "你们的剧团，说到底只是为了拓宽演剧的门路才被选中的……/n是往年根本不会出现的类型。",
      "VoiceFileName": "20069070250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006907027,
      "EpisodeMasterId": 2006907,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "千寿历和伊吕波的祖母",
      "FontSize": 2,
      "Phrase": "这是从天而降的机会……原本就不该出现的剧团。/n你该不会以为，自己是和那些传统名团以相同条件受到认可的吧？",
      "VoiceFileName": "20069070260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
