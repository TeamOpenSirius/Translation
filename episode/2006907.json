      "CharacterMotions": [
        {
          "slotNumber": 1,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 3,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
