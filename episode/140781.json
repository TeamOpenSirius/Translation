            "EpisodeMasterId": 140781,
            "Order": 2,
            "GroupOrder": 10,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "话说，怎么好像有三本！？全是同一本杂志吧！？",
            "VoiceFileName": "1407810091",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 502,
