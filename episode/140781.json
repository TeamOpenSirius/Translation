        },
        {
            "Id": 140781012,
            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "卡米拉的朋友B",
            "FontSize": 2,
            "Phrase": "耶——，一不小心收集起来了。V～V！",
            "VoiceFileName": "1407810100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 140781013,
            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "卡米拉的朋友A",
            "FontSize": 2,
            "Phrase": "她看了伊吕波酱和美兔酱，/n就说无论如何也想多买几本。",
            "VoiceFileName": "1407810110",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 140781014,
            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "卡米拉的朋友B",
            "FontSize": 2,
            "Phrase": "因为是挚——友被做特——辑诶！？/n阅读用、保存用、展示用，必须的吧！",
            "VoiceFileName": "1407810120",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 140781015,
            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "卡米拉的朋友A",
            "FontSize": 2,
            "Phrase": "她就是这么说，麻里酱怎么劝都不听。/n明明只想看内容的话网上也会放文章，完全够了。",
            "VoiceFileName": "1407810130",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 140781016,
            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "不是不是不是，你发售当天就买过了吧！？/n不用再买两本三本啦！",
            "VoiceFileName": "1407810140",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 502,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 3,
                    "SpineId": 40302,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 140781017,
            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "卡米拉的朋友B",
            "FontSize": 2,
            "Phrase": "才不够！重要的朋友登上去了！/n就是想好好买来支持！问卷也会认真寄！",
            "VoiceFileName": "1407810150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 140781018,
            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "真是的——，你有这份心就够让我满足啦。/n我真的交到好朋友了。",
            "VoiceFileName": "1407810160",
            "CharacterMotions": [
