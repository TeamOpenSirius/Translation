            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "卡米拉的朋友A",
            "FontSize": 2,
            "Phrase": "那两个人说欣赏用、保存用、传教用三本根本不够。/n听说跑遍了秋叶附近的书店。",
            "VoiceFileName": "1407810180",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
