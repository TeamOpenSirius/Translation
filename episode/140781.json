            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "真是的——，伊吕波亲她们居然买了那么多！？",
            "VoiceFileName": "1407810210",
            "CharacterMotions": [
