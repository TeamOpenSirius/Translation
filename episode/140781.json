            "EpisodeMasterId": 140781,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "卡米拉的朋友B",
            "FontSize": 2,
            "Phrase": "不过还是赢不了伊吕波酱和美兔酱。",
            "VoiceFileName": "1407810170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
