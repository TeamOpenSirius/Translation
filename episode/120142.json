      "SpeakerIconId": "303"
    },
    {
      "Id": 120142015,
      "EpisodeMasterId": 120142,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……大家，姐姐一直在努力哦。/n在这个日本，已经尽我所能地努力着。",
      "VoiceFileName": "1201420090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 75,
          "LipSyncMasterId": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
