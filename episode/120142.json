      "EpisodeMasterId": 120142,
      "Order": 2,
      "GroupOrder": 11,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "唔啾～……！",
      "VoiceFileName": "1201420111",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142019,
      "EpisodeMasterId": 120142,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "现在能治愈我的只剩毛绒玩偶了……。",
      "VoiceFileName": "1201420120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 2,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142020,
      "EpisodeMasterId": 120142,
      "Order": 2,
      "GroupOrder": 12,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "哈啊～……这个抱起来的感觉果然最棒。好困……。",
      "VoiceFileName": "1201420121",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
