    {
      "Id": 120142006,
      "EpisodeMasterId": 120142,
      "Order": 2,
      "GroupOrder": 3,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "感觉一躺下就会直接睡着。好歹牙刷了……。",
      "VoiceFileName": "1201420031",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142007,
      "EpisodeMasterId": 120142,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……说起来，我以前经常对弟弟这么说。/n“蛀牙的话治疗费可是很贵的。”……。",
      "VoiceFileName": "1201420040",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142008,
      "EpisodeMasterId": 120142,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "结果他还说“我又不吃甜食，所以不会蛀牙！”",
      "VoiceFileName": "1201420050",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142009,
      "EpisodeMasterId": 120142,
      "Order": 2,
      "GroupOrder": 5,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……净找这种蠢借口。那家伙……。",
      "VoiceFileName": "1201420051",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142010,
      "EpisodeMasterId": 120142,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……寄回家的钱够不够啊。",
      "VoiceFileName": "1201420060",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142011,
      "EpisodeMasterId": 120142,
      "Order": 2,
      "GroupOrder": 6,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "够的话至少打个电话来说一声嘛～。",
      "VoiceFileName": "1201420061",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 120142012,
      "EpisodeMasterId": 120142,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "我带来的全家福都是几年前的了。",
      "VoiceFileName": "1201420070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 17,
