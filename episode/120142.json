      "EpisodeMasterId": 120142,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "我一定会让你们过上好日子。/n让你们上好学校，过上好人生……。",
