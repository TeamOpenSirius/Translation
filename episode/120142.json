      "EpisodeMasterId": 120142,
      "Order": 2,
      "GroupOrder": 7,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "他们该不会都已经长得比我高了吧～？",
      "VoiceFileName": "1201420071",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 72,
