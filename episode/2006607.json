    },
    {
      "Id": 2006607015,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 14,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "663",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
