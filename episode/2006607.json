      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006607016,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“不义的王妃桂妮薇儿，将于明日清晨处刑。/n　作为行刑人，兰斯洛特卿。当天希望由卿亲自执行。”",
      "VoiceFileName": "20066070120",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006607017,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“王啊，这是对我的复仇吗……？/n　让我亲手处刑与我犯下不伦之罪的您的妻子……”",
      "VoiceFileName": "20066070130",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006607018,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“求您了……！既然如此，至少也把我一同送上火刑台！/n　请让我和我所爱的人一起赴死……！”",
      "VoiceFileName": "20066070140",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006607019,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“我对自己敬爱的王犯下了如此不义，/n　请让我亲手赎清这份罪孽……！”",
      "VoiceFileName": "20066070150",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006607020,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“那不可能。卿是卡美洛不可或缺的骑士。/n　若卿为自己感到羞愧，就继续侍奉我，用今后的功绩赎罪。”",
      "VoiceFileName": "20066070160",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006607021,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“……这个决定，并非出自我的本意。/n　正因如此，我才想拜托身为挚友的卿。”",
      "VoiceFileName": "20066070170",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006607022,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“怎么会……”",
      "VoiceFileName": "20066070180",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006607023,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "银河座粉丝C",
      "FontSize": 2,
      "Phrase": "兰斯洛特的挣扎，真的传达出来了……。",
      "VoiceFileName": "20066070190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006607024,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 23,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "650",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006607025,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“对不起，兰斯洛特……我真的没想变成这样。/n　都是因为我，你才会……背叛那个人……”",
      "VoiceFileName": "20066070200",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2006607026,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“请不要哭，夫人。已经没事了。/n　有愿意协助我的骑士们在。”",
      "VoiceFileName": "20066070210",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006607027,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“王那边由我来处理。那位大人也并不真心想处刑您。/n　在我安排妥当之前，您只要暂时躲起来就好。来……笑一笑。”",
      "VoiceFileName": "20066070230",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006607028,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“兰斯洛特卿，让您久等了。/n　桂妮薇儿殿下的安全由我保证。”",
      "VoiceFileName": "20066070240",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2006607029,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“拜托你了，莫德雷德卿。”",
      "VoiceFileName": "20066070250",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006607030,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 29,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1050",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006607031,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“母亲，桂妮薇儿已经落入我手！/n　一切都按计划进行！”",
      "VoiceFileName": "20066070260",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2006607032,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“做得好，莫德雷德。”",
      "VoiceFileName": "20066070270",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 2006607033,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“背叛父王的蠢货奸夫……真是个傻子。/n　只要我和那个女人结婚，我就能成为王，对吧！？”",
      "VoiceFileName": "20066070280",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2006607034,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“对，没错。那个国家会成为你和我的东西……/n　来吧，用那位王的鲜血洗净卡美洛。”",
      "VoiceFileName": "20066070290",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 2006607035,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "戏剧评论家",
      "FontSize": 2,
      "Phrase": "王雪是对手戏演员……看来会一直演到最后。/n有意思的配角安排。",
      "VoiceFileName": "20066070300",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006607036,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 35,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "663",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006607037,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“莫德雷德！！为什么，为什么……！！/n　为什么背叛我！？为什么！！！”",
      "VoiceFileName": "20066070310",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006607038,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“背叛……？不对，最先背叛我的，不正是父王吗……！/n　不承认我是您的孩子，把我放逐到遥远的岛上……！”",
      "VoiceFileName": "20066070320",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2006607039,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“把我当作不存在的人，我只是想得到认可才不断立下战功！/n　可到最后您还是无视我……父王，您……！！！”",
      "VoiceFileName": "20066070330",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 2006607040,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“咳！！怎么会……那么，这片荒废，这场惨剧，/n　难道全都是……由我自己招致的吗……”",
      "VoiceFileName": "20066070340",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006607041,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 40,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "641",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006607042,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 41,
      "SpeakerName": "银河座粉丝A",
      "FontSize": 2,
      "Phrase": "好厉害……拉莫大人的哀叹让我心都揪紧了……。/n这种演技，我从没见过……！",
      "VoiceFileName": "20066070350",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006607043,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 42,
      "SpeakerName": "银河座粉丝B",
      "FontSize": 2,
      "Phrase": "作为主演的拉莫娜，居然能演出这种感觉……！",
      "VoiceFileName": "20066070360",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006607044,
      "EpisodeMasterId": 2006607,
      "Order": 1,
      "GroupOrder": 43,
      "SpeakerName": "戏剧评论家",
      "FontSize": 2,
      "Phrase": "精彩的表演。/n拉莫娜·沃尔芙，是在星象季里更进一步了吗……？",
      "VoiceFileName": "20066070370",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
