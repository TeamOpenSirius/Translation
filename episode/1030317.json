      "EpisodeMasterId": 1030317,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（这就是千寿历磨炼出的、把恐惧化为魅力的美学。/n　这样的表演，会让所有人都盯着她看）",
      "VoiceFileName": "10303170200",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030317025,
      "EpisodeMasterId": 1030317,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（……为什么以前没明白呢。/n　千寿历磨炼的是和我不同的美。大家也一样）",
      "VoiceFileName": "10303170210",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
