    {
      "Id": 1030317023,
      "EpisodeMasterId": 1030317,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（身体的颤抖，就像真的看见了亡灵。/n　头发散乱，表情也僵硬得可怕）",
      "BgmFileName": "8",
      "VoiceFileName": "10303170190",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
