      "EpisodeMasterId": 1030317,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（可我比任何人都发自内心地渴望保持美丽。/n　那么——我也要不输给任何人地追求下去）",
      "BgmFileName": "999",
      "VoiceFileName": "10303170220",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
