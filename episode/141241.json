            "EpisodeMasterId": 141241,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "千歌",
            "FontSize": 2,
            "Phrase": "嘿嘿，因为心菜的演技真的特别厉害！/n心菜和静香，简直真的就像日和与阿斯莫德一样……。",
            "VoiceFileName": "1412410130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "FacialExpressionMasterId": 105,
                    "BodyMotionMasterId": 2,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
