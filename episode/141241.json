            "EpisodeMasterId": 141241,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "千歌",
            "FontSize": 2,
            "Phrase": "看到站在海边的你们两个，我就会想起戏的结局，/n忍不住都快哭出来了！",
            "VoiceFileName": "1412410140",
            "CharacterMotions": [
