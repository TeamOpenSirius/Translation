            "EpisodeMasterId": 141241,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "心菜",
            "FontSize": 2,
            "Phrase": "我小时候遇见静香，后来一直和她玩演戏游戏。/n静香特别会演，一直都是我的榜样。",
            "BgmFileName": "10",
            "VoiceFileName": "1412410190",
            "CharacterMotions": [
