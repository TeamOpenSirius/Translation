            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "蕾的父亲",
            "FontSize": 2,
            "Phrase": "当然有。/n一直抱着不撒手，高高兴兴地跑个不停。",
            "VoiceFileName": "1420720250",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
