            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "宝宝",
            "FontSize": 2,
            "Phrase": "啊呜——！叭啊——，叭啊——！",
            "VoiceFileName": "1420720180",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072020,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "蕾",
            "FontSize": 2,
            "Phrase": "哇，都凑到这么近了……！/n哈哈，看得见吗？我是蕾姐姐哦～？",
            "VoiceFileName": "1420720190",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 202,
                    "BodyMotionMasterId": 6,
                    "LipSyncMasterId": 1,
                    "SpineId": 40401,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "404"
        },
        {
            "Id": 142072021,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "蕾的母亲",
            "FontSize": 2,
            "Phrase": "她最近对什么都特别感兴趣。简直就是好奇心本身。",
            "VoiceFileName": "1420720200",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072022,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "蕾的母亲",
            "FontSize": 2,
            "Phrase": "好啦好啦，不可以哦。碰那里的话会弄坏的。/n来，差不多该回妈妈那边了。",
            "VoiceFileName": "1420720210",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072023,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "蕾",
            "FontSize": 2,
            "Phrase": "那孩子真可爱。/n感觉连我都被治愈了。",
            "VoiceFileName": "1420720220",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 200,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 2,
                    "SpineId": 40401,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "404"
        },
        {
            "Id": 142072024,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "蕾的父亲",
            "FontSize": 2,
            "Phrase": "真让人怀念啊。你小时候，/n圣诞节抱着礼物盒在家里到处跑的样子。",
