            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "蕾",
            "FontSize": 2,
            "Phrase": "诶……有、有过这种事吗。",
            "VoiceFileName": "1420720240",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 4,
                    "SpineId": 40401,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
