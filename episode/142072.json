            "SpeakerIconId": "404"
        },
        {
            "Id": 142072014,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "宝宝",
            "FontSize": 2,
            "Phrase": "嗯——，嘛、嘛——！",
            "VoiceFileName": "1420720130",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072015,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "蕾的母亲",
            "FontSize": 2,
            "Phrase": "是你表姐栞的孩子。听说是个女孩子。",
            "VoiceFileName": "1420720140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072016,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "蕾的母亲",
            "FontSize": 2,
            "Phrase": "栞正在跟其他亲戚打招呼，所以现在先由我来照看，/n这孩子啊，真是精力旺盛得不得了……。",
            "VoiceFileName": "1420720150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072017,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "宝宝",
            "FontSize": 2,
            "Phrase": "哒——！",
            "VoiceFileName": "1420720160",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072018,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "蕾",
            "FontSize": 2,
            "Phrase": "哇，真的。好有精神啊。/n是觉得摄像头很稀奇吗？",
            "VoiceFileName": "1420720170",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 200,
                    "BodyMotionMasterId": 2,
                    "LipSyncMasterId": 2,
                    "SpineId": 40401,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
