            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "蕾的父亲",
            "FontSize": 2,
            "Phrase": "呵，是吗。/n不过啊，爸爸会一直记得。",
            "VoiceFileName": "1420720290",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
