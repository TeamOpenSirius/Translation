            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "宝宝",
            "FontSize": 2,
            "Phrase": "哇！",
            "VoiceFileName": "1420720110",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142072013,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "蕾",
            "FontSize": 2,
            "Phrase": "啊，宝宝……！/n好可爱……。",
            "VoiceFileName": "1420720120",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 505,
                    "BodyMotionMasterId": 4,
                    "LipSyncMasterId": 1,
                    "SpineId": 40401,
                    "CharacterAppearanceType": 0,
