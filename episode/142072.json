            ],
            "SpeakerIconId": "404"
        },
        {
            "Id": 142072043,
            "EpisodeMasterId": 142072,
            "Order": 1,
            "GroupOrder": 43,
            "SpeakerName": "蕾",
            "FontSize": 2,
            "Phrase": "（原来直到现在，我也一直是被他们守护着……才走到了这里啊）",
            "VoiceFileName": "1420720400",
