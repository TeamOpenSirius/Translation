      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "伦子",
      "FontSize": 2,
      "Phrase": "好呀，什么都可以问哦？/n是排练时有什么不明白的吗？",
      "VoiceFileName": "10302070020",
      "CharacterMotions": [
        {
          "slotNumber": 1,
