      "EpisodeMasterId": 1030207,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……总之，实在令人心累。/n光是回想起来肩膀都沉了……。",
      "VoiceFileName": "10302070360",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
