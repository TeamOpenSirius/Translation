      "EpisodeMasterId": 1030207,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "你以前说过要打败我吧。/n拉莫娜。",
      "VoiceFileName": "10302070370",
      "CharacterMotions": [
        {
