            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "谢谢。不过这句话，我就当没听见。/n要是决心一动摇，我恐怕真的再也飞不起来了。",
            "VoiceFileName": "10301010080",
            "CharacterMotions": [
