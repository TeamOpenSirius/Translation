            "EpisodeMasterId": 1030101,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "剧团成员B",
            "FontSize": 2,
            "Phrase": "比起这个，你真的没问题吗？在日本能适应吗？/n那个叫银河座的地方来挖你，真的可信吗？",
            "VoiceFileName": "10301010030",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
