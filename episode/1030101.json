            "EpisodeMasterId": 1030101,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "拉莫娜",
            "FontSize": 2,
            "Phrase": "喂，别说了。/n我好不容易才逼自己不去想这件事。",
            "VoiceFileName": "10301010060",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
