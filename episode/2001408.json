      "EpisodeMasterId": 2001408,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "我是 Sense。是心菜在舞台上需要的装置。/n那时候我觉得，自己就是为了这一天才诞生。",
      "VoiceFileName": "20014080070",
      "CharacterMotions": [
