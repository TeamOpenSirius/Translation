      "EpisodeMasterId": 2006707,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "这是迈向巡回剧团的第一步。/n都给我打起精神来！",
