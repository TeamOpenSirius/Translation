            "EpisodeMasterId": 141412,
            "Order": 1,
            "GroupOrder": 39,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "Yeah——！做了真是太好啦——！",
            "VoiceFileName": "1414120390",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 202,
                    "BodyMotionMasterId": 18,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
