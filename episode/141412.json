        },
        {
            "Id": 141412013,
            "EpisodeMasterId": 141412,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "前几天和电姬平时那帮人一起突袭买回来的——。/n不过说“平时那帮人”也怪，毕竟我跟电姬大家都超熟。",
            "VoiceFileName": "1414120120",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
