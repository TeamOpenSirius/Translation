            "EpisodeMasterId": 141412,
            "Order": 1,
            "GroupOrder": 40,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "你看，网上也有不喜欢这种演法的人。/n所以我就在想，要是有人不喜欢，我想听听具体是哪里不行。",
            "VoiceFileName": "1414120400",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "HeadMotionMasterId": 2,
                    "BodyMotionMasterId": 25,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
