            "SpeakerIconId": "403"
        },
        {
            "Id": 141412014,
            "EpisodeMasterId": 141412,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "还一起搞了高性价比化妆品Tour之类的——。/n麻花甜甜圈超好吃。照片我发SNS了，记得看哦——。",
            "VoiceFileName": "1414120130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 25,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141412015,
            "EpisodeMasterId": 141412,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "评论",
            "FontSize": 2,
            "Phrase": "“电姬对辣妹太友好了，感恩”“这个Tour有直播吗？”/n“对辣妹友好的宅宅原来不是传说”“Nakayopi！”",
