            "EpisodeMasterId": 141412,
            "Order": 1,
            "GroupOrder": 41,
            "SpeakerName": "评论",
            "FontSize": 2,
            "Phrase": "“啊——，是有这种”“他们根本不懂嘛——”“hmmm……”/n“想看那种戏的话去看别的地方不就好了”",
            "VoiceFileName": "1414120410",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141412045,
            "EpisodeMasterId": 141412,
            "Order": 1,
            "GroupOrder": 42,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "不过嘛，喜欢和不喜欢这种事，每个人都会有吧？我也有。",
            "VoiceFileName": "1414120420",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 4,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
