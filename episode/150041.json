            "SpeakerIconId": "401"
        },
        {
            "Id": 150041013,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "望国军官",
            "FontSize": 2,
            "Phrase": "具体属于哪一方势力，目前还不清楚。",
            "VoiceFileName": "1500410120",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041014,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "不管怎样，这都算是个好消息。",
            "VoiceFileName": "1500410130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 1,
                    "SpineId": 40134,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "401"
        },
        {
            "Id": 150041015,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "望国军官",
            "FontSize": 2,
            "Phrase": "但是，也有两个坏消息。",
            "VoiceFileName": "1500410140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041016,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "望国军官",
            "FontSize": 2,
            "Phrase": "首先，各地因为不祥的传闻而陷入混乱。/n据说是什么“星辰汇聚，星之神将降临世间施予救赎”。",
            "VoiceFileName": "1500410150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041017,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "望国军官",
            "FontSize": 2,
            "Phrase": "还有一件。新妻舰队遭到帝国袭击。/n敌方对我方空域的侵攻，显然正在加剧。",
            "VoiceFileName": "1500410160",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041018,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "……请调查敌方地区获得解放的经过，/n以及所谓“星之神”传闻的源头。",
            "VoiceFileName": "1500410170",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 4,
                    "SpineId": 40134,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "401"
        },
        {
            "Id": 150041019,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "另外，立刻召开会议。/n我们必须完善防御体系，并预测敌人的动向。",
            "VoiceFileName": "1500410180",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "401"
        },
        {
            "Id": 150041020,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "望国军官",
            "FontSize": 2,
            "Phrase": "是！",
            "VoiceFileName": "1500410190",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041021,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "望国士兵A",
            "FontSize": 2,
            "Phrase": "……负责文书工作的副司令大人又登场了啊。/n今天也要拿预算和时间去做慈善吗？",
            "VoiceFileName": "1500410200",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041022,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "望国士兵B",
            "FontSize": 2,
            "Phrase": "会被听见的。",
            "VoiceFileName": "1500410210",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041023,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "望国士兵A",
            "FontSize": 2,
