            "VoiceFileName": "1500410220",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041024,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "（……如果我也能使用Sense，大家就会信任我吗？/n　而且，如果有Sense的话，那时候姐姐也……）",
