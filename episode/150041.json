            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "帝国有什么大动作吗？",
            "VoiceFileName": "1500410090",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 1,
