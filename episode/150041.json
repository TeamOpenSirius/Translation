        },
        {
            "Id": 150041011,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "望国军官",
            "FontSize": 2,
            "Phrase": "我们收到报告，帝国势力圈中的一处地区，/n被身份不明的人解放了。",
            "VoiceFileName": "1500410100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 150041012,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "身份不明？",
            "VoiceFileName": "1500410110",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 4,
                    "SpineId": 40134,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
