        {
            "Id": 150041002,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "（可是……在帝国统治下，我们家没落了。/n　本来，我们应该就这样迎来被肃清的命运……）",
            "VoiceFileName": "1500410020",
            "CharacterMotions": [],
            "SpeakerIconId": "401"
        },
        {
            "Id": 150041003,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "（但姐姐拥有成为士兵的能力。/n　正因为姐姐以帝国士兵的身份效力，千寿家才免于肃清。）",
            "VoiceFileName": "1500410030",
            "CharacterMotions": [],
            "SpeakerIconId": "401"
        },
        {
            "Id": 150041004,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "（我是……牺牲了姐姐，才活下来的。/n　如果当时的我能更有力量……姐姐也不会……）",
            "VoiceFileName": "1500410040",
            "CharacterMotions": [],
            "SpeakerIconId": "401"
        },
        {
            "Id": 150041005,
            "EpisodeMasterId": 150041,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "（所以至少，我希望姐姐能够幸福……。/n　我愿意相信，她正在这个世界的某处健康地生活着……）",
            "VoiceFileName": "1500410050",
            "CharacterMotions": [],
            "SpeakerIconId": "401"
        },
