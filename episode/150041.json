            "Order": 1,
            "GroupOrder": 1,
            "SpeakerName": "伊吕波",
            "FontSize": 2,
            "Phrase": "（我以前，有一位关系很好的姐姐。）",
            "BackgroundImageFileName": "1050",
            "BgmFileName": "304",
