      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "我知道。正因为知道，我才不想让你勉强自己。/n先休息恢复，之后再继续。",
      "VoiceFileName": "10302100230",
      "CharacterMotions": [
