      "GroupOrder": 31,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（我究竟一直在看什么呢。/n　这个世界……银河座……原来是如此严酷的地方）",
      "BgmFileName": "204",
      "VoiceFileName": "20007030280",
