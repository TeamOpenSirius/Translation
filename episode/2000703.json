    },
    {
      "Id": 2000703033,
      "EpisodeMasterId": 2000703,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（我缺少了身为追求高处之人的自觉。/n　也一定因此伤害了她）",
      "VoiceFileName": "20007030290",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2000703034,
      "EpisodeMasterId": 2000703,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（甚至还让她答应要和我一起站上舞台。/n　我……实在太浅薄了）",
      "VoiceFileName": "20007030300",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2000703035,
      "EpisodeMasterId": 2000703,
