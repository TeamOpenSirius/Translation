      "EpisodeMasterId": 2000703,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "是关于今野的……。",
      "VoiceFileName": "20007030120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
