    "Title": "奔赴下一舞台",
    "EpisodeDetail": [
        {
            "Id": 1020424001,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 1,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "普罗米修斯为被黑暗笼罩的世界带来了火种，照亮世间。",
            "BackgroundImageFileName": "1170",
            "BgmFileName": "405",
            "VoiceFileName": "10204240010",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424002,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "本奖项将颁给打破戏剧界常识、/n在我们心中点燃永不熄灭激情之火的剧团。",
            "VoiceFileName": "10204240020",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424003,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "本年度，拓展戏剧边界、向观众灵魂投下尖锐一石的……/n正是这个剧团。",
            "VoiceFileName": "10204240030",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424004,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "第34届普罗米修斯奖得主——剧团Eden！/n恭喜各位！",
            "VoiceFileName": "10204240040",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424005,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "将《蓝胡子》这一故事所包含的暴力性与扭曲之爱，以独到解读与原创演出/n升华为全新的剧目，这份手腕只能用精彩来形容。",
            "VoiceFileName": "10204240050",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424006,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "那压倒性的创造力甚至消除了舞台与观众席之间的界限，/n带给我们超越语言的冲击。",
            "VoiceFileName": "10204240060",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424007,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "那么，接下来有请剧团代表——连尺野初魅女士。/n请登上舞台。",
            "VoiceFileName": "10204240070",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424008,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "主持人",
            "FontSize": 2,
            "Phrase": "各位，请再次以点燃赞美之火般的热烈掌声欢迎她！",
            "VoiceFileName": "10204240080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020424009,
            "EpisodeMasterId": 1020424,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "非常感谢。/n能够站在这样的场合，我深感荣幸。",
            "VoiceFileName": "10204240090",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 1,
