      "Order": 1,
      "GroupOrder": 70,
      "SpeakerName": "望有",
      "FontSize": 2,
      "Phrase": "（那些孩子已经不再需要一个只会指导演技的指导者了……）",
      "BackgroundCharacterImageFileName": "142510_0",
      "VoiceFileName": "10501180640",
      "CharacterMotions": [],
