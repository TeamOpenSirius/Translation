    },
    {
      "Id": 1050118071,
      "EpisodeMasterId": 1050118,
      "Order": 1,
      "GroupOrder": 71,
      "SpeakerName": "望有",
      "FontSize": 2,
      "Phrase": "（相反，她们如今真正需要的，是已经见过Dai Star顶峰光芒之人，/n　在舞台上展现给她们看的背影……）",
      "BackgroundCharacterImageFileName": "142510_0",
      "VoiceFileName": "10501180650",
      "CharacterMotions": [],
      "SpeakerIconId": "107"
    },
    {
      "Id": 1050118072,
      "EpisodeMasterId": 1050118,
      "Order": 1,
      "GroupOrder": 72,
      "SpeakerName": "望有",
      "FontSize": 2,
      "Phrase": "这份我一直渴望着的心情……是啊，我果然还是……想再次站上那个舞台。/n和那些孩子一起……。",
      "BackgroundCharacterImageFileName": "142510_0",
