      "EpisodeMasterId": 2006606,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "练得很起劲啊，拉莫娜·沃尔芙。",
      "VoiceFileName": "20066060230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006606024,
      "EpisodeMasterId": 2006606,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "！！？/n您是……！？",
      "VoiceFileName": "20066060240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 507,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 3,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
