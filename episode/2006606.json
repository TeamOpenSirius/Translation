    },
    {
      "Id": 2006606002,
      "EpisodeMasterId": 2006606,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "对啊，而且看在场这些人，基本都是以前工作坊的成员吧。/n该不会～又想重新办工作坊？开玩笑的……。",
      "VoiceFileName": "20066060020",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006606003,
      "EpisodeMasterId": 2006606,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "不，我就是这么打算的。",
      "VoiceFileName": "20066060030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
