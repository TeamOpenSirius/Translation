      "GroupOrder": 37,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "那么，你就证明给我看。/n证明你同样是足以在这片银河中闪耀的第一颗星。",
      "VoiceFileName": "20066060370",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
