      "EpisodeMasterId": 2006606,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "虽然中间空了一段时间，但工作坊还是顺利进行下来了，/n太好了……。",
      "VoiceFileName": "20066060210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
