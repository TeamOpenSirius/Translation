      "GroupOrder": 1,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "怎么了，拉莫娜前辈。/n居然特意让我们来排练场……。",
      "BackgroundImageFileName": "670",
      "BgmFileName": "201",
      "VoiceFileName": "20066060010",
