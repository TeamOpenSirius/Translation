      "SpeakerIconId": "305"
    },
    {
      "Id": 2005102026,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
      "Phrase": "怎么了？/n……啊，难道是你认识的艺人？",
      "VoiceFileName": "20051020230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2005102027,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "何何何止是认识，我超喜欢这个人的歌！/n今天我还在SNS上说我喜欢她……！",
      "VoiceFileName": "20051020240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 501,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 2,
          "LipSyncMasterId": 1,
          "SpineId": 30503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2005102028,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
      "Phrase": "啊，原来如此，所以才会这样吗？",
      "VoiceFileName": "20051020250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2005102029,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
      "Phrase": "其实呢，我们原则上会拒绝舞台以外的工作，/n而且从歌曲风格来说，我本来也觉得和银河座演员的形象不太合。",
      "VoiceFileName": "20051020260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2005102030,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
      "Phrase": "不过对方似乎也很中意与那国小姐，还是点名邀请。/n“希望她自由地、即兴地跳舞”……这是『Libea』的要求。",
      "VoiceFileName": "20051020270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2005102031,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "『Libea』……点名要我？/n自由地、即兴地……。",
      "VoiceFileName": "20051020280",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 30503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2005102032,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
