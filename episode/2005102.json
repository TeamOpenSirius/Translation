      "SpeakerIconId": "1"
    },
    {
      "Id": 2005102022,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "让我，一个人……！？",
      "VoiceFileName": "20051020190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 501,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 30503,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 2005102023,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
      "Phrase": "对。其实负责这支MV的导演，和银河座一直关系不错。/n当然也有这层关系，不过据说这是艺人本人强烈提出的邀请。",
      "VoiceFileName": "20051020200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2005102024,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
      "Phrase": "然后，这些是资料——",
      "VoiceFileName": "20051020210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2005102025,
      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "……！/n不会吧……！？",
      "VoiceFileName": "20051020220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 501,
          "HeadDirectionMasterId": 1,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 1,
          "SpineId": 30503,
          "CharacterAppearanceType": 0,
