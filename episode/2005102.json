      "EpisodeMasterId": 2005102,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "银河座宣传人员",
      "FontSize": 2,
      "Phrase": "是的。不过并不是让你和艺人一起跳，/n对方似乎想加入一段由与那国小姐独自跳舞的镜头。",
      "VoiceFileName": "20051020180",
