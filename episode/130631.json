      "EpisodeMasterId": 130631,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "行吧。我就收下了。",
      "VoiceFileName": "1306310100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "HeadMotionMasterId": 1,
