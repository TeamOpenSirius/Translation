      "Id": 1030407033,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "那么，今天排练到此为止。解散。",
      "VoiceFileName": "10304070320",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
