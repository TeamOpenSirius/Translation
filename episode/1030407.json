      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“唔……！/n　原来如此，这位大人绝非寻常之辈……”",
      "VoiceFileName": "10304070270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 30103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030407029,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "嗯，可以。/n千寿就保持这个状态继续排练。",
      "VoiceFileName": "10304070280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407030,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "是，我明白了。",
      "VoiceFileName": "10304070290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030407031,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "其他人也拿出与千寿刚才相匹配的表演。/n别做会妨碍主演的动作！",
      "VoiceFileName": "10304070300",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407032,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "银河座团员们",
      "FontSize": 2,
