    {
      "Id": 1030407019,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "——你！休息什么！/n会妨碍别人，闪开！别打乱周围的节奏！",
      "VoiceFileName": "10304070180",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407020,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "銀河座劇団員A",
      "FontSize": 2,
      "Phrase": "是……对、对不起……！",
      "VoiceFileName": "10304070190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407021,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "喂，还要我说多少次！/n只是个被牛若斩倒的人，为什么老想着抢风头！",
      "VoiceFileName": "10304070200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407022,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "銀河座劇団員B",
      "FontSize": 2,
      "Phrase": "我没有想抢风头……！",
      "VoiceFileName": "10304070210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407023,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "我没问你的意见。/n我是在让你正确理解我们的演出意图。",
      "VoiceFileName": "10304070220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407024,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "銀河座劇団員B",
      "FontSize": 2,
      "Phrase": "……明白了……。",
      "VoiceFileName": "10304070230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407025,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“啊，我亲爱的孩子。请你重新考虑。决斗这种事，/n　答应母亲今夜就是最后一次吧。母亲的心都快要碎了——”",
      "BackgroundCharacterImageFileName": "141980_0",
      "VoiceFileName": "10304070240",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030407026,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "感情还是完全不够！/n这样根本不可能打动牛若丸！！",
      "VoiceFileName": "10304070250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030407027,
      "EpisodeMasterId": 1030407,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……对不起！/n请让我再来一次！",
      "VoiceFileName": "10304070260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 3,
          "SpineId": 30303,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
