    {
      "Id": 1030314027,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "那时我通过妈妈的介绍，在给杂志当模特。",
      "WindowEffect": 1,
      "VoiceFileName": "10303140220",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030314028,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "星探",
      "FontSize": 2,
      "Phrase": "请允许我自我介绍。/n我是来自日本剧团“银河座”的星探。",
      "WindowEffect": 1,
      "VoiceFileName": "10303140230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030314029,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "银河座的星探一路来到罗瓦涅米见我。/n只凭一张我受邀登上小舞台时拍下的照片。",
      "WindowEffect": 1,
      "VoiceFileName": "10303140240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 11,
          "SpineId": 30421,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030314030,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "那个人告诉我。/n喜欢被大家注视的我，很适合演戏。",
      "WindowEffect": 1,
      "VoiceFileName": "10303140250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 7,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030314031,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "只要站上银河座的舞台，就能让很多鲜活的视线/n感受到美丽的我。",
      "WindowEffect": 1,
      "VoiceFileName": "10303140260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030314032,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 32,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1051",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.30000001192092896,
      "FadeValue2": -1.0,
