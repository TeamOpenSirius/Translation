      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "你真的很喜欢被人看着啊。/n加入银河座，也是因为这个？",
      "VoiceFileName": "10303140200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
