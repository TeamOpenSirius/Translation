    {
      "Id": 1030314033,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "既然这样，我想试试看。",
      "VoiceFileName": "10303140270",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030314034,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "因为我想要那种拍摄时感受不到的兴奋。/n想用美丽的全身，感受人们的目光。",
      "VoiceFileName": "10303140280",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030314035,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 35,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "731",
      "BackgroundImageFileFadeType": 2,
      "SeFileName": "641",
      "CharacterMotions": [],
      "FadeValue1": 0.30000001192092896,
      "FadeValue2": -1.0,
      "FadeValue3": 0.30000001192092896
    },
    {
      "Id": 1030314036,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "这就是我来到银河座的契机。/n这里没有自然，也没有父母，可有很多人会看我，所以我喜欢这里。",
      "VoiceFileName": "10303140290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 30401,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030314037,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "而且，我也喜欢拉莫。/n会像这样过来看我。",
      "VoiceFileName": "10303140300",
