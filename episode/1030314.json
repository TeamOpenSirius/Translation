      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "茶的功效果然世界通用啊。/n你的故乡……罗瓦涅米，是怎样的地方？",
      "VoiceFileName": "10303140140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030314019,
      "EpisodeMasterId": 1030314,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "冬天很冷、很暗。太阳不落的夏天则很暖。/n被雪与绿色包围，是个非常美的地方。",
      "VoiceFileName": "10303140150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
