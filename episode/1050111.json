    },
    {
      "Id": 1050111004,
      "EpisodeMasterId": 1050111,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "雪",
      "FontSize": 2,
      "Phrase": "太震撼了。/n看过那么完美的演技，实在挑不出任何毛病。",
      "VoiceFileName": "10501110040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
