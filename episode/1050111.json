      "SpeakerIconId": "303"
    },
    {
      "Id": 1050111005,
      "EpisodeMasterId": 1050111,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "雪",
      "FontSize": 2,
      "Phrase": "不过身为演员，总不能只在旁边看着就满足吧？/n德国人。",
      "VoiceFileName": "10501110050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
