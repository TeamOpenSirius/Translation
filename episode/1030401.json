  "Order": 1,
  "Prev": null,
  "Next": 1030402,
  "Chapter": "銀河座　4章",
  "Title": "为了即将到来的季节",
  "EpisodeDetail": [
    {
      "Id": 1030401001,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "“距离世界演剧联盟开幕，已经不到1年了！”",
      "BackgroundImageFileName": "1840",
      "BgmFileName": "23",
      "VoiceFileName": "10304010460",
      "CharacterMotions": [],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401002,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "“会场就在东京上野，新建的‘Astrolabe Hall’！”",
      "VoiceFileName": "10304010010",
      "CharacterMotions": [],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401003,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "“……而各位戏剧爱好者，想必已经知道这意味着什么了吧！”",
      "VoiceFileName": "10304010020",
      "CharacterMotions": [],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401004,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "“Horoscope Season到来了！”",
      "VoiceFileName": "10304010030",
      "CharacterMotions": [],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401005,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "虽说也兼有公布新会场的目的，但这排场未免太夸张。/n就算是刚加入评审部不久的丹波小辈，也不至于擅自决定这种事。",
      "VoiceFileName": "10304010040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401006,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "原剧团成员B",
      "FontSize": 2,
      "Phrase": "从无数星辰之中，/n寻找耀眼光芒的季节终于到了。",
      "VoiceFileName": "10304010050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401007,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "原剧团成员C",
      "FontSize": 2,
      "Phrase": "星盘所描绘出的命运图案……/n这次会有人得到指引吗？",
      "VoiceFileName": "10304010060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401008,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "必须有人出现才行。/n——银河座这时候应该也收到来自巴黎的书函了。",
      "VoiceFileName": "10304010070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401009,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "是。/n和往年一样，下次公演似乎会有评审前来视察。",
      "VoiceFileName": "10304010080",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401010,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "世界演剧联盟方面表示，为推动整个戏剧界的发展，/n希望历史悠久的银河座付出格外的努力，并取得更进一步的飞跃——。",
      "VoiceFileName": "10304010090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401011,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "不用他们说我们也知道。",
      "VoiceFileName": "10304010100",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401012,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "原剧团成员B",
      "FontSize": 2,
      "Phrase": "希望你们拿出最好的选角、最好的演出、最顶级的舞台。/n这和在Saint-Cloud争夺星可不是一回事。",
      "VoiceFileName": "10304010110",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401013,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "……当然，我明白。",
      "VoiceFileName": "10304010120",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401014,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "原剧团成员B",
      "FontSize": 2,
      "Phrase": "我们长久以来一直为至高舞台点亮光芒。/n为的就是彰显银河座的权威。",
      "VoiceFileName": "10304010130",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401015,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "原剧团成员C",
      "FontSize": 2,
      "Phrase": "可是，后辈要是只会依赖前人的威光也很麻烦。/n得有人亲自登上星之座才行。对吧？",
      "VoiceFileName": "10304010140",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401016,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "从银河座，诞生下一位Dai Star。/n让天空亮起新的光芒。",
      "VoiceFileName": "10304010150",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401017,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 17,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1030401018,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "……新的光芒。下一位Dai Star吗……。",
      "VoiceFileName": "10304010160",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401019,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "最近几乎每天都在听这句话呢。",
      "VoiceFileName": "10304010170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401020,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "今晚恐怕也得再听一遍。/n因为还有和后援会的聚餐。",
      "VoiceFileName": "10304010180",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401021,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "连续这么多天，真让人头痛……。",
      "VoiceFileName": "10304010190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401022,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "话说回来，下次公演有眉目了吗？/n日程可没法改。",
      "VoiceFileName": "10304010200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401023,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "说实话，演出会议进展得相当艰难。/n毕竟是要邀请世界演剧联盟评审来看的舞台。",
      "VoiceFileName": "10304010210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401024,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "还要考虑选角，/n所以在选择作品上不得不慎之又慎。",
      "VoiceFileName": "10304010220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401025,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "……主演只要适合角色，谁都可以。/n但就像运营会议上说过的，招牌演员的出场绝不能让。",
      "VoiceFileName": "10304010230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401026,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "我知道。/n那些大人物想必也是这么希望的。",
      "VoiceFileName": "10304010240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401027,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "银河座应该推出的下一位Dai Star候选……/n如今值得由我们推到台前的人，除了她没有别人。",
      "VoiceFileName": "10304010250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401028,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "拜托你了。/n千万别做出惹高层不高兴的事——",
      "VoiceFileName": "10304010260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401029,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 29,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "40",
      "CharacterMotions": []
    },
    {
      "Id": 1030401030,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "哦。说曹操曹操到，是来催促的电话吗？/n还是赞助企业或媒体又提什么要求。",
      "VoiceFileName": "10304010270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401031,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "银河座宣传负责人",
      "FontSize": 2,
      "Phrase": "……不。看来是从巴黎打来的。",
      "VoiceFileName": "10304010280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401032,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 32,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "121",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1030401033,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "——不只是发书函，还特意从总部打电话过来？",
      "VoiceFileName": "10304010290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 52201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401034,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "如果事先告诉我，我明明可以替你们传话，/n直接转告银河座运营。",
      "VoiceFileName": "10304010300",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401035,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "竟然如此郑重地对待他们啊。/n不过，考虑到那个剧团的成绩，也理所当然。",
      "VoiceFileName": "10304010310",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401036,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "是。票已经安排好了。/n视察按原计划进行。",
      "VoiceFileName": "10304010320",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401037,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 37,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "1670",
      "CharacterMotions": []
    },
    {
      "Id": 1030401038,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "……诞生过无数Dai Star的银河座。/n星之卵虽多，却也有许多光芒被过于严酷的重力压垮。",
      "VoiceFileName": "10304010330",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 52201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401039,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "在被传统与纪律束缚的环境中存活下来的孩子们，会有怎样的光芒，/n就让我好好看个清楚吧。",
      "VoiceFileName": "10304010340",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030401040,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 40,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "670",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "203",
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 1030401041,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 41,
      "SpeakerName": "银河座团员A",
      "FontSize": 2,
      "Phrase": "315……316……317……！",
      "VoiceFileName": "10304010350",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401042,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 42,
      "SpeakerName": "银河座团员B",
      "FontSize": 2,
      "Phrase": "喂……！按与那国前辈的标准做力量训练，/n不会影响排练吗……！？",
      "VoiceFileName": "10304010360",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401043,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 43,
      "SpeakerName": "银河座团员A",
      "FontSize": 2,
      "Phrase": "少废话。沃尔芙前辈不是每天都在教我们吗？/n了解彼此、相互配合才是最重要的。",
      "VoiceFileName": "10304010370",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401044,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 44,
      "SpeakerName": "银河座团员A",
      "FontSize": 2,
      "Phrase": "来，想起与那国前辈说过的话！/n预备——把自己逼到极限……就能突破极限……！",
      "VoiceFileName": "10304010380",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030401045,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 45,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（……我还在想工作坊里究竟在做什么。/n　看来还是该阻止一下吧）",
      "VoiceFileName": "10304010390",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 11,
          "SpineId": 30103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030401046,
      "EpisodeMasterId": 1030401,
      "Order": 1,
      "GroupOrder": 46,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（拉莫娜她们……似乎不在这里）",
      "VoiceFileName": "10304010400",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 6,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
