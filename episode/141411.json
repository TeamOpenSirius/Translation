            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 48,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "就是Tour那次。我去问能不能一次订一批座位，/n她们还特地在开演前来跟我们打招呼。",
            "VoiceFileName": "1414110460",
            "CharacterMotions": [],
