            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 49,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "哇，她们还做了这种事！太感谢了～！",
            "VoiceFileName": "1414110470",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 502,
                    "BodyMotionMasterId": 5,
                    "LipSyncMasterId": 3,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
