            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 51,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "对啊～。虽然也有吓人的时候，但该拍板的时候说话特别有气势，/n真的超帅。超级Respect。神中神。",
            "VoiceFileName": "1414110490",
            "CharacterMotions": [
