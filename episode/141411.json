        {
            "Id": 141411004,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "今天天气好，暖洋洋的，很舒服吧。",
            "VoiceFileName": "1414110020",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411005,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "真的。坐走廊边喝茶简直爽爆～。/n感觉世界和平都被保证了～。",
            "VoiceFileName": "1414110030",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
