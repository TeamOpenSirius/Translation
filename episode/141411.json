            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411006,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "还有大判烧。",
            "VoiceFileName": "1414110040",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411007,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "啊，和尚你是这么叫的？",
            "VoiceFileName": "1414110050",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 500,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411008,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "就是那个吧，不同地方叫法会不一样。",
            "VoiceFileName": "1414110060",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411009,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "对对。电姬里有时候会瞬间开战，搞得群雄割据一样？",
            "VoiceFileName": "1414110070",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 200,
                    "BodyMotionMasterId": 25,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411010,
            "EpisodeMasterId": 141411,
            "Order": 2,
            "GroupOrder": 9,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "我单纯喜欢“Baked Mochomochō”这个叫法——。听起来超可爱。",
            "VoiceFileName": "1414110071",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411011,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "哈哈哈，真亏有人能想出这么怪的名字。厉害。/n所以你要哪个？红豆馅？",
            "VoiceFileName": "1414110080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411012,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "嗯——，好！今天想吃红豆馅！",
            "VoiceFileName": "1414110090",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 109,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 8,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411013,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "拿去。",
            "VoiceFileName": "1414110100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411014,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "……哈啊～，好吃！跟茶简直绝配。/n就像伊吕波亲和美兔亲那样，比翼连理？",
            "VoiceFileName": "1414110110",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 209,
                    "BodyMotionMasterId": 6,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411015,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "你这么说又要开战了。/n馒头、羊羹，配茶的东西多得是。",
            "VoiceFileName": "1414110120",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411016,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "确实！",
            "VoiceFileName": "1414110130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 4,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411017,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "……和尚——。",
            "VoiceFileName": "1414110140",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 70,
                    "BodyMotionMasterId": 25,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411018,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "怎么。",
            "VoiceFileName": "1414110150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411019,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "谢谢你哦。",
            "VoiceFileName": "1414110160",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 106,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 25,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411020,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "嗯。",
            "VoiceFileName": "1414110170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411021,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "现在的我是借了很多人的力量才走到这里，/n和尚也帮过我嘛。",
            "VoiceFileName": "1414110180",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 202,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411022,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "这样啊。",
            "VoiceFileName": "1414110190",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411023,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "诶——，我的感谢没传到吗？我语气很认真的诶。/n再稍微感动一点，不是比较有氛围？",
            "VoiceFileName": "1414110200",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "HeadMotionMasterId": 2,
                    "BodyMotionMasterId": 27,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411024,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "不用啦。老头子嘛，就是这种东西。",
            "VoiceFileName": "1414110210",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411025,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "哪种东西啊。",
            "VoiceFileName": "1414110220",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 7,
                    "LipSyncMasterId": 4,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411026,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "能推年轻人一把，就没有比这更开心的事了。",
            "VoiceFileName": "1414110230",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411027,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "那也再来个“感激涕零、感恩戴德”什么的嘛。",
            "VoiceFileName": "1414110240",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 400,
                    "BodyMotionMasterId": 21,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411028,
            "EpisodeMasterId": 141411,
            "Order": 2,
            "GroupOrder": 26,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "啊，“感恩”好像不对。",
            "VoiceFileName": "1414110241",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411029,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "不，说不定也该感恩。",
            "VoiceFileName": "1414110250",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411030,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "为啥！？",
            "VoiceFileName": "1414110260",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 502,
                    "BodyMotionMasterId": 5,
                    "LipSyncMasterId": 3,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411031,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "因为町内会的活动又填上一项了嘛。电姬Tour。/n演得真不错啊。",
            "VoiceFileName": "1414110270",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411032,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "啊——，就是大家一起来看的那次！我真的超开心！/n你们还买了周边吧！我都看见应援扇了！",
            "VoiceFileName": "1414110280",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 109,
                    "BodyMotionMasterId": 2,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411033,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "大家都感动得不行，说以前那个又小又调皮的卡米拉小鬼也长大了。/n哎呀，那天酒可真喝了不少。",
            "VoiceFileName": "1414110290",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411034,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "呜哇——，这种话重新听一遍，真的超羞耻！",
            "VoiceFileName": "1414110300",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 209,
                    "BodyMotionMasterId": 12,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411035,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 33,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "哈哈哈，明明演完以后你还自己到处问大家感想。",
            "VoiceFileName": "1414110310",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411036,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 34,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "那时候我超怕自己搞的那些创意到底行不行。/n听到大家说“好好玩”，真的幸福死了。",
            "VoiceFileName": "1414110320",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 25,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411037,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 35,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "网上的评价好像也不错嘛。/n挺好啊。就是那个吧，沉浸式剧场的经验派上用场了。",
            "VoiceFileName": "1414110330",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411038,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 36,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "啊——，嗯。",
            "VoiceFileName": "1414110340",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 1,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411039,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 37,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "怎么，说得这么含糊。",
            "VoiceFileName": "1414110350",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 141411040,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 38,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "就是——可能不是所有人都喜欢？",
            "VoiceFileName": "1414110360",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 400,
                    "BodyMotionMasterId": 6,
                    "LipSyncMasterId": 4,
                    "SpineId": 40321,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "403"
        },
        {
            "Id": 141411041,
            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 39,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "看到有人留言说“这是无法靠正统演剧决胜负的剧团电姬的逃避！”/n——那时候我真有点“真的假的”，挺难过的。",
            "VoiceFileName": "1414110370",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "HeadMotionMasterId": 2,
                    "BodyMotionMasterId": 27,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
