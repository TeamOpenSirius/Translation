            "EpisodeMasterId": 141411,
            "Order": 1,
            "GroupOrder": 50,
            "SpeakerName": "和尚",
            "FontSize": 2,
            "Phrase": "真知子是个很了不起的人。/n真要找榜样学习，就学那样的人。",
            "VoiceFileName": "1414110480",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
