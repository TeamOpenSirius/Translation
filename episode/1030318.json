      "EpisodeMasterId": 1030318,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“还在这里。残留在我的双手上。/n　那令人作呕的气味，那污秽的血迹。”",
      "BackgroundImageFileName": "1131",
      "VoiceFileName": "10303180010",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030318002,
      "EpisodeMasterId": 1030318,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“怎么洗都洗不掉，气味也散不去。/n　阿拉伯的香水、高卢的肥皂，都遮不住这双手的污秽。”",
      "VoiceFileName": "10303180020",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030318003,
      "EpisodeMasterId": 1030318,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "（夫人起初比麦克白更强势，/n　可渐渐开始被噩梦折磨）",
      "VoiceFileName": "10303180030",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
