      "SpeakerIconId": "401"
    },
    {
      "Id": 1050120004,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "美兎",
      "FontSize": 2,
      "Phrase": "嗯……不过真的很厉害。听说有好多地方都联系过来，想考虑赞助剧团电姬，/n甚至还要和海外剧团办合作公演……。",
      "VoiceFileName": "10501200040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 40103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 202,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 2,
          "SpineId": 40203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1050120005,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "哇～，光想想就让人兴奋！/n居然有这么多人认识了剧团电姬……我真的好感动！",
      "BackgroundImageFileName": "2251",
      "VoiceFileName": "10501200050",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050120006,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "美兎",
      "FontSize": 2,
      "Phrase": "虽然也有一点点不安，可是……美兔觉得，/n现在还是期待的心情更大一些……。",
      "VoiceFileName": "10501200060",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1050120007,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "今后也为了让更多观众开心，/n一起继续努力吧，美兔亲！",
      "VoiceFileName": "10501200070",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1050120008,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "美兎",
      "FontSize": 2,
      "Phrase": "嗯……！",
      "VoiceFileName": "10501200080",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
