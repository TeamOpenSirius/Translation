        }
      ],
      "SpeakerIconId": "204"
    },
    {
      "Id": 1050120012,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "嗯，我看排练时也一直有这种感觉。/n真让人放心……也变得更强韧了啊，我们的Eden。",
      "VoiceFileName": "10501200110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 0,
