      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "剧团电姬成员们",
      "FontSize": 2,
      "Phrase": "「英语是不是也得学一下啊？」「诶，这也太地狱难度了」/n「只能靠肢体语言硬混过去了吧。」",
      "VoiceFileName": "10501200020",
      "CharacterMotions": [],
