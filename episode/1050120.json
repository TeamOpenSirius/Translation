    {
      "Id": 1050120010,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "关于下一次巡回公演，准备工作进展得还顺利吗？",
      "VoiceFileName": "10501200090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
