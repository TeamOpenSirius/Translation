    {
      "Id": 1050120011,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "容",
      "FontSize": 2,
      "Phrase": "嗯，没问题。/n而且其他人从世界演剧联盟结束后，好像也都彻底燃起来了。",
      "VoiceFileName": "10501200100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 200,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 20401,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
