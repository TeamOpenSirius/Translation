    {
      "Id": 1050120003,
      "EpisodeMasterId": 1050120,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "本来以为世界演剧联盟结束后能稍微轻松下来，/n没想到反而比想象中还忙了呢。",
      "VoiceFileName": "10501200030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 40103,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
