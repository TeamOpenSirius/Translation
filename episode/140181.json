        {
            "Id": 140181018,
            "EpisodeMasterId": 140181,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "对吧！所以请告诉我前辈的尺码！拜托了！",
