        {
            "Id": 140181015,
            "EpisodeMasterId": 140181,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "对！平时前辈很照顾我，我就想知恩图报嘛。/n所以想偷偷送她一件泳装当惊喜！",
            "VoiceFileName": "1401810120",
