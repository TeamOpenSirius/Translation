            "SpeakerIconId": "403"
        },
        {
            "Id": 140181017,
            "EpisodeMasterId": 140181,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "店员",
            "FontSize": 2,
            "Phrase": "——我懂！太懂了！对，就是这样！/n我负责这个卖场两年，从没见过比她更浪费自身条件的泳装选择！",
            "VoiceFileName": "1401810140",
