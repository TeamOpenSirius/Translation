      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "我也是第一次听这个名字。/n那个《桥弁庆》到底讲什么？",
      "VoiceFileName": "10304040060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
