      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "弁庆也留下过那种传说。/n那则故事以《鬼若丸鲤鱼退治》之名为人所知。",
      "VoiceFileName": "10304040360",
      "CharacterMotions": [
