      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "——比叡山僧人武藏坊弁庆听说五条桥出现了厉害的斩人者，/n出于好奇前往桥上，途中遇到受袭者，并听说了怪物的事。",
      "VoiceFileName": "10304040310",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
