      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030404007,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "它以日本自古流传的传说为基础，/n是传统艺能中的一个经典剧目。",
      "VoiceFileName": "10304040070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404008,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "故事的核心人物，名叫武藏坊弁庆——",
      "VoiceFileName": "10304040080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404009,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "啊！弁庆就是那个弁庆吧！/n“弁庆的痛处”！",
      "VoiceFileName": "10304040090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 202,
          "BodyMotionMasterId": 2,
          "LipSyncMasterId": 2,
          "SpineId": 30501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030404010,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "呵呵，那说的是胫骨吧？",
      "VoiceFileName": "10304040100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 30501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030404011,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "对对！小腿胫骨！/n一提弁庆，大家都说那里是他的弱点！",
      "VoiceFileName": "10304040110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 10,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030404012,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "不过，那终究只是比喻。/n意思是再怎么强大的豪杰，也会有弱点与要害。",
      "VoiceFileName": "10304040120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404013,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "说起来，我以前在日本史书上看到的弁庆，/n是个杀人后夺取刀剑收藏起来的粗暴僧侣。",
      "VoiceFileName": "10304040130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030404014,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "为了达成千人斩，/n还会袭击经过京都五条桥的人。",
      "VoiceFileName": "10304040140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030404015,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "拉莫姐好了解！",
      "VoiceFileName": "10304040150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 202,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 2,
          "SpineId": 30501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030404016,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "被银河座发掘的时候，我查过过去的公演。/n《桥弁庆》也是传统剧目，所以稍微研究过一些。",
      "VoiceFileName": "10304040160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030404017,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "……很有拉莫的风格。",
      "VoiceFileName": "10304040170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 202,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 30401,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030404018,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "银河座要演这种粗暴家伙的故事啊。/n话说回来，最后怎么样？",
      "VoiceFileName": "10304040180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030404019,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "我读过的故事里，弁庆被听闻斩人传闻而赶来的/n一个名叫牛若丸的人打败，之后成为了他的随从。",
      "VoiceFileName": "10304040190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 1,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030404020,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "那就是大家通常熟知的武藏坊弁庆与牛若丸。/n不过……《桥弁庆》稍微有些不同。",
      "VoiceFileName": "10304040200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404021,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "哦，是吗。/n话说中途冒出来的牛若丸又是谁？",
      "VoiceFileName": "10304040210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030404022,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "幼名牛若丸……/n真名叫源义经，是日本的武将。",
      "VoiceFileName": "10304040220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404023,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "关于他留下的史料并不多，/n所以如今大家所熟知的大部分故事，都是后世润色的虚构。",
      "VoiceFileName": "10304040230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404024,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "看来我读到的，也正是经过润色的弁庆与牛若丸故事。",
      "VoiceFileName": "10304040240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030404025,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "那个版本更广为人知，但作为能乐剧目流传的/n《桥弁庆》中，在五条桥袭击行人的其实是牛若丸。",
      "VoiceFileName": "10304040250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 1,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404026,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "哦。/n也就是说，和大众熟知的版本相比，弁庆与牛若丸的立场反过来了。",
      "VoiceFileName": "10304040260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 70,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030404027,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "可以这么理解。/n而银河座版《桥弁庆》还加入了讨伐妖怪的元素。",
      "VoiceFileName": "10304040270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030404028,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "嗯……？到底什么意思？抱歉千寿历，/n能不能把银河座《桥弁庆》的剧情简单概括一下！",
      "VoiceFileName": "10304040280",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 30301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030404029,
      "EpisodeMasterId": 1030404,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "我也开始混乱了……！《桥弁庆》里闹事的是牛若丸，/n银河座版里还会再出现妖怪……？",
      "VoiceFileName": "10304040290",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
