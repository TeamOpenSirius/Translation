      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "知冴",
      "FontSize": 2,
      "Phrase": "好厉害啊，静香。/n看得连我的胸口都跟着疼起来了……。",
      "VoiceFileName": "20031070210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 10603,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "106"
    },
    {
      "Id": 2003107024,
      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "（可是，我没办法放弃。/n　在那趟新干线上，我再一次和心菜相遇了）",
      "VoiceFileName": "20031070220",
      "CharacterMotions": [
