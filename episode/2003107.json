      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "（为了让心菜成为World Dai Star，/n　我才诞生于此。因为我已经决定，一定要完成这份使命……！）",
      "VoiceFileName": "20031070230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 104,
          "BodyMotionMasterId": 9,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "102"
    },
    {
