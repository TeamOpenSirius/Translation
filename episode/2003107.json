      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "（我是从心菜那里诞生的Sense。/n　在这个世界上，我从没见过和自己完全相同的存在）",
      "VoiceFileName": "20031070080",
      "CharacterMotions": [
