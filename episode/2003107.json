          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 14,
          "SpineId": 10203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "102"
    },
    {
