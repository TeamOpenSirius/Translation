      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "知冴",
      "FontSize": 2,
      "Phrase": "咦……这是从镜子里挣脱出来的表演吗？",
      "VoiceFileName": "20031070240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 10603,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "106"
    },
    {
