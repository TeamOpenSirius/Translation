      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "嗯。她正在试图走出封闭的世界。/n……气氛和刚才不一样了。即使痛苦挣扎，也在继续向前。",
      "VoiceFileName": "20031070250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 10303,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "103"
    },
    {
      "Id": 2003107028,
      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "（然后……总有一天，我想站到和心菜相同的地方。/n　和心菜一起，在舞台上强烈地闪耀）",
      "VoiceFileName": "20031070260",
      "CharacterMotions": [
