    {
      "Id": 2003107011,
      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "（静香躺到了地板上。她打算表现什么？/n　蜷缩着沉睡的姿势，像是胎儿——）",
      "VoiceFileName": "20031070100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 111,
          "BodyMotionMasterId": 7,
          "SpineId": 10303,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "103"
    },
    {
      "Id": 2003107012,
      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "（第一次醒来时，我根本不知道自己究竟是什么。",
      "VoiceFileName": "20031070110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "HeadDirectionMasterId": 4,
          "BodyMotionMasterId": 13,
