      "EpisodeMasterId": 2003107,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "静香",
      "FontSize": 2,
      "Phrase": "（……我只有心菜一个人。）",
      "VoiceFileName": "20031070090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "BodyMotionMasterId": 25,
