    },
    {
      "Id": 2006901004,
      "EpisodeMasterId": 2006901,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "啊～～～～真是的！所以我不是说了吗！！/n对面三个人一起压过来，我们这边还少个人，怎么可能赢嘛！！",
      "VoiceFileName": "20069010030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 300,
          "BodyMotionMasterId": 10,
          "LipSyncMasterId": 3,
