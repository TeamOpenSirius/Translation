      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 57,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "从公演定下来之后，/n我一直都在思考。",
      "VoiceFileName": "10302200480",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
