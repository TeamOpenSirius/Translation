      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 62,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "……虽然还是不能完全释怀，但我姑且理解。",
      "VoiceFileName": "10302200530",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
