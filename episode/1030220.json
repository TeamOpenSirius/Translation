    {
      "Id": 1030220013,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "令人想起演剧黄金时代的名演，《银河铁道之夜》。/n她们是否能成为引领演剧界的北极星——",
      "VoiceFileName": "10302200110",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030220014,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "原剧团成员C",
      "FontSize": 2,
      "Phrase": "真是写得漂亮啊。/n这位评论家老师可是出了名的毒舌，平时几乎不夸人。",
      "VoiceFileName": "10302200120",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030220015,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "实在过誉。",
      "VoiceFileName": "10302200130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030220016,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "原剧团成员B",
      "FontSize": 2,
      "Phrase": "可以暂时收起翅膀休息，但绝不能满足于此。/n继续振翅高飞吧，无论多远。去追求更遥远的高处。",
      "VoiceFileName": "10302200140",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030220017,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "养精蓄锐，勇猛果敢地继续前进。/n银河就托付给年轻一代了。拜托你了，千寿历。",
      "VoiceFileName": "10302200150",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030220018,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "当然，我会继续回应各位的期待。/n因为，这才是银河座。",
      "VoiceFileName": "10302200160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
