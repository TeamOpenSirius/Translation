      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（《银河铁道之夜》顺利完成了首演）",
      "VoiceFileName": "10302200060",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030220008,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（德国用一个烦人到极点的扎内利回应了乔班尼，/n　连她之前苦恼的捕鸟人，也成功演出了自己的味道）",
      "VoiceFileName": "10302200070",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030220009,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（芬兰则用她的美，把短短的出场时间一路压了过去。/n　甚至比主演更吸引视线，是绝不能大意的演技）",
      "VoiceFileName": "10302200080",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030220010,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（绯花里把和自身形象完全相反的青年演得很出色。/n　甚至让导演罕见地送上掌声。以后肯定又会变成难缠的对手）",
      "VoiceFileName": "10302200090",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030220011,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "（至于千寿历——）",
      "VoiceFileName": "10302200100",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030220012,
      "EpisodeMasterId": 1030220,
      "Order": 1,
      "GroupOrder": 12,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1460",
      "BackgroundImageFileFadeType": 1,
