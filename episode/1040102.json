      "EpisodeMasterId": 1040102,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "因为我没有“Sense”。/n我演戏一直演到小学，但之后就彻底放弃了。",
      "VoiceFileName": "10401020190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 40102,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1040102024,
      "EpisodeMasterId": 1040102,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "真知子",
      "FontSize": 2,
      "Phrase": "既然已经放弃过一次，为什么又会想加入电姬？",
      "VoiceFileName": "10401020200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 40701,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "407"
    },
    {
      "Id": 1040102025,
      "EpisodeMasterId": 1040102,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "是。我上初中以后彻底迷上了漫画。/n到高中又和美兔……啊，就是旁边的白丸美兔小姐特别投缘！",
      "VoiceFileName": "10401020210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 40102,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
