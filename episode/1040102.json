      "EpisodeMasterId": 1040102,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "然后前段时间我们参加了Cosplay活动，/n在那里拿到电姬的宣传单，去看了舞台之后――整个人“轰”地一下！",
      "VoiceFileName": "10401020220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "BodyMotionMasterId": 2,
          "LipSyncMasterId": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
