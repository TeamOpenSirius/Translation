    },
    {
      "Id": 1040102022,
      "EpisodeMasterId": 1040102,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "真知子",
      "FontSize": 2,
      "Phrase": "为什么来电姬？/n我想知道，你没有选择和姐姐一样去银河座的理由。",
      "VoiceFileName": "10401020180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 40701,
          "CharacterAppearanceType": 0,
