      "SpeakerIconId": "201"
    },
    {
      "Id": 2000707009,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "剧本的基调、角色方向都已经传达过。/n我是在说，不要演出偏离既定轨道的东西。",
      "VoiceFileName": "20007070090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2000707010,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "可真正饰演角色、共同创造舞台的是演员。",
