    },
    {
      "Id": 2000707003,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "你刚才是带着怎样的心情在演麦克白？",
      "VoiceFileName": "20007070030",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2000707004,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "麦克白本就多少怀有野心。/n被欲望驱使完成暗杀之后，再后悔也毫无意义。",
      "VoiceFileName": "20007070040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 20101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 2000707005,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "亲手杀死侍奉的国王所带来的兴奋，以及即将成为王的期待，/n他的情绪里反而应该混杂着高昂。",
      "VoiceFileName": "20007070050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "201"
    },
    {
      "Id": 2000707006,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "……原来如此。/n在失去理智、陷入错乱的同时，又因期待未来而亢奋的麦克白。",
      "VoiceFileName": "20007070060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2000707007,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "但银河座的演出方案里没有这种麦克白。/n再来一次，这次按要求的氛围演。",
      "VoiceFileName": "20007070070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2000707008,
      "EpisodeMasterId": 2000707,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "初魅",
      "FontSize": 2,
      "Phrase": "……你说什么？",
      "BgmFileName": "7",
      "VoiceFileName": "20007070080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 3,
