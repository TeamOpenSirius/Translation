            "EpisodeMasterId": 142162,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "前阵子也和伊吕波亲她们聊过……/n果然主角桃乐丝感觉特别适合美兔亲啊～。",
