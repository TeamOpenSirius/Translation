        },
        {
            "Id": 34026504,
            "EpisodeType": 5,
            "CharacterId": 106,
            "SpeakerName": "",
            "Description": "别小看我啊，潘达。/n今天可是重要的日子，所以我提前把各种事情都处理好了。",
            "Order": 4
        },
        {
            "Id": 34026505,
