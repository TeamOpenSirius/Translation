    },
    {
      "Id": 1030422049,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 49,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“驱散这桥下深沉的黑暗！”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220410",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422050,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 50,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundCharacterImageFileName": "142100_0",
      "SeFileName": "3240",
      "CharacterMotions": []
    },
    {
      "Id": 1030422051,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 51,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“疲惫的双翼，残缺的刀刃……/n　凭你们，还剩什么力量能讨伐妾身。”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220420",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422052,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 52,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“就算我的翅膀折断――”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220430",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422053,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 53,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“就算我的刀刃崩缺！/n　我们还有彼此信任的心！”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220440",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422054,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 54,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“所谓心意，不过是虚妄！”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220450",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422055,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 55,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（莉莉亚·库尔特贝。真可谓魔性的美丽。/n　而弁庆与牛若历经重重戏份，也丝毫不显疲态。）",
      "BackgroundImageFileName": "663",
      "VoiceFileName": "10304220460",
