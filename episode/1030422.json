        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030422002,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（传统剧目之一《桥弁庆》。/n　就让我看看银河座积淀至今的历史吧。）",
      "BackgroundImageFileName": "663",
      "VoiceFileName": "10304220020",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "BodyMotionMasterId": 7,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030422003,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 3,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "650",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.10000000149011612,
      "FadeValue2": 0.20000000298023224,
      "FadeValue3": 0.10000000149011612
    },
    {
      "Id": 1030422004,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“这是以武力决定人的价值的时代。/n　正因如此，我才要前行。”",
      "VoiceFileName": "10304220030",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422005,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“就让我看看，我这把刀究竟能伤那怪物几分。/n　今夜，我便叩响修罗之门。”",
      "VoiceFileName": "10304220040",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422006,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“然而近来在五条桥，/n　几乎每晚都有人遭到斩杀。”",
      "VoiceFileName": "10304220050",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030422007,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“那正合我意！我这就前往五条桥，/n　亲手打倒传闻中的斩人魔。”",
      "VoiceFileName": "10304220060",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422008,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "“……还请千万不要大意。”",
      "VoiceFileName": "10304220070",
      "CharacterMotions": [],
      "SpeakerIconId": "302"
    },
    {
      "Id": 1030422009,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 9,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "663",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.10000000149011612,
      "FadeValue2": 0.20000000298023224,
      "FadeValue3": 0.10000000149011612
    },
    {
      "Id": 1030422010,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（真是充满厚重感的弁庆。这就是引领银河座的主星。/n　千寿历，演技果然名不虚传。）",
      "VoiceFileName": "10304220080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 3,
          "SpineId": 52201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030422011,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（饰演忍者的拉莫娜·沃尔芙也很有存在感。/n　并非只是服从，而是用短短几句台词表现出对主君力量的信赖……）",
      "VoiceFileName": "10304220090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 7,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030422012,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 12,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "663",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.10000000149011612,
      "FadeValue2": 0.20000000298023224,
      "FadeValue3": 0.10000000149011612
    },
    {
      "Id": 1030422013,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“啊，我心爱的孩子。求你再考虑一下。决斗这种事，/n　答应母亲，今夜就是最后一次吧。母亲的心都快碎了――”",
      "VoiceFileName": "10304220100",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030422014,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“我明白。……可是，父亲的遗恨，/n　我绝不会忘记。”",
      "VoiceFileName": "10304220110",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422015,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“即便为了将来走上母亲所期望的佛道，/n　……也请给我一点时间，让我完成此名所背负的使命。”",
      "VoiceFileName": "10304220120",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422016,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“纵使剑折，心亦不可折。/n　总有一日，我要成为无愧于此名的强者……我已如此立誓。”",
      "VoiceFileName": "10304220130",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422017,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "“这便是你绝不退让的心意……那我只许你这一夜。/n　还请不要违背约定。待夜深之后，便回寺中去。”",
      "VoiceFileName": "10304220140",
      "CharacterMotions": [],
      "SpeakerIconId": "303"
    },
    {
      "Id": 1030422018,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（牛若的回忆……与弁庆和随从的场景相互映照，/n　是母子之间未能实现的誓言。）",
      "VoiceFileName": "10304220150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 3,
          "SpineId": 52201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030422019,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（竟能把义经复杂微妙的心绪表现得如此出色……/n　绯花里，比我想象得还要厉害。）",
      "VoiceFileName": "10304220160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 7,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030422020,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 20,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "650",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.10000000149011612,
      "FadeValue2": 0.20000000298023224,
      "FadeValue3": 0.10000000149011612
    },
    {
      "Id": 1030422021,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 21,
      "FontSize": 2,
      "Phrase": "",
      "SeFileName": "3240",
      "CharacterMotions": []
    },
    {
      "Id": 1030422022,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“要我报上名号吗，斩人魔。那就听好了。/n　我正是于比叡山修行的僧兵，武藏坊弁庆！”",
      "VoiceFileName": "10304220170",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422023,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“如随风起舞，如潜入暗影――”",
      "VoiceFileName": "10304220180",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422024,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“躲开了吗，你这斩人怪物！”",
      "VoiceFileName": "10304220190",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422025,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 25,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "663",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.10000000149011612,
      "FadeValue2": 0.20000000298023224,
      "FadeValue3": 0.10000000149011612
    },
    {
      "Id": 1030422026,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "观众A",
      "FontSize": 2,
      "Phrase": "弁庆的打斗，好有魄力……！",
      "VoiceFileName": "10304220200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030422027,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "观众B",
      "FontSize": 2,
      "Phrase": "牛若丸也好帅……",
      "VoiceFileName": "10304220210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030422028,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（正因为彼此相信对方的实力，才能完成这样的杀阵。/n　她们究竟排练了多久，又彼此磨炼了多少呢。）",
      "VoiceFileName": "10304220220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 3,
          "SpineId": 52201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030422029,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 29,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "650",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.10000000149011612,
      "FadeValue2": 0.20000000298023224,
      "FadeValue3": 0.10000000149011612
    },
    {
      "Id": 1030422030,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“不以刀刃逞强，而以道理使人折服……/n　此乃真正身负天命之人。弁庆，终于领悟了。”",
      "VoiceFileName": "10304220230",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422031,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“若能如愿，今后愿侍奉于您身侧――”",
      "VoiceFileName": "10304220240",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422032,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“弁庆。你也是真正的武人。/n　我会回应你的忠义。”",
      "VoiceFileName": "10304220250",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422033,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“事到如今，已无须再隐瞒。/n　我乃源氏……源牛若。”",
      "VoiceFileName": "10304220260",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422034,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“源氏之子……！？/n　像您这样的人，为何会做出斩杀行人的事！？”",
      "VoiceFileName": "10304220270",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422035,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“一切，都是为了修炼成无愧于源氏之名的剑士……”",
      "VoiceFileName": "10304220280",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422036,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“可是，我只与强者交锋。/n　你口中那些被斩杀的人，并非我所为……”",
      "VoiceFileName": "10304220290",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422037,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 37,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1050",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.10000000149011612,
      "FadeValue2": 0.20000000298023224,
      "FadeValue3": 0.10000000149011612
    },
    {
      "Id": 1030422038,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“呵呵……真可笑。/n　什么都不知道，便因结下主从之契而欣喜，何其浅薄。”",
      "VoiceFileName": "10304220300",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422039,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“什么人！？”",
      "VoiceFileName": "10304220310",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422040,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 40,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“舍弃性命乞求爱恋，却因心愿不得实现而投桥自尽。/n　那份怨念的集合，正是妾身……桥姬。”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220320",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422041,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 41,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“妖异的气息……难道说……”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220330",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422042,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 42,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“桥姬。难道在五条桥袭击过路之人的就是你！？”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220340",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422043,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 43,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“被牛若击倒的一千人。/n　连那边的弁庆在内，所有人原本都还活着。”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220350",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422044,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 44,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“……直到被妾身吞噬之前。”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220360",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422045,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 45,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“你这怪物……！”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220370",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422046,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 46,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“源牛若大人。我的主君！/n　此战便是我等的初阵！”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220380",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422047,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 47,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“好，弁庆。借我你的力量。/n　斩断怨念，以此作为我们誓言的证明。”",
      "BackgroundCharacterImageFileName": "142100_0",
      "VoiceFileName": "10304220390",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422048,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 48,
