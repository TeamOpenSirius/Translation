      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 57,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“消失吧，恶鬼！”",
      "VoiceFileName": "10304220470",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422058,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 58,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“唔……！/n　真令人羡慕……结下誓约……能将性命托付给彼此的人……”",
      "VoiceFileName": "10304220480",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422059,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 59,
      "SpeakerName": "莉莉亚",
      "FontSize": 2,
      "Phrase": "“哪怕只有一次也好……/n　我也曾想发自内心地与某个人相伴……”",
      "VoiceFileName": "10304220490",
      "CharacterMotions": [],
      "SpeakerIconId": "304"
    },
    {
      "Id": 1030422060,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 60,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“桥姬……这就是你的真心吗。”",
      "VoiceFileName": "10304220500",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422061,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 61,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“可悲的妖物。”",
      "VoiceFileName": "10304220510",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030422062,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 62,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "“……修罗也好，怨念也好，都是这世间的阴影。/n　往后我们恐怕还会无数次与之相遇。”",
      "VoiceFileName": "10304220520",
      "CharacterMotions": [],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030422063,
      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 63,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "“既然如此，面对阴影时的心，也由主从二人共同承担吧。”",
      "VoiceFileName": "10304220530",
      "CharacterMotions": [],
      "SpeakerIconId": "301"
    },
