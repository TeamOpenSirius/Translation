      "EpisodeMasterId": 1030422,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "（终于到了。我一直在等这一天。）",
      "BackgroundImageFileName": "663",
      "BgmFileName": "201",
      "VoiceFileName": "10304220010",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "BodyMotionMasterId": 11,
