      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "时雨的母亲",
      "FontSize": 2,
      "Phrase": "哎呀，怎么了时雨？居然在叹气……。",
      "VoiceFileName": "10204080030",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1020408004,
      "EpisodeMasterId": 1020408,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "欸！？时雨刚才有叹气吗？/n妈、妈妈一定是听错了……！",
      "VoiceFileName": "10204080040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 12,
          "LipSyncMasterId": 1,
          "SpineId": 20501,
