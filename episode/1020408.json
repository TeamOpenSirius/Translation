      "EpisodeMasterId": 1020408,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "时雨的父亲",
      "FontSize": 2,
      "Phrase": "你们剧团没有听说这方面的事吗？",
      "VoiceFileName": "10204080240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1020408025,
      "EpisodeMasterId": 1020408,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "时雨",
      "FontSize": 2,
      "Phrase": "……好像，没有吧……。",
      "VoiceFileName": "10204080250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 20501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
