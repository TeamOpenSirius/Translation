      "EpisodeMasterId": 1020408,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "时雨的父亲",
      "FontSize": 2,
      "Phrase": "是吗。不过既然是海外来视察，想必不是一般的机会。/n应该也不是随便哪个剧团都能得到的吧。",
      "VoiceFileName": "10204080260",
      "CharacterMotions": [],
