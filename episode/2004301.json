        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301030,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "……。",
      "VoiceFileName": "20043010280",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 25,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301031,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "……嗯，大概就是那种感觉吧。/n好了，别聊我了，赶紧找点东西吃然后回去吧！",
      "VoiceFileName": "20043010290",
      "CharacterMotions": [
