      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "（我也不想特地打断话题，把气氛搞坏。/n　可是……）",
      "VoiceFileName": "20043010270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 13,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
