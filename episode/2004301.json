      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "（不不，我在想什么啊。/n　伊吕波亲她们都很认真，我也一样是认真的）",
      "VoiceFileName": "20043010330",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 511,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 13,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
