  "Title": "厌倦",
  "EpisodeDetail": [
    {
      "Id": 2004301001,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "哎呀～，买到了买到了！又是秋季折扣又是限时特卖，/n便宜到前所未有啊！谢谢你们叫我来！",
      "BackgroundImageFileName": "1240",
      "BgmFileName": "302",
      "VoiceFileName": "20043010010",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 200,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 2,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301002,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "卡米拉的朋友C",
      "FontSize": 2,
      "Phrase": "我们才要谢呢～。/n你平时老是被千亲她们还有剧团排练？给抢走。",
      "VoiceFileName": "20043010020",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301003,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "这个真抱歉啦！",
      "VoiceFileName": "20043010030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 16,
          "LipSyncMasterId": 1,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301004,
      "EpisodeMasterId": 2004301,
      "Order": 2,
      "GroupOrder": 3,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "不过我都退舞蹈部了，你们还愿意像这样约我，真是超级幸运！",
      "VoiceFileName": "20043010031",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301005,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "卡米拉的朋友D",
      "FontSize": 2,
      "Phrase": "诶，话说卡米拉还真在演戏啊？/n舞蹈不是很快就退了吗？",
      "VoiceFileName": "20043010040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301006,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "喂，这说法～！/n我有继续啊，而且舞蹈经验在舞台上也超级有用！",
      "VoiceFileName": "20043010050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 207,
          "BodyMotionMasterId": 10,
          "LipSyncMasterId": 2,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301007,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "街头表演者",
      "FontSize": 2,
      "Phrase": "『那边的小姐！今天是从哪里来的？』",
      "VoiceFileName": "20043010060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301008,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "卡米拉的朋友C",
      "FontSize": 2,
      "Phrase": "那啥？搭讪？/n不对，写着『街头表演进行中』。",
      "VoiceFileName": "20043010070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301009,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "嗯？啊，还真是。/n好像是在随机找路人搭话演戏。",
      "VoiceFileName": "20043010080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301010,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "街头表演者",
      "FontSize": 2,
      "Phrase": "『从宇宙来的！？也就是说你是外星人！？/n　我以前明明只和地球人交往过……』",
      "VoiceFileName": "20043010090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301011,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "街头表演者",
      "FontSize": 2,
      "Phrase": "『不过……喜欢上了也没办法，/n　从宇宙彼方来的外星人小姐，我超级喜欢你！』",
      "VoiceFileName": "20043010100",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301012,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "卡米拉的朋友D",
      "FontSize": 2,
      "Phrase": "哈哈，也太夸张了吧？/n『我喜欢你！』演得也太投入了！笑死。",
      "VoiceFileName": "20043010110",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301013,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "等等，笑死是什么啦～。",
      "VoiceFileName": "20043010120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 1,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301014,
      "EpisodeMasterId": 2004301,
      "Order": 2,
      "GroupOrder": 12,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "确实，演得是稍——微夸张了点……。",
      "VoiceFileName": "20043010121",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 72,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301015,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "卡米拉的朋友C",
      "FontSize": 2,
      "Phrase": "诶？不会卡米拉也演这种吧？",
      "VoiceFileName": "20043010130",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301016,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "不会不会，我再怎么说也没演得这么夸张。/n说到底，我感觉自己也演不了这种类型……。",
      "VoiceFileName": "20043010140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 12,
          "LipSyncMasterId": 1,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301017,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "卡米拉的朋友C",
      "FontSize": 2,
      "Phrase": "也是！电姬不就是那种地下偶像风格吗？/n听说还搞握手会、粉丝见面会什么的。",
      "VoiceFileName": "20043010150",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301018,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "卡米拉的朋友D",
      "FontSize": 2,
      "Phrase": "真的！？卡米拉现在又是杂志模特、又是主播、还是地下偶像？/n我们不知道的时候你都闪闪发光起来啦～。",
      "VoiceFileName": "20043010160",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301019,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "卡米拉的朋友C",
      "FontSize": 2,
      "Phrase": "不过说真的，要在别人面前认真演戏，也太羞耻了，我肯定不行～。/n要是当偶像顺便玩玩，那倒还能理解。",
      "VoiceFileName": "20043010170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301020,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "诶？",
      "BgmFileName": "999",
      "VoiceFileName": "20043010180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 500,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301021,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "卡米拉的朋友D",
      "FontSize": 2,
      "Phrase": "懂！演戏不是一直都要排练吗？/n真想高效率赚钱，还不如直播或者做模特吧？",
      "BgmFileName": "304",
      "VoiceFileName": "20043010190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301022,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "呃，光说赚钱的话可能确实——",
      "VoiceFileName": "20043010200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301023,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "卡米拉的朋友C",
      "FontSize": 2,
      "Phrase": "那就是，不在乎钱，只想留下青春回忆？/n说起来你们班也有跟你同剧团的人吧？",
      "VoiceFileName": "20043010210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301024,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "卡米拉的朋友D",
      "FontSize": 2,
      "Phrase": "啊，那不就真跟文化祭留纪念一样。/n要是跟当初加入舞蹈部一样，凭感觉稍微玩玩，我也能理解。",
      "VoiceFileName": "20043010220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301025,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "卡米拉的朋友C",
      "FontSize": 2,
      "Phrase": "确实。就算很快又腻了，最后说句『好开心～』，/n还能像现在这样和朋友逛街，那也挺好的。",
      "VoiceFileName": "20043010230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2004301026,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "啊——，……哈哈。",
      "VoiceFileName": "20043010240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 40321,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301027,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "（这时候要认真反驳『电姬不是闹着玩的』，感觉也……。/n　……虽说电姬的方针本来就是开心地做）",
      "VoiceFileName": "20043010250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2004301028,
      "EpisodeMasterId": 2004301,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "（我自己也没法保证绝对不会腻，/n　实际上舞蹈就是因为这个才退了……大家会这么说也正常）",
      "VoiceFileName": "20043010260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 25,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
