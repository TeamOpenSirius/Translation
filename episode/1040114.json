      "EpisodeMasterId": 1040114,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "……迫近的恸哭之中闪烁的希望之光，微弱到让人难以攀附。",
      "VoiceFileName": "10401140270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "404"
    },
    {
