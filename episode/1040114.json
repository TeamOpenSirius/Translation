      "EpisodeMasterId": 1040114,
      "Order": 2,
      "GroupOrder": 33,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "但若是为了守护我们的电姬空间，就足以成为赌上性命的理由。",
      "VoiceFileName": "10401140271",
      "CharacterMotions": [
