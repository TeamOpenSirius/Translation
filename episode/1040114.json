      "EpisodeMasterId": 1040114,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "她大概是在审判我们的觉悟吧。/n命运之牌给出的启示，至今仍未改变――",
      "VoiceFileName": "10401140260",
