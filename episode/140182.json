            "EpisodeMasterId": 140182,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "卡米拉",
            "FontSize": 2,
            "Phrase": "虽然没自信她会不会喜欢。/n但让前辈自己挑泳装，绝对太浪费了嘛！",
            "VoiceFileName": "1401820040",
            "CharacterMotions": [
