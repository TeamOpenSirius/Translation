    "EpisodeDetail": [
        {
            "Id": 34024001,
            "EpisodeType": 0,
            "CharacterId": null,
            "SpeakerName": "",
            "Description": "【Birthday Night】卡特莉娜·格利贝尔/n卡特莉娜·格利贝尔/n/n16岁，高中二年级。德国人。/n父母都是 World Dai Star，可谓演剧世家的优等生。原本在德国从事演剧，却因某次事件独自来到日本。/n以惊人集中力带来的爆发性演技为武器，目标是成为史上最强的演员。/n/n年级：高中二年级/n生日：8月4日/n身高：154cm/n兴趣：泡澡/nSense：零之幕间（Konzentration）/n通过超强集中力让时间仿佛变慢。/n不仅能获得爆发性的演技力，也能在极短时间内吸收饰演角色所需的信息。",
            "Order": 1
        },
        {
            "Id": 34024502,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "生日快乐，卡特莉娜！/n收下我的礼物吧！！",
            "Order": 2
        },
        {
            "Id": 34024503,
            "EpisodeType": 5,
            "CharacterId": 103,
            "SpeakerName": "",
            "Description": "突然跑到宿舍门口来，我还以为怎么了，结果就这事啊……。/n话说，你居然还记得我的生日。",
            "Order": 3
        },
        {
            "Id": 34024504,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "说什么呢！这是你的生日……我一刻都没有忘记过！",
            "Order": 4
        },
        {
            "Id": 34024505,
            "EpisodeType": 5,
            "CharacterId": 103,
            "SpeakerName": "",
            "Description": "话虽如此，我们还在同一个剧团的时候，/n可从来没像这样送过礼物吧？",
            "Order": 5
        },
        {
            "Id": 34024506,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "唔，确实……。/n不过那时候……也没办法。",
            "Order": 6
        },
        {
            "Id": 34024507,
            "EpisodeType": 5,
            "CharacterId": 103,
            "SpeakerName": "",
            "Description": "嗯，整个剧团都不是那种氛围。/n尤其是当时。",
            "Order": 7
        },
        {
            "Id": 34024508,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "卡特莉娜……。",
            "Order": 8
        },
        {
            "Id": 34024509,
            "EpisodeType": 5,
            "CharacterId": 103,
            "SpeakerName": "",
            "Description": "别露出那种表情，莫娜小姐。",
            "Order": 9
        },
        {
            "Id": 34024510,
            "EpisodeType": 5,
            "CharacterId": 103,
            "SpeakerName": "",
            "Description": "现在我正像这样收下莫娜小姐的礼物。/n这不就已经说明一切了吗？",
            "Order": 10
        },
        {
            "Id": 34024511,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "……呵呵，也是。/n看来你来到日本后，遇到了很多很好的人啊，卡特莉娜。",
            "Order": 11
        },
        {
            "Id": 34024512,
            "EpisodeType": 5,
            "CharacterId": 103,
            "SpeakerName": "",
            "Description": "彼此彼此吧？那我拆开了。/n……这是睡衣？",
            "Order": 12
        },
        {
            "Id": 34024513,
            "EpisodeType": 5,
            "CharacterId": 302,
            "SpeakerName": "",
            "Description": "嗯，我听说好的演技要从好的睡眠开始。/n你能喜欢的话，我会很高兴……。",
            "Order": 13
        },
        {
            "Id": 34024514,
            "EpisodeType": 5,
            "CharacterId": 103,
            "SpeakerName": "",
            "Description": "嗯，我会好好穿的。/n谢谢你，莫娜小姐。",
            "Order": 14
        }
    ]
}
