      "EpisodeMasterId": 1040105,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "学生B",
      "FontSize": 2,
      "Phrase": "猫足同学，下一个到我！　拜托帮我看看！/n我正在为升学方向发愁！",
      "VoiceFileName": "10401050060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
