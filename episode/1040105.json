      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "学生A",
      "FontSize": 2,
      "Phrase": "哇，真的吗？/n……啊，抱歉，好像有人联系我了。",
      "VoiceFileName": "10401050040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
