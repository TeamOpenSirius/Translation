    {
      "Id": 1040105007,
      "EpisodeMasterId": 1040105,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "学生A",
      "FontSize": 2,
      "Phrase": "――诶，是限定款！？　今天到货！？　嗯，我马上去！/n啊，猫足同学谢谢啦！　下次也帮我占卜哦！",
      "VoiceFileName": "10401050050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
