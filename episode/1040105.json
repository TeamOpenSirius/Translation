      "GroupOrder": 7,
      "SpeakerName": "学生C",
      "FontSize": 2,
      "Phrase": "啊，太狡猾了！　明明我先来的！　我想问打工的事！/n上次我照占卜结果做，结果特别顺利！",
      "VoiceFileName": "10401050070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
