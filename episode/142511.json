            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "同班同学B",
            "FontSize": 2,
            "Phrase": "八惠亲演戏的样子特别棒！/n和平时的八惠亲完全不一样，感觉真的彻底变成了那个角色！",
            "VoiceFileName": "1425110090",
