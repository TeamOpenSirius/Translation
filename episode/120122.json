      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "会员No.0001",
      "FontSize": 2,
      "Phrase": "“如果您因为恶意的话语而受伤，请想起这篇长文。/n　我会用比黑粉强百倍、不，是一亿倍的心意支撑您的背影。”",
      "VoiceFileName": "1201220140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
