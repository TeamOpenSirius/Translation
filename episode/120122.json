          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 120122006,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "……啊，粉丝俱乐部会员发来消息了。",
      "VoiceFileName": "1201220050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 500,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 120122007,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "我看看，没有昵称。会员No.0001。",
      "VoiceFileName": "1201220060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 120122008,
      "EpisodeMasterId": 120122,
      "Order": 2,
      "GroupOrder": 6,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "啊哈哈，又是那位零一先生。",
      "VoiceFileName": "1201220061",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 202,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 120122009,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "会员No.0001",
      "FontSize": 2,
      "Phrase": "“致亲爱的伊吕波大人。/n　我有幸观看了剧团电姬最新作品的首场公演。”",
      "VoiceFileName": "1201220070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
      "Id": 120122010,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "会员No.0001",
      "FontSize": 2,
      "Phrase": "“照例，因为满腔感想溢了出来，超过了字数限制，/n　所以会分五次发送。这是第一部分。”",
      "VoiceFileName": "1201220080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 500,
          "BodyMotionMasterId": 13,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
      "Id": 120122011,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "明明已经把上限提高到两万字了还要发五次？/n这我就有点理解不了了哦？",
      "VoiceFileName": "1201220090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 120122012,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "会员No.0001",
      "FontSize": 2,
      "Phrase": "“我知道写得太长可能会把您吓到。/n　但首先，有些话我无论如何都想亲口告诉您。”",
      "VoiceFileName": "1201220100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
      "Id": 120122013,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "会员No.0001",
      "FontSize": 2,
      "Phrase": "“就算全世界都在批评您，/n　我也绝对不会停止做您的粉丝。”",
      "VoiceFileName": "1201220110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
      "Id": 120122014,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "会员No.0001",
      "FontSize": 2,
      "Phrase": "“对了，我有自信绝不会输给那些黑粉。/n　因为比起他们一两句诋毁，我的感情要沉重得多。”",
      "VoiceFileName": "1201220120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
      "Id": 120122015,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "啊哈哈，这倒还真是。",
      "VoiceFileName": "1201220130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
