      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "会员No.0001",
      "FontSize": 2,
      "Phrase": "“我会一直期待您闪耀的身姿。”",
      "VoiceFileName": "1201220150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
