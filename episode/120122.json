      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "……谢谢你，零一先生。/n多亏你，我觉得保持现在的自己就好了。",
      "VoiceFileName": "1201220160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
