    {
      "Id": 120122005,
      "EpisodeMasterId": 120122,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "唉……为什么我偏偏要主动搜自己的名字，/n给自己找罪受啊……。",
      "VoiceFileName": "1201220040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
