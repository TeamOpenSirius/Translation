      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007002,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "请多关照。/n呵呵，这么有精神地打招呼，听着我都来劲了。",
      "VoiceFileName": "20030070020",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007003,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "真的？　谢啦！",
      "VoiceFileName": "20030070030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007004,
      "EpisodeMasterId": 2003007,
      "Order": 2,
      "GroupOrder": 3,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "杂志采访什么的太紧张了，我就想着先出点声热热身！",
      "VoiceFileName": "20030070031",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007005,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "哈哈，很不错的缓解紧张方法呢。/n登台或者直播的时候也会紧张吗？",
      "VoiceFileName": "20030070040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007006,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "上台的时候会超级紧张！/n不过只要正式开始就会觉得很好玩，在开始之前脑子里总会想一堆东西。",
      "VoiceFileName": "20030070050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007007,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "直播完全不会！　可能就像跟朋友聊天一样，直接和来看我的大家说话。/n咱们不都是出生在同一个地球上的好兄弟嘛？　差不多这种感觉。",
      "VoiceFileName": "20030070060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007008,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "确实，阿岐留小姐这种贴近大家的距离感和亲切感，/n我觉得也是您能成为如今受欢迎的网红的重要原因。",
      "VoiceFileName": "20030070070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007009,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "说什么人气网红也太抬举我了！/n不过还是谢谢您。",
      "VoiceFileName": "20030070080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 12,
          "LipSyncMasterId": 1,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007010,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "哪里。也非常感谢您爽快答应拍摄和采访。/n那么再次正式说一声，今天请多关照。",
      "VoiceFileName": "20030070090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007011,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "好！　请多关照！",
      "VoiceFileName": "20030070100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007012,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "从直播来看，感觉您经常分享时尚、彩妆和流行事物，/n不过今天的私服也非常可爱呢。",
      "VoiceFileName": "20030070110",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007013,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "今天这身吗？　不过和直播时差不多，/n我本来还在想，是不是穿得更有造型感一点比较好……。",
      "VoiceFileName": "20030070120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007014,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "不会不会，很好看。/n您平时是怎么决定搭配的呢？",
      "VoiceFileName": "20030070130",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007015,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "嗯——，比如『前阵子刚买的这件配饰！』，或者/n『今天绝对想穿这条裙子！』，我会先定一个主角单品，再围着它搭。",
      "VoiceFileName": "20030070140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 1,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007016,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "难得穿一次，当然得穿能让自己心情起飞的才行！/n我还会存几套『这个组合也太绝了吧』的固定搭配。",
      "VoiceFileName": "20030070150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 202,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007017,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "今天就是搭我很喜欢、经常穿的这件上衣来的。/n和拍摄时完全是两个风格就是了。",
      "VoiceFileName": "20030070160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007018,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "很明亮，很棒的搭配。此次拍摄请您穿了ENCHANTÉEK，/n感觉怎么样？",
      "VoiceFileName": "20030070170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007019,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "听工作人员说，您拍摄时也非常从容大方，/n完全不像第一次做模特……。",
      "VoiceFileName": "20030070180",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007020,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "真的吗！？　太好了～。/n一开始收到联系的时候，我还超慌地想『是不是发错人了！？』。",
      "VoiceFileName": "20030070190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007021,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "不管看几遍，上面都写着『阿岐留卡米拉小姐』，/n……真的，就像做梦一样。",
      "VoiceFileName": "20030070200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007022,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "说真的，我之前一直担心会不会不适合我。/n直播时是说过『以后想穿穿看』，但也没想到会马上实现。",
      "VoiceFileName": "20030070210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007023,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "我平时你们也看得到，风格大多都挺花哨的嘛。",
      "VoiceFileName": "20030070220",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007024,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "像ENCHANTÉEK那样又酷又帅……/n比较成熟的路线，我还担心自己是不是根本驾驭不了。",
      "VoiceFileName": "20030070230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007025,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "不过能听到大家这么说，我就放心了。",
      "VoiceFileName": "20030070240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 202,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007026,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "我看过照片了，真的很适合您。",
      "VoiceFileName": "20030070250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007027,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "嘿嘿，谢谢！/n我自己看到拍出来的照片时也吓了一跳。",
      "VoiceFileName": "20030070260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 1,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007028,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "虽然自己这么说有点那什么，/n但我当时真的想『咦，我这不是意外地挺能打嘛！』。",
      "BackgroundCharacterImageFileName": "140780_0",
      "VoiceFileName": "20030070270",
      "CharacterMotions": [],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007029,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "原来不只是我自己兴奋过头，/n现在听您这么说，我真的安心多了。",
      "BackgroundCharacterImageFileName": "140780_0",
      "VoiceFileName": "20030070280",
      "CharacterMotions": [],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007030,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "呵呵。嗯，确实非常能打。",
      "BackgroundCharacterImageFileName": "140780_0",
      "VoiceFileName": "20030070290",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007031,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "谢谢。虽然之前会不安也会紧张，/n但当天真的超级开心，能接下这次工作太好了。",
      "BackgroundCharacterImageFileName": "140780_0",
      "VoiceFileName": "20030070300",
      "CharacterMotions": [],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007032,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "如果以后还有机会，也请务必再来。",
      "VoiceFileName": "20030070310",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007033,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "欸！？",
      "VoiceFileName": "20030070320",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 502,
          "BodyMotionMasterId": 5,
          "LipSyncMasterId": 4,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007034,
      "EpisodeMasterId": 2003007,
      "Order": 2,
      "GroupOrder": 32,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "当然！　以后也请多多关照！",
      "VoiceFileName": "20030070321",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 109,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007035,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "那么最后，请对读者说几句话吧。",
      "VoiceFileName": "20030070330",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007036,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "好！　让我对读者说话什么的感觉太抬举了……。/n不过我这次接到邀请以后，确实学到了一件事。",
      "VoiceFileName": "20030070340",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 100,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 40301,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "403"
    },
    {
      "Id": 2003007037,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "杂志撰稿人",
      "FontSize": 2,
      "Phrase": "学到的事？",
      "VoiceFileName": "20030070350",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2003007038,
      "EpisodeMasterId": 2003007,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "卡米拉",
