            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142052013,
            "EpisodeMasterId": 142052,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "同班同学A",
            "FontSize": 2,
            "Phrase": "就是那个吧！推活！！/n仁花子你以前也说过喜欢看星星嘛！",
            "VoiceFileName": "1420520130",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
