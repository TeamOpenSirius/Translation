            "EpisodeMasterId": 142052,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "仁花子",
            "FontSize": 2,
            "Phrase": "嗯！大概就是那种感觉吧？/n我一直都很期待呢。",
