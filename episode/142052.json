            "EpisodeMasterId": 142052,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "同班同学B",
            "FontSize": 2,
            "Phrase": "啊～，简单说就是跟我们去看演唱会前穿偶像T恤一样啊！/n原来如此～！",
            "VoiceFileName": "1420520140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
