    {
      "Id": 2003303003,
      "EpisodeMasterId": 2003303,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "今天早上我去打工，所以暂时分开了，/n可剧团、宿舍、学校，我们全都在一起吧？",
      "VoiceFileName": "20033030030",
      "CharacterMotions": [
