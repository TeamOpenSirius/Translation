      "EpisodeMasterId": 2003303,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "王雪",
      "FontSize": 2,
      "Phrase": "明明不可能有哪天碰不到面，/n她真以为一直这样糊弄我，就能躲过去？",
      "VoiceFileName": "20033030040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
