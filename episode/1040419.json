    {
      "Id": 1040419015,
      "EpisodeMasterId": 1040419,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "可小时候在银河座儿童部时，却又仅仅因为我是千寿家的女儿而受到照顾……/n有时甚至会被选成主演，可周围的人似乎并不服气。",
      "VoiceFileName": "10404190150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1040419016,
      "EpisodeMasterId": 1040419,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "当时演的……就是《绿野仙踪》的桃乐丝。/n可是三年后……同样的剧目再次上演时，我没能成为桃乐丝。",
      "VoiceFileName": "10404190160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1040419017,
      "EpisodeMasterId": 1040419,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "我终于明白，如果没有特殊照顾，我根本当不上桃乐丝……/n于是开始想，如果我也有Sense就好了……。",
      "VoiceFileName": "10404190170",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
