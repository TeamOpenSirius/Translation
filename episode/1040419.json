      "EpisodeMasterId": 1040419,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "可是，我没有“Sense”。",
      "VoiceFileName": "10404190130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
