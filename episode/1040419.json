      "EpisodeMasterId": 1040419,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "我一直在心底某处羡慕拥有Sense的人……所以，/n甚至连美兔亲，我也忍不住羡慕……。",
      "VoiceFileName": "10404190180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1040419019,
      "EpisodeMasterId": 1040419,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "……就像以前说了过分的话伤害姐姐一样，/n继续这样下去，我也许会伤害美兔亲……。",
      "VoiceFileName": "10404190190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
