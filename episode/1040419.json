      "EpisodeMasterId": 1040419,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "即使我自认为已经很努力地演好角色……/n因为没有Sense，千寿家也不怎么期待我。",
      "VoiceFileName": "10404190140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "HeadDirectionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
