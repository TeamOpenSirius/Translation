  "Title": "孤独的Star",
  "EpisodeDetail": [
    {
      "Id": 1030411001,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "这是我认识的一个剧团的故事——/n某个小剧团里，有一位拥有非凡演技的演员。",
      "BackgroundImageFileName": "120",
      "BgmFileName": "204",
      "VoiceFileName": "10304110010",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 52201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411002,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "因为她的才能，周围所有人都期待，/n认为她一定能成为Dai Star。",
      "VoiceFileName": "10304110020",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411003,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "她自己也不断努力，想回应周围人的期待……可在那之前，/n剧团的导演们却开始专门为她打造舞台。",
      "VoiceFileName": "10304110030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411004,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "只让这位Dai Star候选闪耀的舞台，/n让她比任何人看起来都更有魅力的舞台。",
      "VoiceFileName": "10304110040",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411005,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "……他们没有意识到，自己的行为反而会蒙蔽珍贵星光，/n最后让那颗星坠落地面。",
      "VoiceFileName": "10304110050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 401,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411006,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "这是什么意思……？",
      "VoiceFileName": "10304110060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 112,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 30521,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
