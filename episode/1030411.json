          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030411007,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "想把她推成Dai Star的导演们，其方针/n引起了其他团员的反感。",
      "VoiceFileName": "10304110070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411008,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "也许该说这是理所当然，整个剧团的积极性下降，/n最终连舞台质量也跟着降低。",
      "VoiceFileName": "10304110080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 401,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411009,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "最后，就连那个原本被看中才能的她，/n也没能留下成为Dai Star的结果……。",
      "VoiceFileName": "10304110090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411010,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "她再也承受不住周围失望的声音，最后……/n放弃了演员这条路。",
      "VoiceFileName": "10304110100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "522"
    },
    {
      "Id": 1030411011,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "怎么会……那么有才能的人居然放弃了……太难过了……。/n如果继续下去，本来一定还有很多能闪耀的舞台。",
      "VoiceFileName": "10304110110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "305"
    },
    {
      "Id": 1030411012,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "云雀",
      "FontSize": 2,
      "Phrase": "是啊。/n可是……舞台不是靠一个人就能完成的。",
      "VoiceFileName": "10304110120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
