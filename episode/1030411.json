    {
      "Id": 1030411021,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "……基于以上理由，Horoscope Season期间上演的剧目，/n已经决定为《桥弁庆》。",
      "BgmFileName": "203",
      "VoiceFileName": "10304110200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030411022,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "原来如此。/n是想用传统剧目吸引世界演剧联盟的目光。",
      "VoiceFileName": "10304110210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030411023,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "原剧团成员B",
      "FontSize": 2,
      "Phrase": "听说主角弁庆由你出演？/n——千寿历。",
      "VoiceFileName": "10304110220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030411024,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "原剧团成员C",
      "FontSize": 2,
      "Phrase": "这次没问题吧？/n要是又像《麦克白》那次，让其他星夺走光芒可不行。",
      "VoiceFileName": "10304110230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030411025,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "是，我明白。/n我会拿出无愧于率领传统银河座之人的表演。",
      "VoiceFileName": "10304110240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 1,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030411026,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "原剧团成员A",
      "FontSize": 2,
      "Phrase": "那不是理所当然的吗。/n下一场公演真正要求的是什么，你不会不明白吧？",
      "VoiceFileName": "10304110250",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030411027,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "只要展现银河座积累至今的舞台智慧，/n以及正统有来历的演技，诞生新的Dai Star自然不成问题。",
      "VoiceFileName": "10304110260",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1030411028,
      "EpisodeMasterId": 1030411,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "千寿的才能，即使与其他演员相比也出类拔萃。/n世界演剧联盟的人还没愚蠢到会错过它。",
      "VoiceFileName": "10304110270",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "1"
    },
    {
