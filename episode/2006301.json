      "EpisodeMasterId": 2006301,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "因为那是我的过错。",
      "VoiceFileName": "20063010100",
      "CharacterMotions": [],
      "SpeakerIconId": "103"
    },
