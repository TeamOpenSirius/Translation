      "EpisodeMasterId": 1030406,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "銀河座劇団員達",
      "FontSize": 2,
      "Phrase": "是！",
      "VoiceFileName": "10304060280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030406029,
      "EpisodeMasterId": 1030406,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "正式排练开始后，我会再说明。/n……还有，与那国。",
      "VoiceFileName": "10304060290",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
