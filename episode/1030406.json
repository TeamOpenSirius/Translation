      "SpeakerIconId": "305"
    },
    {
      "Id": 1030406031,
      "EpisodeMasterId": 1030406,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "你这次是千寿的对手戏。/n牛若丸的完成度，会直接影响与之相对的弁庆能否闪耀。",
      "VoiceFileName": "10304060310",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030406032,
      "EpisodeMasterId": 1030406,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "认清这一点，之后的排练好好努力。",
      "VoiceFileName": "10304060320",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1030406033,
      "EpisodeMasterId": 1030406,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "绯花里",
      "FontSize": 2,
      "Phrase": "是，我明白！/n我会努力展现出好的表演！",
      "VoiceFileName": "10304060330",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 2,
          "SpineId": 30503,
          "CharacterAppearanceType": 0,
