      "EpisodeMasterId": 1030406,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "演出负责人",
      "FontSize": 2,
      "Phrase": "这是综合考虑各自适性后作出的决定。不接受异议。/n演出方面，也会采取符合这一剧目的高规格形式。",
      "VoiceFileName": "10304060270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
