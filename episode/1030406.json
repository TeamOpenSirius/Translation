      "Order": 1,
      "GroupOrder": 40,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "《辉夜姬》……《竹取物语》确实也是古典文学，/n不过氛围还是有些不同。",
      "VoiceFileName": "10304060400",
