      "EpisodeMasterId": 1040119,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "卡米拉朋友B",
      "FontSize": 2,
      "Phrase": "现在是惊讶的时候吗！　卡米拉的周边卖完了怎么办！/n你看，那个人抱的周边都快算扫货了！",
      "VoiceFileName": "10401190070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
