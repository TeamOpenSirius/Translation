      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "演剧粉丝B",
      "FontSize": 2,
      "Phrase": "银河座的《竹取物语》抢票也全军覆没……。/n本以为我等命数已尽――但今天，我们抢到了！",
      "VoiceFileName": "10401190020",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
