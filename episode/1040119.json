    {
      "Id": 1040119005,
      "EpisodeMasterId": 1040119,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "剧团成员",
      "FontSize": 2,
      "Phrase": "非常抱歉——，今天没有现场票——！/n我们有价格实惠的线上配信，请大家选择配信观看——！",
      "BackgroundImageFileName": "870",
      "VoiceFileName": "10401190040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040119006,
      "EpisodeMasterId": 1040119,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "剧团成员",
      "FontSize": 2,
      "Phrase": "剧照、亚克力钥匙扣、台本等各类周边都马上要售罄啦——！/n今天不会再补货——！　想买的各位请抓紧——！",
      "VoiceFileName": "10401190050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040119007,
      "EpisodeMasterId": 1040119,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "卡米拉朋友A",
      "FontSize": 2,
      "Phrase": "好、好厉害……我还是第一次看舞台剧，/n原来会有这种像演唱会开场前一样的热度吗？　我以前还以为很朴素……。",
      "VoiceFileName": "10401190060",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
