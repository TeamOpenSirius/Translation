    },
    {
      "Id": 2006906006,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "之前，伊吕波不是把自己的过去告诉过我们吗？",
      "VoiceFileName": "20069060060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 40101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
