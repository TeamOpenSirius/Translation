          "LipSyncMasterId": 4,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906007,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "《绿野仙踪》那时候的……。",
      "VoiceFileName": "20069060070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 7,
          "LipSyncMasterId": 4,
          "SpineId": 40101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 2006906008,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "对对。后来不是搞得像互相爆料大会一样嘛。/n不过最后，我还是没讲自己的事。",
      "VoiceFileName": "20069060080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "HeadMotionMasterId": 1,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 1,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906009,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "那种气氛下也不适合说……/n而且对我来说，也不是想在那种场合讲的事。",
      "VoiceFileName": "20069060090",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 4,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906010,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "说到底，我本来就一直没打算告诉任何人～……。",
      "VoiceFileName": "20069060100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 20,
          "LipSyncMasterId": 4,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906011,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "可是这样的我，却单方面知道伊吕波的过去。/n……这不是很不公平嘛。",
      "VoiceFileName": "20069060110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 110,
          "BodyMotionMasterId": 21,
          "LipSyncMasterId": 4,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906012,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "叶羽亲……。",
      "VoiceFileName": "20069060120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 500,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 40101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 40501,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "401"
    },
    {
      "Id": 2006906013,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 13,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1050",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "9",
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006906014,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "那时候，我一边做童星工作，一边又被挖去奥林匹斯登台，/n忙得简直天旋地转。",
      "VoiceFileName": "20069060130",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906015,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "忙到现在根本无法想象。/n别说午睡，连打游戏的时间都没有。",
      "VoiceFileName": "20069060140",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906016,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "不过，如果只是忙倒还好。/n反正做完就结束了，而且我是天才嘛？",
      "VoiceFileName": "20069060150",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906017,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "……可那个世界，没简单到只靠硬撑就能过去。",
      "VoiceFileName": "20069060160",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906018,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "『哎呀～叶羽亲真不错啊。/n　再看看其他童星……唉，到底怎么回事。』",
      "VoiceFileName": "20069060170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906019,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "工作人员",
      "FontSize": 2,
      "Phrase": "『就是说啊……要不干脆让一个人下车算了？/n　那个年纪最大的……已经过气了吧。』",
      "VoiceFileName": "20069060180",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906020,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "『啊～，我也这么觉得。/n　虽然挺可怜的，但她已经不行了。』",
      "VoiceFileName": "20069060190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906021,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "童星A",
      "FontSize": 2,
      "Phrase": "『都是因为你……因为有你在……。/n　还给我！把我的位置还给我！！本来是我的，是我的啊！！！』",
      "VoiceFileName": "20069060200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906022,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "『……这话去跟导演说啊。做决定的是他。/n　你跟我说，也改变不了什么吧。』",
      "VoiceFileName": "20069060210",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906023,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "难看的东西，我不知道看过多少。/n电视圈也是……舞台上也是。",
      "VoiceFileName": "20069060220",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906024,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 24,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "470",
      "BackgroundImageFileFadeType": 1,
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006906025,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "奥林匹斯剧团成员",
      "FontSize": 2,
      "Phrase": "『哎呀，外婆。外婆的耳朵为什么这么大呀？』",
      "VoiceFileName": "20069060230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906026,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "『唉……下一个，本巢。』",
      "VoiceFileName": "20069060240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906027,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "『……是。』",
      "VoiceFileName": "20069060250",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906028,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "『啊……外婆，为什么你的耳朵这么大呀？』",
      "VoiceFileName": "20069060260",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906029,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "『……决定了。下一部《小红帽》就由本巢叶羽来演。/n　因为只有你可以。』",
      "VoiceFileName": "20069060270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906030,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "导演",
      "FontSize": 2,
      "Phrase": "『其他人完全不值一提。你们自己也明白吧？/n　要是还继续这种可笑的演技，不如别当演员了。』",
      "VoiceFileName": "20069060280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906031,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "奥林匹斯剧团成员",
      "FontSize": 2,
      "Phrase": "『……！！这太狡猾了。/n　那种Sense，怎么可能赢得过……作弊，根本就是作弊啊！！！！！』",
      "VoiceFileName": "20069060290",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906032,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "『……哈。借口说完了吗？那我先走了。/n　……就是因为这样，你才不会被选中。』",
      "VoiceFileName": "20069060300",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906033,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "奥林匹斯剧团成员",
      "FontSize": 2,
      "Phrase": "『……！！呜、呜呜、呜呜呜呜……！！！』",
      "VoiceFileName": "20069060310",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006906034,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "回过神来，同龄的孩子已经一个个退出了演员和童星这一行。/n不过，考虑到我的Sense，这也理所当然。",
      "VoiceFileName": "20069060320",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906035,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "做童星要竞争，站上舞台也要竞争。/n被人怨恨是家常便饭，因为我是天才嘛。",
      "VoiceFileName": "20069060330",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906036,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "是我击垮了她们。……我不觉得这是错。/n当然也不是完全毫无感触……但那个世界就是这样。",
      "BackgroundCharacterImageFileName": "142360_0",
      "VoiceFileName": "20069060340",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906037,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "这种事，不能每一次都放在心里纠结。",
      "BackgroundCharacterImageFileName": "142360_0",
      "VoiceFileName": "20069060350",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906038,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "踩着别人走上去的人反而一直闷闷不乐，/n那才是对那些被我击败的孩子失礼。",
      "BackgroundCharacterImageFileName": "142360_0",
      "VoiceFileName": "20069060360",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906039,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 39,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "我没办法当一个普通孩子。因为我有才能。/n所以只能被迫长大。",
      "BackgroundCharacterImageFileName": "142360_0",
      "VoiceFileName": "20069060370",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 2006906040,
      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 40,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "可是……心里的某个地方，我还是会像其他同龄孩子一样，/n想继续做个孩子……我一直这么想。",
      "BackgroundCharacterImageFileName": "142360_0",
      "VoiceFileName": "20069060380",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
