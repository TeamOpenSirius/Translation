      "EpisodeMasterId": 2006906,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "叶羽亲会主动说这些，除了《爱丽丝》那次以外，/n就没怎么听过了，也不用勉强自己……。",
      "VoiceFileName": "20069060050",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 6,
          "LipSyncMasterId": 4,
          "SpineId": 40101,
