      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "住持",
      "FontSize": 2,
      "Phrase": "嗯？啊，抱歉抱歉，是我说法不太好。/n我们又没有限制人数，没关系。",
      "VoiceFileName": "20065070070",
      "CharacterMotions": [],
