      "EpisodeMasterId": 2006507,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "住持",
      "FontSize": 2,
      "Phrase": "那当然。捣年糕是有诀窍的。/n得让有经验的人先示范，不然新手可要犯难。",
      "VoiceFileName": "20065070230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
