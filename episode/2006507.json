      "EpisodeMasterId": 2006507,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "住持",
      "FontSize": 2,
      "Phrase": "本来也不算寺院正式活动。只是捣给檀家信众的年糕时，/n顺便也分给熟人而已，就是这么随意的聚会。",
      "VoiceFileName": "20065070080",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
