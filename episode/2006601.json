  "Chapter": "辉线，绮罗星的证明",
  "Title": "今后的去向",
  "EpisodeDetail": [
    {
      "Id": 2006601001,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "啊，拉莫娜前辈！",
      "BackgroundImageFileName": "670",
      "BgmFileName": "203",
      "VoiceFileName": "20066010010",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601002,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "哦，莫娜。难道刚结束自主练习？/n真努力啊～。",
      "VoiceFileName": "20066010020",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601003,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "嗯。你们也是吗？",
      "VoiceFileName": "20066010030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601004,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "对对！虽然现在也开始能拿到角色了，/n但下次可不一定还能拿到嘛～。",
      "VoiceFileName": "20066010040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601005,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "是啊……工作坊停办以后，/n很多时候都只能自己摸索着尝试演技。",
      "VoiceFileName": "20066010050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601006,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "这样啊……时刻想着提升自己，这种态度很了不起！/n你们的努力一定会开花结果！",
      "VoiceFileName": "20066010060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "BodyMotionMasterId": 8,
          "LipSyncMasterId": 2,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601007,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "莫娜还是老样子啊～。/n不过，现在能和这样的莫娜说话，我反而放心了？",
      "VoiceFileName": "20066010070",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601008,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "是啊……工作坊什么时候恢复还没有眉目。/n明明导演老师说的只是“别再做第二次”而已……！",
      "VoiceFileName": "20066010080",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601009,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "他们该不会打算就这样让它自然消失吧……！/n果然我还是去直接交涉——。",
      "VoiceFileName": "20066010090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601010,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "先等等。/n别轻举妄动。",
      "VoiceFileName": "20066010100",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 79,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601011,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "可是，拉莫娜前辈！！",
      "VoiceFileName": "20066010110",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601012,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "等等，克莱尔。你也替莫娜想想。",
      "VoiceFileName": "20066010120",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601013,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "参加工作坊的人里已经有人被解雇了。/n现在我们两个还能留在这里，都跟奇迹差不多了吧？",
      "VoiceFileName": "20066010130",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601014,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "……对不起。",
      "VoiceFileName": "20066010140",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601015,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "没事，别在意。阿比盖尔说得对，/n这个话题如今在银河座里非常敏感。",
      "VoiceFileName": "20066010150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 4,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601016,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "我不希望你们最后落到退出银河座的地步。/n现在是忍耐的时候，总有一天会重新得到许可。",
      "VoiceFileName": "20066010160",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601017,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "拉莫娜前辈……。",
      "VoiceFileName": "20066010170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601018,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "别露出那种表情，克莱尔。/n和《桥弁庆》时一样，现在我能做的，就是听听剧团大家的烦恼！",
      "VoiceFileName": "20066010180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 101,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 2,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601019,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "只要把该做的事一件件做好，总会有路被打开的！",
      "VoiceFileName": "20066010190",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 202,
          "BodyMotionMasterId": 17,
          "LipSyncMasterId": 2,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601020,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "反倒不是挺好吗？那个什么工作坊办不下去。",
      "BgmFileName": "999",
      "VoiceFileName": "20066010200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601021,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "你……你在说什么！！",
      "BgmFileName": "7",
      "VoiceFileName": "20066010210",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601022,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "你是……刚排练结束吗？/n辛苦了。",
      "VoiceFileName": "20066010230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 102,
          "BodyMotionMasterId": 11,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601023,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "谢谢。所以刚才说到哪……来着？克莱尔。/n就是字面意思，我想说“反而帮了你们一个忙吧”。",
      "VoiceFileName": "20066010240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601024,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "说得可真难听。记得《桥弁庆》的时候，/n你在背后说莫娜坏话，后来被她制止了吧？",
      "VoiceFileName": "20066010250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601025,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "现在是想报复？？",
      "VoiceFileName": "20066010260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601026,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "那件事和现在无关。反倒是当时确实是我有错。/n所以我现在才这样当面说。",
      "VoiceFileName": "20066010270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601027,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "我想说的是，沃尔芙小姐。/n你明明有足以在银河座担纲主要角色的演技实力……。",
      "VoiceFileName": "20066010280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601028,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "能演出那么出色表演的演员，竟然只因为在剧团里的行事方式，/n就让自己的处境变得危险，实在太可惜了！",
      "VoiceFileName": "20066010290",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601029,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "处境……变得危险……。",
      "VoiceFileName": "20066010300",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601030,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "你也许没有察觉，自从千寿历成为Dai Star后，/n整个剧团对“你是否还该继续留在这里”的看法正在逐渐转向质疑。",
      "VoiceFileName": "20066010310",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601031,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "……。",
      "VoiceFileName": "20066010320",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 13,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601032,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 32,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "沃尔芙小姐，你……是不是该重新审视一下自己的做法？",
      "VoiceFileName": "20066010330",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601033,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 33,
      "SpeakerName": "克莱尔",
      "FontSize": 2,
      "Phrase": "这、这根本是多管闲事！！/n拉莫娜前辈有拉莫娜前辈自己的做法！！",
      "VoiceFileName": "20066010340",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601034,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 34,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "不……没关系，克莱尔。",
      "VoiceFileName": "20066010350",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 105,
          "BodyMotionMasterId": 15,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601035,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 35,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "谢谢你的忠告。/n我确实也需要认真想想剧团内部发生的各种变化。",
      "VoiceFileName": "20066010360",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601036,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 36,
      "SpeakerName": "阿比盖尔",
      "FontSize": 2,
      "Phrase": "莫娜……。",
      "VoiceFileName": "20066010370",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006601037,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "我会自己好好想想。",
      "VoiceFileName": "20066010380",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "BodyMotionMasterId": 3,
          "LipSyncMasterId": 1,
          "SpineId": 30203,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006601038,
      "EpisodeMasterId": 2006601,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "银河座剧团成员A",
      "FontSize": 2,
      "Phrase": "是吗，那就好。那我先走了。",
