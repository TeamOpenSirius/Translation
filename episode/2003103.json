      "EpisodeMasterId": 2003103,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "讲师",
      "FontSize": 2,
      "Phrase": "可以回去了。/n那么下一位，流石知冴小姐，请上台。",
      "VoiceFileName": "20031030260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
