      "EpisodeMasterId": 2003103,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "卡特莉娜",
      "FontSize": 2,
      "Phrase": "雨虽然冰冷，但有时候也会让人觉得，仿佛它正陪着自己一起哭。/n我想……人也会有这样的心情。",
      "VoiceFileName": "20031030240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 79,
          "BodyMotionMasterId": 4,
          "LipSyncMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "103"
    },
