      ],
      "SpeakerIconId": "104"
    },
    {
      "Id": 2000304025,
      "EpisodeMasterId": 2000304,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "让一家人骨肉分离也太过分了！　你还有没有人性！？",
