    {
      "Id": 2000304021,
      "EpisodeMasterId": 2000304,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "八惠的母亲",
      "FontSize": 2,
      "Phrase": "去野餐时也会把它们带上……。/n呵呵，我记得你还藏在篮子里。",
      "VoiceFileName": "20003040200",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
