      "EpisodeMasterId": 2000304,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "（啊！　现在不正是测试刚才从书里学到的成果/n的大好机会吗……！？）",
