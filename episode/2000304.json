      "EpisodeMasterId": 2000304,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "八惠的母亲",
      "FontSize": 2,
      "Phrase": "呵呵。你以前经常扮餐厅老板呢。/n从小就很喜欢角色扮演游戏。",
      "VoiceFileName": "20003040170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2000304019,
      "EpisodeMasterId": 2000304,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "八惠",
      "FontSize": 2,
      "Phrase": "是吗？　我都不太记得了……。",
      "VoiceFileName": "20003040180",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 201,
          "BodyMotionMasterId": 6,
          "LipSyncMasterId": 1,
