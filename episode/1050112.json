        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 1050112038,
      "EpisodeMasterId": 1050112,
      "Order": 1,
      "GroupOrder": 38,
      "SpeakerName": "暦",
      "FontSize": 2,
      "Phrase": "（率领众人的新银河之星……真是让人安心。/n　今后的你，究竟还会向我们展现怎样的未来——）",
      "VoiceFileName": "10501120340",
