    },
    {
      "Id": 1050112037,
      "EpisodeMasterId": 1050112,
      "Order": 1,
      "GroupOrder": 37,
      "SpeakerName": "暦",
      "FontSize": 2,
      "Phrase": "（不固守传统，却也从未轻视传统，而是建立了全新的表现方式。/n　你证明了除我之外，银河座也已经出现了闪耀着不同光芒的星。）",
      "VoiceFileName": "10501120330",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 71,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
