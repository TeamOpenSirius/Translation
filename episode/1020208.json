        {
            "Id": 1020208020,
            "EpisodeMasterId": 1020208,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "主人公信乐日和，是一名高二女生。/n此刻的她，正被孤独折磨。",
            "VoiceFileName": "10202080200",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 21,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020208021,
            "EpisodeMasterId": 1020208,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "她与唯一的家人——母亲互相无法理解，/n也因为升学而与独一无二的挚友渐渐疏远。",
            "VoiceFileName": "10202080210",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020208022,
            "EpisodeMasterId": 1020208,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "无论家里还是学校都没有容身之处，也没有可以敞开心扉的人。/n于是日和开始常常去附近的山里消磨时间。",
            "VoiceFileName": "10202080220",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020208023,
            "EpisodeMasterId": 1020208,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "某一天……孤独的日和，遇见了孤独的恶魔。",
            "VoiceFileName": "10202080230",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 102,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020208024,
            "EpisodeMasterId": 1020208,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "它名叫阿斯莫德。因战火失去一切，/n孤身逃到人间的恶魔。",
            "VoiceFileName": "10202080240",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "BodyMotionMasterId": 21,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020208025,
            "EpisodeMasterId": 1020208,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "一个是人，一个是恶魔，但境遇相似的两人彼此吸引，/n培养出了跨越种族的友情。",
            "VoiceFileName": "10202080250",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 70,
                    "BodyMotionMasterId": 4,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1020208026,
            "EpisodeMasterId": 1020208,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "可她们并不知道，/n驱魔人的阴影正在向享受平静时光的两人逼近——",
            "VoiceFileName": "10202080260",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 110,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
