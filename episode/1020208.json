            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "先简单说明一下剧情。",
            "VoiceFileName": "10202080190",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 70,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
