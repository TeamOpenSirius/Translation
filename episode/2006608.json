      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 76,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "（可如今又怎样？火锅、工作坊……/n　甚至那场会议里，连千寿历都替我说话了）",
      "VoiceFileName": "20066080740",
      "CharacterMotions": [
