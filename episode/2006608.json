      "SpeakerIconId": "302"
    },
    {
      "Id": 2006608072,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 72,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "当然，我并不是要求你现在就给出明确答复。/n你也有自己的情况。……只是希望你认真考虑。",
      "VoiceFileName": "20066080700",
      "CharacterMotions": [],
