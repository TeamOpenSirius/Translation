      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 73,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "（新的剧团，而且让我当团长……。/n　不行，信息太多，脑子完全跟不上）",
      "VoiceFileName": "20066080710",
      "CharacterMotions": [
