          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608053,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 53,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（而拉莫娜……您终于，/n　成为了这片银河产生决定性变化的扳机）",
      "VoiceFileName": "20066080520",
      "CharacterMotions": [
