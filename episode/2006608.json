      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006608068,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 68,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "没错。它的名字叫……“星云”。",
      "BgmFileName": "999",
      "VoiceFileName": "20066080660",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608069,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 69,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "星云……！？",
      "BgmFileName": "205",
      "VoiceFileName": "20066080670",
      "CharacterMotions": [
