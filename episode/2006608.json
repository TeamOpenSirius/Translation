      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608049,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 49,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "这次拉莫娜·沃尔芙的事情由我接手。/n你们也可以退下了。",
      "VoiceFileName": "20066080480",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608050,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 50,
      "SpeakerName": "拉莫娜＆千寿历",
      "FontSize": 2,
      "Phrase": "知、知道了。/n谨、谨遵吩咐。",
      "VoiceFileName": "20066080490",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608051,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 51,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（银河座的一位高层，居然替拉莫娜说话。/n　……这种事，通常根本无法想象）",
      "VoiceFileName": "20066080500",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "HeadMotionMasterId": 2,
          "BodyMotionMasterId": 13,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608052,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 52,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（是拉莫娜的演技吸引了老师吗……/n　仔细想来，自从她加入后，这个剧团确实发生了剧烈变化）",
      "VoiceFileName": "20066080510",
      "CharacterMotions": [
