  "EpisodeDetail": [
    {
      "Id": 2006608001,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 1,
      "SpeakerName": "银河座上层A",
      "FontSize": 2,
      "Phrase": "拉莫娜·沃尔芙。今天为什么被叫来，你心里清楚吧？/n不安定因素没有位置，这一点我们事先已经警告过。",
      "BackgroundImageFileName": "1840",
      "BgmFileName": "7",
