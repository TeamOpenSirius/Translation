      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 75,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "（最初，剧团里很少有人理解我说的话。/n　甚至连千寿历都警告过我，要遵从剧团方针）",
      "VoiceFileName": "20066080730",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
