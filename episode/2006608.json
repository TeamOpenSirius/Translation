          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608055,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 55,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1460",
      "BackgroundImageFileFadeType": 1,
      "BgmFileName": "23",
      "CharacterMotions": [],
      "FadeValue1": 0.20000000298023224,
      "FadeValue2": 0.30000001192092896,
      "FadeValue3": 0.20000000298023224
    },
    {
      "Id": 2006608056,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 56,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "那之后没隔多久又把你叫来，抱歉。/n没有给你造成什么不便吧？",
      "VoiceFileName": "20066080540",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608057,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 57,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "没有，倒也没什么……。/n那个，之前的会议……谢谢您。",
      "VoiceFileName": "20066080550",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
