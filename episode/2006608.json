      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 74,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "（可是……这种事，一开始根本无法想象）",
      "VoiceFileName": "20066080720",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 103,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
