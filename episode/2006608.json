    },
    {
      "Id": 2006608004,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 4,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "……。",
      "VoiceFileName": "20066080040",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608005,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "银河座上层B",
      "FontSize": 2,
      "Phrase": "你还真敢做啊。尽管已经警告，你依然没有改变自己的做法。/n这就是你表明的意志吗？沃尔芙。",
      "VoiceFileName": "20066080050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608006,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 6,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "……嗯。我无法改变自己的处世方式。/n我做不到为了保全自己，就把那些正在困扰的人弃之不顾。",
      "VoiceFileName": "20066080060",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006608007,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 7,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "真那么做，我甚至会失去银河座曾经认可的那个演员，/n“拉莫娜·沃尔芙”本应有的样子。",
      "VoiceFileName": "20066080070",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 104,
          "LipSyncMasterId": 4,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006608008,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 8,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "为了让剧团进一步跃进，演员之间有必要彼此携手。/n……这就是我的意志。",
      "VoiceFileName": "20066080080",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006608009,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 9,
      "SpeakerName": "前剧团成员A",
      "FontSize": 2,
      "Phrase": "什么意志。连身为银河一员应守的秩序都不懂，/n到处播撒不和的不安定因素，口气倒是不小。",
      "VoiceFileName": "20066080090",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608010,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 10,
      "SpeakerName": "前剧团成员B",
      "FontSize": 2,
      "Phrase": "正所谓“不知廉耻”吧？/n一副仿佛自己已经是成熟演员的口吻，真让人忍俊不禁。",
      "VoiceFileName": "20066080100",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608011,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 11,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……！可是，拉莫娜在这次公演以及《圣克卢指南》等方面，/n确实是一位已经积累了实绩的演员。",
      "VoiceFileName": "20066080110",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 107,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608012,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 12,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "而这次的事情也确实有我监督不到位的责任。/n今后我会彻底指导，避免类似事态再次发生。",
      "VoiceFileName": "20066080120",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 14,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608013,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "所以恕我直言，现在就决定让她退出银河座，/n是不是还为时过早……。",
      "VoiceFileName": "20066080130",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 104,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608014,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "千寿历……！？",
      "VoiceFileName": "20066080140",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "FacialExpressionMasterId": 500,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006608015,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（我早已有所觉悟……我也会在自己能力所及的范围内，/n　陪您走下去，拉莫娜……！）",
      "VoiceFileName": "20066080150",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 74,
          "BodyMotionMasterId": 4,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 2,
          "CharacterLayerType": 1,
          "SpineSize": 2
        },
        {
          "slotNumber": 2,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 4,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608016,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "前剧团成员B",
      "FontSize": 2,
      "Phrase": "是吗？老实说，我觉得早就已经超过那个阶段了。/n千寿历小姐？",
      "VoiceFileName": "20066080160",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608017,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "前剧团成员C",
      "FontSize": 2,
      "Phrase": "我们一路建立起来的传统，难道已经轻到足以接纳不安定因素了吗？/n这一点最应该明白的人，不正是你吗？",
      "VoiceFileName": "20066080170",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608018,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "前剧团成员A",
      "FontSize": 2,
      "Phrase": "即使从实绩来看确实如此，但她扰乱了剧团秩序，/n招来了不必要的混乱。光这一点就已经有罪。",
      "VoiceFileName": "20066080180",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608019,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "前剧团成员A",
      "FontSize": 2,
      "Phrase": "你总不会被她笼络了吧？作为千寿家的人，/n你应该知道自己在这件事上也该站在共同声讨她的一边。",
      "VoiceFileName": "20066080190",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608020,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "……是。",
      "VoiceFileName": "20066080200",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "BodyMotionMasterId": 13,
          "LipSyncMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608021,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（……果然，以我的立场，/n　想替拉莫娜挡下这些火星，也有极限）",
      "VoiceFileName": "20066080210",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608022,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 22,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（不只是银河座，还有作为千寿家的演员代代建立起来的一切）",
      "VoiceFileName": "20066080230",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "BodyMotionMasterId": 4,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608023,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 23,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（想到自己背负的东西，我不能在这里被质疑是否具备资格。/n　……我保护不了您，也做不到像您那样）",
      "VoiceFileName": "20066080240",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 73,
          "SpineId": 30101,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608024,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 24,
      "FontSize": 2,
      "Phrase": "",
      "BackgroundImageFileName": "1050",
      "BackgroundImageFileFadeType": 2,
      "SeFileName": "641",
      "WindowEffect": 1,
