      ],
      "SpeakerIconId": "302"
    },
    {
      "Id": 2006608070,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 70,
      "SpeakerName": "银河座高层",
      "FontSize": 2,
      "Phrase": "距离正式成立还有些时间……但我想把团长的位置交给你。/n当然，我的名字你尽管拿去用。我会作为后盾支持你。",
      "VoiceFileName": "20066080680",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 2006608071,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 71,
      "SpeakerName": "拉莫娜",
      "FontSize": 2,
      "Phrase": "让我……当团长。/n可是……。",
      "VoiceFileName": "20066080690",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
          "BodyMotionMasterId": 25,
          "LipSyncMasterId": 4,
          "SpineId": 30201,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
