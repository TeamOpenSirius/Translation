      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "（拉莫娜……）",
      "VoiceFileName": "20066080030",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 400,
