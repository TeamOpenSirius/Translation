          "slotNumber": 1,
          "BodyMotionMasterId": 13,
          "SpineId": 0,
          "CharacterAppearanceType": 0,
          "CharacterPosition": 3,
          "CharacterLayerType": 1,
          "SpineSize": 2
        }
      ],
      "SpeakerIconId": "301"
    },
    {
      "Id": 2006608054,
      "EpisodeMasterId": 2006608,
      "Order": 1,
      "GroupOrder": 54,
      "SpeakerName": "千寿历",
      "FontSize": 2,
      "Phrase": "银河座会改变。/n无论愿不愿意。",
      "VoiceFileName": "20066080530",
      "CharacterMotions": [
        {
          "slotNumber": 1,
          "FacialExpressionMasterId": 70,
