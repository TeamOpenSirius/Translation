            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020420020,
            "EpisodeMasterId": 1020420,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "合作方经营者",
            "FontSize": 2,
            "Phrase": "这么说来，演员名单里确实有一位姓「笔岛」……/n哈哈，这还真是惊人的巧合。",
            "VoiceFileName": "10204200190",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1020420021,
            "EpisodeMasterId": 1020420,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "合作方经营者",
            "FontSize": 2,
            "Phrase": "不仅能看这场戏，还能看到令爱在舞台上的表现。/n真让人期待啊。",
