      "Order": 1,
      "GroupOrder": 2,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "抱歉，我可以直说吗？　对我来说难度有点太高了。/n你对老鼠的爱演得太深，观众可能不太容易看懂！",
      "VoiceFileName": "10402180020",
      "CharacterMotions": [
        {
          "slotNumber": 1,
