    {
      "Id": 1040218024,
      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 24,
      "SpeakerName": "叶羽粉丝",
      "FontSize": 2,
      "Phrase": "听说叶羽亲主演，那肯定拼死也得参加抢票大战啊！/n平时积德果然有用～！　话说你出差累不累？",
      "SeFileName": "1431",
      "VoiceFileName": "10402180220",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040218025,
      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "蕾粉丝",
      "FontSize": 2,
      "Phrase": "为了第一次沐浴蕾大人的姐姐属性，闪电出差算什么！/n而且还是和叶羽爱丽丝演姐妹，我的情绪已经坏掉，可能直接不行了！",
      "VoiceFileName": "10402180230",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040218026,
      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "蕾粉丝",
      "FontSize": 2,
      "Phrase": "……等、等等那边！/n那个该不会是地步亲吧……！？",
      "VoiceFileName": "10402180240",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040218027,
      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "叶羽粉丝",
      "FontSize": 2,
      "Phrase": "诶，谁？",
      "VoiceFileName": "10402180250",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040218028,
      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "蕾粉丝",
      "FontSize": 2,
      "Phrase": "狛江地步啊！　不是叶羽亲的对手吗！",
      "VoiceFileName": "10402180260",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040218029,
      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "叶羽粉丝",
      "FontSize": 2,
      "Phrase": "诶……真不认识。",
      "VoiceFileName": "10402180270",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
      "Id": 1040218030,
      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "蕾粉丝",
      "FontSize": 2,
      "Phrase": "所以说你这种眼里除了叶羽亲什么都看不见的家伙啊～！",
      "VoiceFileName": "10402180280",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
    },
    {
