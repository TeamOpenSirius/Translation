      "EpisodeMasterId": 1040218,
      "Order": 1,
      "GroupOrder": 3,
      "SpeakerName": "见习团员",
      "FontSize": 2,
      "Phrase": "果然吗――！/n可要是演得太好懂，又觉得不太对吧？",
