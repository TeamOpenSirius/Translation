      "Order": 1,
      "GroupOrder": 5,
      "SpeakerName": "電姫団員A",
      "FontSize": 2,
      "Phrase": "难得这个改编已经得到要姐同意。/n还是想再做得好一点啊。",
      "VoiceFileName": "10402180050",
      "CharacterMotions": [],
      "SpeakerIconId": "1"
