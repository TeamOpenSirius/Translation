    {
      "Id": 1040422025,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 25,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "“多亏你们打倒了女巫……。/n　那么，按照约定……给稻草人脑袋。”",
      "VoiceFileName": "10404220220",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1040422026,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 26,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "“太好了——！/n　……哦哦！感觉好多绝妙点子不断冒出来！”",
      "VoiceFileName": "10404220230",
      "CharacterMotions": [],
      "SpeakerIconId": "403"
    },
    {
      "Id": 1040422027,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 27,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "“给铁皮人一颗丝绸做的心。”",
      "VoiceFileName": "10404220240",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1040422028,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 28,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "“不知怎么，心情变得好安宁……！/n　让我想起了自己还是人类时的日子。”",
      "VoiceFileName": "10404220250",
      "CharacterMotions": [],
      "SpeakerIconId": "404"
    },
    {
      "Id": 1040422029,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 29,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "“给狮子……喝下能带来勇气的药。”",
      "VoiceFileName": "10404220260",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
    {
      "Id": 1040422030,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 30,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "“为什么呢！害怕的感觉消失了……！/n　现在好像什么都做得到！”",
      "VoiceFileName": "10404220270",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040422031,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 31,
      "SpeakerName": "伊吕波",
      "FontSize": 2,
      "Phrase": "“是吗是吗，那真是太好了。”",
      "VoiceFileName": "10404220280",
      "CharacterMotions": [],
      "SpeakerIconId": "401"
    },
