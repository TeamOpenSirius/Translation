    {
      "Id": 1040422013,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 13,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "“我的名字叫桃乐丝。我想去翡翠城见伟大的奥兹大人，/n　请他把我送回堪萨斯。”",
      "VoiceFileName": "10404220120",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1040422014,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 14,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "“奥兹是谁啊？”",
      "VoiceFileName": "10404220130",
      "CharacterMotions": [],
      "SpeakerIconId": "403"
    },
    {
      "Id": 1040422015,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 15,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "“你不知道吗？”",
      "VoiceFileName": "10404220140",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1040422016,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 16,
      "SpeakerName": "卡米拉",
      "FontSize": 2,
      "Phrase": "“因为俺没有脑袋嘛。/n　……如果拜托奥兹，他会给俺一个脑袋吗？”",
      "VoiceFileName": "10404220150",
      "CharacterMotions": [],
      "SpeakerIconId": "403"
    },
    {
      "Id": 1040422017,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 17,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "“一定会的！”",
      "VoiceFileName": "10404220160",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1040422018,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 18,
      "SpeakerName": "蕾",
      "FontSize": 2,
      "Phrase": "“我没有心，因为身体是铁皮做的。/n　……如果拜托奥兹，他会给我一颗心吗？”",
      "VoiceFileName": "10404220170",
      "CharacterMotions": [],
      "SpeakerIconId": "404"
    },
    {
      "Id": 1040422019,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 19,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "“奥兹一定会实现你的愿望！”",
      "VoiceFileName": "10404220180",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
      "Id": 1040422020,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 20,
      "SpeakerName": "叶羽",
      "FontSize": 2,
      "Phrase": "“我是狮子，却没有勇气。/n　如果能从奥兹那里得到就好了……”",
      "VoiceFileName": "10404220190",
      "CharacterMotions": [],
      "SpeakerIconId": "405"
    },
    {
      "Id": 1040422021,
      "EpisodeMasterId": 1040422,
      "Order": 1,
      "GroupOrder": 21,
      "SpeakerName": "美兔",
      "FontSize": 2,
      "Phrase": "“没问题！”",
      "VoiceFileName": "10404220200",
      "CharacterMotions": [],
      "SpeakerIconId": "402"
    },
    {
